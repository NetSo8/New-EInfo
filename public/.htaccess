# einformatique.fr — hébergement Apache (OVH)
#
# Canonicalise tout vers https://einformatique.fr : une seule version du
# site indexable. Sans ce fichier, http:// et www. servent le même contenu
# que le domaine principal (contenu dupliqué, aucun avertissement de
# sécurité navigateur, dilution du signal SEO).

RewriteEngine On

# HTTPS obligatoire + domaine sans www, en une seule redirection (301)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://einformatique.fr%{REQUEST_URI} [L,R=301]

# Ancienne adresse : vraie redirection permanente (301) côté serveur, lue
# directement par Google, plutôt que la page de redirection HTML générée
# par Astro, qui ne sert plus que de filet de sécurité.
RewriteRule ^about/?$ https://einformatique.fr/a-propos/ [L,R=301]

# Indique aux navigateurs de toujours revenir en HTTPS sur ce domaine,
# même sur un lien tapé en http:// (protection contre le détournement de
# la première requête).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Sans cette ligne, Apache sert sa propre page d'erreur brute au lieu de la
# page 404 du site (avec navigation et mise en forme).
ErrorDocument 404 /404.html

# ── Cache navigateur ──────────────────────────────────────────
# Par défaut, OVH ne garde les fichiers que 15 minutes, et les polices pas
# du tout : chaque visite suivante retéléchargeait ~150 Ko pour rien.
# · /_astro/ : noms de fichiers versionnés (empreinte dans le nom), donc
#   jamais modifiés en place → un an, sans revalidation.
# · polices et icônes : changent très rarement → un an / un mois.
# · pages HTML : toujours revalidées, sinon une mise à jour du site ne
#   serait vue qu'après expiration du cache.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(ico|svg|png)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # ── En-têtes de sécurité de base ────────────────────────────
  # Le navigateur ne devine pas le type d'un fichier à partir de son contenu.
  Header always set X-Content-Type-Options "nosniff"
  # Le site ne peut pas être affiché dans un cadre sur un autre domaine.
  Header always set X-Frame-Options "SAMEORIGIN"
  # Un lien sortant ne transmet que le domaine, pas l'adresse complète.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Le site n'utilise ni caméra, ni micro, ni géolocalisation : on les coupe.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
