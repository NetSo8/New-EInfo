# einformatique.fr — hébergement Apache (OVH)
#
# Canonicalise tout vers https://einformatique.fr : une seule version du
# site indexable. Sans ce fichier, http:// et www. servent le même contenu
# que le domaine principal (contenu dupliqué, aucun avertissement de
# sécurité navigateur, dilution du signal SEO).

RewriteEngine On

# HTTPS obligatoire + domaine sans www, en une seule redirection (301)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://einformatique.fr%{REQUEST_URI} [L,R=301]

# Indique aux navigateurs de toujours revenir en HTTPS sur ce domaine,
# même sur un lien tapé en http:// (protection contre le détournement de
# la première requête).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ─────────────────────────────────────────────────────────────
# MODE MAINTENANCE — bloc temporaire.
#
# Toute requête reçoit un statut 503 (indisponible temporairement,
# pas une erreur permanente pour les moteurs de recherche) et Apache
# sert le contenu de /maintenance/ à la place, sans changer l'URL
# affichée au visiteur. Les ressources nécessaires à cette page
# restent accessibles.
#
# Pour remettre le site en ligne : supprimer ce bloc entier
# (jusqu'à « FIN MODE MAINTENANCE ») puis redéployer.
# ─────────────────────────────────────────────────────────────
ErrorDocument 503 /maintenance/

RewriteCond %{REQUEST_URI} !^/maintenance/ [NC]
RewriteCond %{REQUEST_URI} !^/(_astro|fonts)/ [NC]
RewriteCond %{REQUEST_URI} !^/(logo\.png|favicon\.ico|favicon\.svg)$ [NC]
RewriteRule ^ - [R=503,L]
# ─────────────────────────────────────────────────── FIN MODE MAINTENANCE ──
