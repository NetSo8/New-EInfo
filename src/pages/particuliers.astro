---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import X from '@lucide/astro/icons/x';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { Image } from 'astro:assets';
import etabli from '../assets/etabli.jpg';


const pannes = [
  { t: 'Il met cinq minutes à démarrer', d: "Neuf fois sur dix, c'est le disque dur d'origine. Un disque SSD et la machine repart pour trois ans." },
  { t: 'Écran noir, plus rien ne se passe', d: "Alimentation, écran, carte mère ou simple câble. Le diagnostic dit lequel, et si ça vaut la réparation." },
  { t: 'Des fenêtres s\'ouvrent toutes seules', d: "Nettoyage complet, vérification des comptes, et changement des mots de passe qui ont pu fuiter." },
  { t: 'Ma boîte mail a été piratée', d: "Reprise du compte, coupure des accès en cours, et mise en place de la double authentification." },
  { t: 'Je veux récupérer mes photos', d: "Récupération quand le support le permet. Je vous dis avant si les chances sont bonnes ou faibles." },
  { t: 'Le wifi ne passe pas au fond du couloir', d: "Mesure réelle du signal pièce par pièce, puis la solution la moins chère qui règle le problème." },
  { t: "L'imprimante ne veut plus rien savoir", d: "Pilotes, réseau, ou matériel en fin de vie. Réglé sur place, ou remplacé en connaissance de cause." },
  { t: 'Je change de machine et je perds tout', d: "Transfert complet : documents, photos, messagerie, mots de passe, favoris, logiciels installés." },
];

const etapes = [
  { n: '01', t: 'Vous décrivez', d: "Par écrit ou par téléphone. La machine, le symptôme, depuis quand. Trois lignes suffisent." },
  { n: '02', t: 'Je chiffre', d: "Je vous annonce ce que je vais faire, le temps que ça prend et ce que ça coûte. Avant de commencer." },
  { n: '03', t: "J'interviens", d: "Chez vous, à l'atelier ou à distance selon la panne. Vous choisissez ce qui vous arrange." },
  { n: '04', t: 'Je vous montre', d: "Ce qui s'est passé, ce que j'ai changé, et les deux ou trois réflexes qui évitent que ça recommence." },
];

const chiffrage = [
  { t: 'Le diagnostic est offert', d: "Je regarde, je vous dis ce qui ne va pas, et vous décidez ensuite. Aucun frais de dossier, aucun frais de prise en charge." },
  { t: 'Rien ne commence sans votre accord', d: "Je vous annonce ce que je vais faire et ce que ça coûte avant d'ouvrir quoi que ce soit. Un devis écrit est remis dès que l'intervention dépasse une heure ou demande une pièce." },
  { t: 'Le montant ne bouge plus ensuite', d: "Si je découvre autre chose en cours de route, je m'arrête et je vous appelle. Vous ne découvrez jamais un écart sur la facture." },
  { t: 'Le déplacement est inclus', d: "Jusqu'à 15 km de Rivesaltes, il n'est pas facturé. Au-delà, le forfait kilométrique vous est annoncé avant que je prenne la route." },
  { t: 'Si ça ne vaut pas le coup, vous ne payez pas', d: "Réparation non rentable, machine en fin de vie, ou vous préférez ne pas donner suite après le devis : dans les trois cas, rien ne vous est facturé." },
  { t: 'Récupération de données : au résultat', d: "Chiffrée après examen du support, et rien n'est dû si rien n'est récupéré." },
];

const refus = [
  { t: 'Un abonnement antivirus annuel.', d: "Ce qui est intégré à Windows suffit dans l'immense majorité des cas, à condition d'être correctement réglé." },
  { t: 'Un ordinateur neuf quand une pièce suffit.', d: 'Je chiffre les deux et je vous laisse comparer.' },
  { t: 'Un « nettoyage » qui ne change rien.', d: 'Si la lenteur vient du matériel, aucun logiciel ne la corrigera.' },
  { t: 'Un contrat que vous ne pouvez pas arrêter.', d: "Pour un particulier, on paie l'intervention, et c'est tout." },
];

const faq = [
  { q: 'Vous venez chez moi ou je dois apporter la machine ?', a: "Les deux sont possibles. Pour un ordinateur de bureau ou une panne réseau, je viens chez vous. Pour une réparation matérielle plus longue, il est souvent plus simple et moins cher que la machine passe à l'atelier." },
  { q: 'Est-ce que je paie si vous ne réparez pas ?', a: "Le diagnostic est offert. Si la réparation n'est pas rentable, je vous le dis et vous ne payez rien. Si vous préférez ne pas donner suite après le devis, vous ne payez rien non plus." },
  { q: 'Pourquoi les tarifs ne sont-ils pas affichés ?', a: "Parce qu'une grille de prix affichée est presque toujours fausse pour votre cas précis. Deux ordinateurs qui rament peuvent demander vingt minutes ou une demi-journée. Je préfère regarder, puis vous annoncer un montant ferme, plutôt qu'un tarif d'appel qui gonfle en cours de route." },
  { q: "Vous touchez à mes données personnelles ?", a: "Uniquement ce qui est nécessaire à l'intervention, et jamais sans vous le dire. Aucune copie n'est conservée après restitution. Sur une récupération de données, le support vous est rendu avec l'ensemble de ce qui a été extrait." },
  { q: 'Vous travaillez le week-end ?', a: "En semaine en règle générale. Une panne qui vous empêche complètement de travailler ou une suspicion de piratage passe devant, week-end compris." },
  { q: "Ma machine a douze ans, ça vaut le coup ?", a: "Parfois oui, souvent non. Je regarde le coût des pièces, l'état de la carte mère et la version de Windows encore supportée, et je vous donne une réponse franche, y compris quand elle me fait perdre une réparation." },
];
---
<Base
  title="Dépannage informatique à domicile · Rivesaltes, Perpignan"
  description="Réparation d'ordinateur, virus, récupération de photos, wifi et imprimante. Technicien à domicile à Rivesaltes et Perpignan. Diagnostic offert."
>
  <PageHead
    kicker="Particuliers · Pyrénées-Orientales"
    title="Votre ordinateur vous pose problème. On règle ça."
    lede="Je me déplace chez vous à Rivesaltes, Perpignan et dans les environs, ou je prends la main à distance. Le diagnostic est offert et vous savez ce que ça coûte avant que je commence."
  >
    <div class="flex flex-wrap gap-3">
      <a class="btn btn--cta" href="/contact/">Décrire mon problème <ArrowRight class="arrow" size="1.05em" aria-hidden="true" /></a>
      <a class="btn btn--ghost" href="#chiffrage">Comment je chiffre</a>
    </div>
    <p class="mt-4 font-mono text-[0.7rem] tracking-[0.04em] text-ink-faint">
      Déplacement inclus jusqu'à 15 km
    </p>
  </PageHead>

  <section class="section">
    <div class="shell">
      <SectionHead
        n="01"
        kicker="Ce que je répare le plus"
        title="Vous reconnaîtrez sûrement votre panne"
        lede="Aucune de ces situations n'est perdue d'avance, et aucune ne nécessite de racheter une machine sans avoir vérifié le reste."
      />
      <ul class="m-0 mt-12 grid list-none grid-cols-[repeat(auto-fit,minmax(17rem,1fr))] border-t border-rule-strong p-0" data-reveal>
        {pannes.map((p) => (
          <li class="border-b border-rule pt-[1.4rem] pr-6 pb-6">
            <h3 class="text-[1.05rem] tracking-[-0.02em]">{p.t}</h3>
            <p class="mt-[0.4rem] max-w-[40ch] text-base text-ink-soft">{p.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-rule section-tint">
    <div class="shell">
      <SectionHead n="02" kicker="Comment ça se passe" title="Quatre étapes, pas de surprise" />
      <div class="grid12 mt-12 items-start gap-y-10">
        <ol class="col-span-full m-0 list-none border-t border-rule-strong p-0 mid:col-span-6">
          {etapes.map((e) => (
            <li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-rule py-[1.35rem]">
              <span class="pt-[0.3rem] font-mono text-[0.75rem] font-semibold text-accent">{e.n}</span>
              <div>
                <h3 class="text-[1.15rem] tracking-[-0.025em]">{e.t}</h3>
                <p class="mt-[0.3rem] max-w-[46ch] text-base text-ink-soft">{e.d}</p>
              </div>
            </li>
          ))}
        </ol>

        <figure class="col-span-full m-0 mid:col-start-8 mid:col-span-5">
          <Image
            src={etabli}
            alt="Mains gantées au travail sur une carte électronique, à l'établi"
            loading="lazy"
            decoding="async"
            widths={[480, 768, 1100]}
            sizes="(width >= 60rem) 40vw, 100vw"
            quality={68}
            class="aspect-video w-full object-cover contrast-105 saturate-80 mid:aspect-[4/5]"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section section-rule" id="chiffrage">
    <div class="shell">
      <SectionHead
        n="03"
        kicker="Comment je chiffre"
        title="Vous saurez ce que ça coûte avant que je commence"
        lede="Je n'affiche pas de grille tarifaire, parce qu'elle serait fausse pour la moitié des situations. Ce qui est garanti, en revanche, tient en six points."
      />
      <ol class="m-0 mt-12 list-none border-t border-rule-strong p-0" data-reveal>
        {chiffrage.map((c, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-[0.9rem] border-b border-rule py-6 xs:grid-cols-[3.5rem_1fr] xs:gap-5">
            <span class="pt-[0.35rem] font-mono text-[0.75rem] font-semibold text-accent">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-[1.2rem] tracking-[-0.028em]">{c.t}</h3>
              <p class="mt-[0.4rem] max-w-[62ch] text-base text-ink-soft">{c.d}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-6 max-w-[62ch] text-base text-ink-soft">
        Pour obtenir un montant, décrivez la panne : la marque de l'appareil, ce qu'il
        fait, depuis quand. Vous recevez une estimation sans engagement.
      </p>
    </div>
  </section>

  <section class="section section-rule">
    <div class="shell">
      <SectionHead n="04" kicker="Franchise" title="Ce que je ne vous vendrai pas" />
      <ul class="m-0 mt-10 flex max-w-[62ch] list-none flex-col p-0" data-reveal>
        {refus.map((r) => (
          <li class="relative border-b border-rule py-[1.1rem] pl-8 text-base text-ink-soft first:border-t">
            <X class="absolute top-[1.35rem] left-[0.35rem] text-accent" size="0.85em" aria-hidden="true" />
            <strong class="font-semibold text-ink">{r.t}</strong> {r.d}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-rule">
    <div class="shell">
      <SectionHead n="05" kicker="Questions fréquentes" title="Avant de m'appeler" />
      <div class="mt-10 max-w-[62rem]"><Faq items={faq} /></div>
    </div>
  </section>

  <CtaBand
    kicker="Votre tour"
    title="Dites-moi ce qui se passe."
    text="La marque de l'appareil, ce qu'il fait, depuis quand. Je vous réponds avec un premier avis et un ordre de prix, sans engagement."
    href="/contact/"
    cta="Décrire mon problème"
    second={{ href: '/blog/', label: 'Lire les conseils pratiques' }}
  />
</Base>
