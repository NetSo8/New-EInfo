---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import X from '@lucide/astro/icons/x';
import Check from '@lucide/astro/icons/check';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqSection from '../components/FaqSection.astro';
import { Image } from 'astro:assets';
import etabli from '../assets/etabli.jpg';


const pannes = [
  { t: 'Il met cinq minutes à démarrer', d: "Neuf fois sur dix, c'est le disque dur d'origine. Un disque SSD et la machine repart pour trois ans." },
  { t: 'Écran noir, plus rien ne se passe', d: "Alimentation, écran, carte mère ou simple câble. Le diagnostic dit lequel, et si ça vaut la réparation." },
  { t: 'Des fenêtres s\'ouvrent toutes seules', d: "Nettoyage complet, vérification des comptes, et changement des mots de passe qui ont pu fuiter." },
  { t: 'Ma boîte mail a été piratée', d: "Reprise du compte, coupure des accès en cours, et mise en place de la double authentification." },
  { t: 'Je veux récupérer mes photos', d: "Récupération quand le support le permet. Je vous dis avant si les chances sont bonnes ou faibles." },
  { t: 'Le wifi ne passe pas au fond du couloir', d: "Mesure réelle du signal pièce par pièce, puis la solution la moins chère qui règle le problème." },
  { t: "L'imprimante ne veut plus rien savoir", d: "Pilotes, réseau, ou matériel en fin de vie. Réglé sur place, ou remplacé en connaissance de cause." },
  { t: 'Je change de machine et je perds tout', d: "Transfert complet : documents, photos, messagerie, mots de passe, favoris, logiciels installés." },
];

const etapes = [
  { n: '01', t: 'Vous décrivez', d: "Par écrit ou par téléphone. La machine, le symptôme, depuis quand. Trois lignes suffisent." },
  { n: '02', t: 'Je chiffre', d: "Je vous annonce ce que je vais faire, le temps que ça prend et ce que ça coûte. Avant de commencer." },
  { n: '03', t: "J'interviens", d: "Chez vous, à l'atelier ou à distance selon la panne. Vous choisissez ce qui vous arrange." },
  { n: '04', t: 'Je vous montre', d: "Ce qui s'est passé, ce que j'ai changé, et les deux ou trois réflexes qui évitent que ça recommence." },
];

const chiffrage = [
  { t: 'Le diagnostic est offert', d: "Je regarde, je vous dis ce qui ne va pas, et vous décidez ensuite. Aucun frais de dossier, aucun frais de prise en charge." },
  { t: 'Rien ne commence sans votre accord', d: "Je vous annonce ce que je vais faire et ce que ça coûte avant d'ouvrir quoi que ce soit. Un devis écrit est remis dès que l'intervention dépasse une heure ou demande une pièce." },
  { t: 'Le montant ne bouge plus ensuite', d: "Si je découvre autre chose en cours de route, je m'arrête et je vous appelle. Vous ne découvrez jamais un écart sur la facture." },
  { t: 'Le déplacement est inclus', d: "Jusqu'à 15 km de Rivesaltes, il n'est pas facturé. Au-delà, le forfait kilométrique vous est annoncé avant que je prenne la route." },
  { t: 'Si ça ne vaut pas le coup, vous ne payez pas', d: "Réparation non rentable, machine en fin de vie, ou vous préférez ne pas donner suite après le devis : dans les trois cas, rien ne vous est facturé." },
  { t: 'Récupération de données : au résultat', d: "Chiffrée après examen du support, et rien n'est dû si rien n'est récupéré." },
];

const refus = [
  { t: 'Un abonnement antivirus annuel.', d: "Ce qui est intégré à Windows suffit dans l'immense majorité des cas, à condition d'être correctement réglé." },
  { t: 'Un ordinateur neuf quand une pièce suffit.', d: 'Je chiffre les deux et je vous laisse comparer.' },
  { t: 'Un « nettoyage » qui ne change rien.', d: 'Si la lenteur vient du matériel, aucun logiciel ne la corrigera.' },
  { t: 'Un contrat que vous ne pouvez pas arrêter.', d: "Pour un particulier, on paie l'intervention, et c'est tout." },
];

const usagesIA = [
  { t: 'Écrire un e-mail ou une lettre difficile', d: "Réclamation, courrier administratif, mot pour l'école : l'IA aide à formuler, vous gardez le contrôle du contenu." },
  { t: 'Trier, résumer, comprendre un document', d: "Un contrat, une notice, un relevé : on voit ensemble ce qu'une IA résume bien et ce qu'elle déforme." },
  { t: 'Ne pas se faire piéger', d: "Reconnaître une voix, une photo ou un texte généré pour tromper, et les arnaques qui utilisent l'IA comme appât." },
  { t: 'Savoir ce qu\'on ne lui confie jamais', d: "Mot de passe, numéro de sécu, données de santé : ce qu'une IA ne doit jamais voir, et pourquoi." },
];

const faq = [
  { q: 'Vous venez chez moi ou je dois apporter la machine ?', a: "Les deux sont possibles. Pour un ordinateur de bureau ou une panne de connexion, je viens chez vous. Pour une réparation matérielle plus longue, il est souvent plus simple et moins cher que la machine passe à l'atelier." },
  { q: 'Est-ce que je paie si vous ne réparez pas ?', a: "Le diagnostic est offert. Si la réparation n'est pas rentable, je vous le dis et vous ne payez rien. Si vous préférez ne pas donner suite après le devis, vous ne payez rien non plus." },
  { q: 'Pourquoi les tarifs ne sont-ils pas affichés ?', a: "Parce qu'une grille de prix affichée est presque toujours fausse pour votre cas précis. Deux ordinateurs qui rament peuvent demander vingt minutes ou une demi-journée. Je préfère regarder, puis vous annoncer un montant ferme, plutôt qu'un tarif d'appel qui gonfle en cours de route." },
  { q: "Vous touchez à mes données personnelles ?", a: "Uniquement ce qui est nécessaire à l'intervention, et jamais sans vous le dire. Aucune copie n'est conservée après restitution. Sur une récupération de données, le support vous est rendu avec l'ensemble de ce qui a été extrait." },
  { q: "Je n'ai jamais utilisé l'IA, la formation s'adresse à moi ?", a: "Oui, c'est même le public le plus fréquent. On part de ce que vous voulez faire concrètement, pas d'un cours théorique, et je vous explique en français sans supposer que vous connaissez le vocabulaire." },
  { q: "Ma machine a douze ans, ça vaut le coup ?", a: "Parfois oui, souvent non. Je regarde le coût des pièces, l'état de la carte mère et la version de Windows encore supportée, et je vous donne une réponse franche, y compris quand elle me fait perdre une réparation." },
];
---
<Base
  title="Dépannage informatique à domicile · Rivesaltes, Perpignan"
  description="Réparation d'ordinateur, virus, récupération de photos, et formation à l'IA pour particuliers, à domicile à Rivesaltes et Perpignan. Diagnostic offert."
>
  <PageHead
    kicker="Dépannage informatique à domicile · Rivesaltes, Perpignan"
    motcle
    title="Votre ordinateur vous pose problème. On règle ça."
    lede="Je me déplace chez vous à Rivesaltes, Perpignan et dans les environs, ou je prends la main à distance. Le diagnostic est offert et vous savez ce que ça coûte avant que je commence. Et si c'est l'IA elle-même qui vous pose question, je vous montre aussi comment vous en servir."
  >
    <div class="flex flex-wrap items-center gap-3">
      <a class="btn btn--cta" href="/contact/">Me contacter <ArrowRight class="arrow" size="1.05em" aria-hidden="true" /></a>
      <a class="btn btn--ghost" href="#chiffrage">Comment je chiffre</a>
    </div>
    <p class="mt-4 text-[0.9rem] text-ink-soft">Déplacement inclus jusqu'à 15 km de Rivesaltes.</p>
  </PageHead>

  <!-- ─── Pannes courantes : grille de fiches ───────────── -->
  <section class="section section-rule scroll-mt-24" id="depannage">
    <div class="shell">
      <SectionHead
        title="Vous reconnaîtrez sûrement votre panne"
        lede="Aucune de ces situations n'est perdue d'avance, et aucune ne nécessite de racheter une machine sans avoir vérifié le reste."
      />
      <ul class="m-0 mt-12 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4">
        {pannes.map((p) => (
          <li class="panel flex flex-col gap-2 p-6" data-reveal>
            <h3 class="text-[1.1rem]/[1.25] tracking-[-0.02em]">{p.t}</h3>
            <p class="text-[0.95rem]/[1.55] text-ink-soft">{p.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── Déroulé : frise verticale + photo ─────────────── -->
  <section class="section section-rule section-tint">
    <div class="shell grid grid-cols-1 items-center gap-x-16 gap-y-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
      <div>
        <SectionHead title="Quatre étapes, pas de surprise" />
        <ol class="m-0 mt-10 list-none p-0">
          {etapes.map((e, i) => (
            <li class="relative grid grid-cols-[2.75rem_1fr] gap-5 pb-8 last:pb-0">
              {/* Le fil qui relie les étapes ; l'ordre, lui, est porté par la liste numérotée. */}
              {i < etapes.length - 1 && (
                <span class="absolute top-11 bottom-1 left-[1.375rem] w-px bg-rule-strong" aria-hidden="true">
                  <span class="fil-progres absolute inset-0 bg-accent"></span>
                </span>
              )}
              <span class="grid size-11 place-items-center rounded-full border border-rule bg-raised font-mono text-[0.8rem] font-semibold text-accent shadow-[var(--shadow-raise)]" aria-hidden="true">{e.n}</span>
              <div class="pt-2">
                <h3 class="text-[1.2rem] tracking-[-0.025em]">{e.t}</h3>
                <p class="mt-1 max-w-[46ch] text-base text-ink-soft">{e.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <figure class="m-0 overflow-hidden rounded-[var(--radius-xl)] shadow-[var(--shadow-raise-hi)]">
        <Image
          src={etabli}
          alt="Réparation d'une carte électronique au tournevis de précision, sur l'établi"
          loading="lazy"
          decoding="async"
          widths={[480, 768, 1100]}
          sizes="(width >= 62rem) 40vw, 100vw"
          quality={68}
          class="aspect-video w-full rounded-none object-cover object-[72%_50%] lg:aspect-[4/5]"
        />
      </figure>
    </div>
  </section>

  <!-- ─── Chiffrage : panneau sombre, engagements cochés ── -->
  <section class="section" id="chiffrage">
    <div class="shell">
      <div class="panel on-nuit border-transparent bg-nuit px-[clamp(1.4rem,4.5vw,4rem)] py-[clamp(2.5rem,5vw,4.5rem)] text-ink">
        <SectionHead
          title="Vous saurez ce que ça coûte avant que je commence"
          lede="Je n'affiche pas de grille tarifaire, parce qu'elle serait fausse pour la moitié des situations. Ce qui est garanti, en revanche, tient en six points."
        />
        <ul class="m-0 mt-12 grid list-none grid-cols-1 gap-x-12 gap-y-8 p-0 md:grid-cols-2">
          {chiffrage.map((c) => (
            <li class="grid grid-cols-[2rem_1fr] gap-4" data-reveal>
              <span class="mt-[0.15rem] grid size-8 place-items-center rounded-full bg-accent-wash text-accent" aria-hidden="true"><Check size={16} stroke-width={2.2} /></span>
              <div>
                <h3 class="text-[1.15rem] tracking-[-0.025em]">{c.t}</h3>
                <p class="mt-1 max-w-[52ch] text-base text-ink-soft">{c.d}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-12 max-w-[62ch] border-t border-rule pt-6 text-base text-ink-soft">
          Pour obtenir un montant, décrivez la panne : la marque de l'appareil, ce qu'il
          fait, depuis quand. Vous recevez une estimation sans engagement.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── Formation IA : panneau sable en deux temps ────── -->
  <section class="pb-[var(--spacing-band)]" id="formation-ia">
    <div class="shell">
      <div class="panel grid grid-cols-1 gap-x-14 gap-y-10 border-transparent bg-sand px-[clamp(1.4rem,4.5vw,4rem)] py-[clamp(2.5rem,5vw,4.5rem)] lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
        <div class="flex flex-col items-start gap-8">
          <SectionHead
            title="Se servir de l'IA sans se faire piéger"
            lede="ChatGPT, Copilot, ou l'assistant intégré à votre téléphone : une formation courte, sur vos usages réels, plutôt qu'un cours théorique."
          />
          <a class="btn btn--cta" href="/contact/">
            Réserver une séance <ArrowRight class="arrow" size="1.05em" aria-hidden="true" />
          </a>
        </div>
        <ul class="m-0 grid list-none grid-cols-1 gap-3 self-center p-0 sm:grid-cols-2">
          {usagesIA.map((u) => (
            <li class="panel flex flex-col gap-1 p-5" data-reveal>
              <h3 class="text-[1.05rem]/[1.25] tracking-[-0.02em]">{u.t}</h3>
              <p class="text-[0.95rem]/[1.55] text-ink-soft">{u.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ─── Ce que je ne vends pas ───────────────────────── -->
  <section class="section section-rule">
    <div class="shell">
      <SectionHead title="Ce que je ne vous vendrai pas" />
      <ul class="m-0 mt-10 grid list-none grid-cols-1 gap-x-12 gap-y-6 p-0 md:grid-cols-2">
        {refus.map((r) => (
          <li class="grid grid-cols-[2rem_1fr] gap-4 text-base text-ink-soft" data-reveal>
            <span class="mt-[0.1rem] grid size-8 place-items-center rounded-full border border-rule text-accent" aria-hidden="true"><X size={15} stroke-width={2.2} /></span>
            <p><strong class="font-semibold text-ink">{r.t}</strong> {r.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FaqSection title="Avant de m'appeler" items={faq} />

  <CtaBand
    title="Dites-moi ce qui se passe."
    text="La marque de l'appareil, ce qu'il fait, depuis quand, ou simplement votre envie de vous mettre à l'IA. Je vous réponds avec un premier avis et un ordre de prix, sans engagement."
    second={{ href: '/blog/', label: 'Lire les conseils pratiques' }}
  />
</Base>
