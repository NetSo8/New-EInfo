---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.titre,
      description: s.resume,
      areaServed: 'Pyrénées-Orientales, France',
      provider: { '@id': 'https://einformatique.fr/#business' },
    },
  })),
};
---
<Base
  title="Services informatiques · Rivesaltes et Perpignan"
  description="Cinq prestations détaillées : dépannage, infrastructure et hébergement VPS, sécurité et sauvegardes, création de site web, automatisation. Pyrénées-Orientales."
>
  <PageHead
    kicker="Catalogue"
    title="Le détail de ce que je fais"
    lede="Cinq prestations décrites sans emballage : le problème traité, ce que vous recevez concrètement, et le délai courant. Si vous cherchez plutôt par situation, passez par la page particuliers ou la page entreprises."
  >
    <nav class="jump" aria-label="Aller à une prestation">
      {services.map((s) => (
        <a href={`#${s.id}`}><span class="mono">{s.n}</span> {s.titre}</a>
      ))}
    </nav>
  </PageHead>

  {services.map((s, i) => (
    <section class:list={['svc', { alt: i % 2 === 1 }]} id={s.id}>
      <div class="shell svc-in">
        <div class="svc-l">
          <p class="svc-n mono">§ {s.n}</p>
          <h2>{s.titre}</h2>
          <p class="svc-pb">{s.probleme}</p>
          <p class="svc-r">{s.resume}</p>
          <div class="svc-tags">
            {s.pour.includes('particulier') && <a class="tag" href="/particuliers/">Particuliers</a>}
            {s.pour.includes('entreprise') && <a class="tag" href="/professionnels/">Entreprises</a>}
          </div>
        </div>
        <div class="svc-r2">
          <p class="label">Ce que vous recevez</p>
          <ul>
            {s.livrables.map((l) => <li>{l}</li>)}
          </ul>
          <dl class="svc-meta">
            <div><dt class="label">Délai courant</dt><dd class="mono">{s.delai}</dd></div>
            <div><dt class="label">Recherché sous</dt><dd class="mono dim">{s.motscles}</dd></div>
          </dl>
          <a class="btn btn--ghost" href="/contact/">Parler de ce point <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  ))}

  <CtaBand
    kicker="Pas sûr de la bonne case ?"
    title="Décrivez la situation, je vous oriente."
    text="La plupart des demandes touchent deux ou trois de ces prestations à la fois. C'est justement l'intérêt de n'avoir qu'un seul interlocuteur : vous n'avez pas à faire le tri vous-même."
  />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .jump a {
    display: inline-flex; align-items: baseline; gap: 0.45rem;
    padding: 0.4rem 0.75rem; border: 1px solid var(--rule-strong);
    text-decoration: none; font-size: 0.83rem; font-weight: 500;
    transition: background .16s var(--ease), border-color .16s var(--ease);
  }
  .jump a:hover { background: var(--accent-wash); border-color: var(--accent); }
  .jump .mono { color: var(--accent); font-size: 0.68rem; }

  .svc { padding-block: clamp(2.75rem, 5vw, 4.75rem); border-bottom: 1px solid var(--rule); scroll-margin-top: 6.5rem; }
  .svc.alt { background: var(--paper-warm); }
  .svc-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .svc-n { color: var(--accent); font-weight: 600; font-size: 0.75rem; letter-spacing: 0.06em; }
  .svc h2 { margin-top: 0.75rem; font-size: clamp(1.75rem, 1.1rem + 2.4vw, 2.75rem); }
  .svc-pb { margin-top: 1rem; font-size: clamp(1.02rem, 0.96rem + 0.35vw, 1.2rem); color: var(--ink); font-weight: 500; max-width: 42ch; }
  .svc-r { margin-top: 0.85rem; color: var(--ink-soft); max-width: 48ch; font-size: 0.95rem; }
  .svc-tags { margin-top: 1.5rem; display: flex; gap: 0.5rem; }
  .tag {
    font-family: var(--mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase;
    border: 1px solid var(--rule-strong); padding: 0.25rem 0.6rem; text-decoration: none; color: var(--ink-soft);
  }
  .tag:hover { border-color: var(--accent); color: var(--accent); }

  .svc-r2 { border-top: 1px solid var(--rule-strong); padding-top: 1.25rem; }
  .svc-r2 ul { list-style: none; padding: 0; margin: 0.9rem 0 0; display: flex; flex-direction: column; }
  .svc-r2 li { padding: 0.65rem 0 0.65rem 1.35rem; border-bottom: 1px solid var(--rule); position: relative; font-size: 0.9rem; }
  .svc-r2 li::before { content: '+'; position: absolute; left: 0; top: 0.65rem; font-family: var(--mono); color: var(--accent); font-size: 0.8rem; }
  .svc-meta { margin: 1.5rem 0; display: flex; flex-wrap: wrap; gap: 1.5rem 2.5rem; }
  .svc-meta dd { margin: 0.25rem 0 0; font-size: 0.78rem; }
  .svc-meta .dim { color: var(--ink-faint); max-width: 32ch; line-height: 1.5; }
  @media (max-width: 60rem) { .svc-in { grid-template-columns: 1fr; } }
</style>
