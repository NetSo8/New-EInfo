---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Check from '@lucide/astro/icons/check';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.titre,
      description: s.resume,
      areaServed: 'Pyrénées-Orientales, France',
      provider: { '@id': 'https://einformatique.fr/#business' },
    },
  })),
};

const tag = 'badge inline-flex min-h-[32px] items-center no-underline hover:border-accent hover:text-accent';
---
<Base
  title="Services · dépannage, formation IA, site web (66)"
  description="Dépannage informatique, formation à l'IA, création de site web, relecture de code généré par IA. Rivesaltes, Perpignan, Pyrénées-Orientales."
>
  <PageHead
    kicker="Catalogue"
    title="Le détail de ce que je fais"
    lede="Quatre prestations, décrites sans emballage : le problème traité et ce que vous recevez concrètement. Si vous cherchez plutôt par situation, passez par la page particuliers ou la page entreprises."
  >
    <nav aria-label="Aller à une prestation">
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
        {services.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              class="inline-flex min-h-[44px] items-center rounded-full border border-rule bg-raised px-4 text-[0.9rem] font-medium no-underline shadow-[var(--shadow-raise)] transition-[border-color,color] duration-150 ease-out-soft hover:border-accent hover:text-accent"
            >
              {s.titre}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </PageHead>

  <div class="flex flex-col gap-5 pb-[var(--spacing-band)]">
    {services.map((s, i) => (
      <section id={s.id} class="scroll-mt-28" aria-labelledby={`${s.id}-t`}>
        <div class="shell">
          <div
            class:list={[
              'panel grid grid-cols-1 items-start gap-x-14 gap-y-10 px-[clamp(1.4rem,4.5vw,3.75rem)] py-[clamp(2rem,4.5vw,3.75rem)] lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)]',
              i % 2 === 1 && 'border-transparent bg-sand',
            ]}
            data-reveal
          >
            <div>
              <h2 class="text-[clamp(1.75rem,1.1rem+2.4vw,2.75rem)]/[1.05] tracking-[-0.035em]" id={`${s.id}-t`}>{s.titre}</h2>
              <p class="mt-4 max-w-[42ch] text-[clamp(1.02rem,0.96rem+0.35vw,1.2rem)] font-medium text-ink">{s.probleme}</p>
              <p class="mt-4 max-w-[52ch] text-base text-ink-soft">{s.resume}</p>
              <p class="mt-6 flex flex-wrap items-center gap-2 text-[0.9rem] text-ink-soft">
                <span>Pour :</span>
                {s.pour.includes('particulier') && <a class={tag} href="/particuliers/">Particuliers</a>}
                {s.pour.includes('entreprise') && <a class={tag} href="/professionnels/">Entreprises</a>}
              </p>
            </div>

            <div class="rounded-[var(--radius-lg)] border border-rule bg-raised p-[clamp(1.25rem,2.5vw,1.9rem)]">
              <h3 class="text-[1.1rem] tracking-[-0.02em]">Ce que vous recevez</h3>
              <ul class="m-0 mt-4 flex list-none flex-col gap-3 p-0">
                {s.livrables.map((l) => (
                  <li class="grid grid-cols-[1.25rem_1fr] gap-3 text-base/[1.5]">
                    <Check class="mt-[0.2rem] text-accent" size={17} stroke-width={2.2} aria-hidden="true" />
                    {l}
                  </li>
                ))}
              </ul>
              <a class="btn btn--ghost mt-6" href="/contact/">
                Me contacter<span class="sr-only"> au sujet de : {s.titre}</span> <ArrowRight class="arrow" size="1.05em" aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <CtaBand
    title="Décrivez la situation, je vous oriente."
    text="La plupart des demandes touchent deux ou trois de ces prestations à la fois. C'est justement l'intérêt de n'avoir qu'un seul interlocuteur : vous n'avez pas à faire le tri vous-même."
  />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</Base>
