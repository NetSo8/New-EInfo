---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Plus from '@lucide/astro/icons/plus';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.titre,
      description: s.resume,
      areaServed: 'Pyrénées-Orientales, France',
      provider: { '@id': 'https://einformatique.fr/#business' },
    },
  })),
};

const tag = 'badge inline-flex min-h-[24px] items-center no-underline hover:border-accent hover:text-accent';
---
<Base
  title="Services · dépannage, formation IA, site web (66)"
  description="Dépannage informatique, formation à l'usage de l'IA, création et maintenance de site web, relecture de code généré par IA. Rivesaltes, Perpignan, Pyrénées-Orientales."
>
  <PageHead
    kicker="Catalogue"
    title="Le détail de ce que je fais"
    lede="Quatre prestations, décrites sans emballage : le problème traité et ce que vous recevez concrètement. La liste est courte parce que c'est un choix : je ne facture que ce que je peux vérifier moi-même. Si vous cherchez plutôt par situation, passez par la page particuliers ou la page entreprises."
  >
    <nav class="flex flex-wrap gap-2" aria-label="Aller à une prestation">
      {services.map((s) => (
        <a
          href={`#${s.id}`}
          class="inline-flex items-baseline gap-[0.45rem] rounded-md border border-rule-strong px-3 py-[0.4rem] text-[0.83rem] font-medium no-underline transition-[background-color,border-color] duration-150 ease-out-soft hover:border-accent hover:bg-accent-wash"
        >
          <span class="font-mono text-[0.68rem] text-accent">{s.n}</span> {s.titre}
        </a>
      ))}
    </nav>
  </PageHead>

  {services.map((s, i) => (
    <section
      id={s.id}
      class:list={[
        'scroll-mt-[6.5rem] border-b border-rule py-[clamp(2.75rem,5vw,4.75rem)]',
        i % 2 === 1 && 'bg-paper-warm',
      ]}
    >
      <div class="shell grid grid-cols-1 items-start gap-[clamp(2rem,5vw,4rem)] mid:grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)]">
        <div>
          <p class="font-mono text-[0.75rem] font-semibold tracking-[0.06em] text-accent">§ {s.n}</p>
          <h2 class="mt-3 text-[clamp(1.75rem,1.1rem+2.4vw,2.75rem)]">{s.titre}</h2>
          <p class="mt-4 max-w-[42ch] text-[clamp(1.02rem,0.96rem+0.35vw,1.2rem)] font-medium text-ink">{s.probleme}</p>
          <p class="mt-[0.85rem] max-w-[48ch] text-base text-ink-soft">{s.resume}</p>
          <div class="mt-6 flex gap-2">
            {s.pour.includes('particulier') && <a class={tag} href="/particuliers/">Particuliers</a>}
            {s.pour.includes('entreprise') && <a class={tag} href="/professionnels/">Entreprises</a>}
          </div>
        </div>

        <div class="border-t border-rule-strong pt-5">
          <p class="label">Ce que vous recevez</p>
          <ul class="m-0 mt-[0.9rem] flex list-none flex-col p-0">
            {s.livrables.map((l) => (
              <li class="relative border-b border-rule py-[0.65rem] pl-[1.35rem] text-base">
                <Plus class="absolute top-[1rem] left-0 text-accent" size="0.8em" aria-hidden="true" />
                {l}
              </li>
            ))}
          </ul>

          <a class="mt-6 btn btn--ghost" href="/contact/">Parler de ce point <ArrowRight class="arrow" size="1.05em" aria-hidden="true" /></a>
        </div>
      </div>
    </section>
  ))}

  <CtaBand
    kicker="Pas sûr de la bonne case ?"
    title="Décrivez la situation, je vous oriente."
    text="La plupart des demandes touchent deux ou trois de ces prestations à la fois. C'est justement l'intérêt de n'avoir qu'un seul interlocuteur : vous n'avez pas à faire le tri vous-même."
  />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</Base>
