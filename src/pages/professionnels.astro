---
import Base from '../layouts/Base.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import Terminal from '../components/Terminal.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqSection from '../components/FaqSection.astro';
import Check from '@lucide/astro/icons/check';
import { services } from '../data/services';
import { Image } from 'astro:assets';
import baie from '../assets/baie.jpg';

const pro = services.filter((s) => s.pour.includes('entreprise'));

const formules = [
  {
    n: '01',
    t: 'Intervention ponctuelle',
    q: "Un problème réseau, une coupure Wi-Fi, une mise en service d'imprimante ou un dépannage matériel ciblé.",
    l: ['Facturation à l\'heure ou au forfait intervention', 'Devis écrit avant démarrage', 'Aucun engagement de durée'],
    p: 'Devis avant démarrage',
  },
  {
    n: '02',
    t: 'Infogérance de site web',
    q: "Vous voulez que votre site internet tourne sans y penser, avec un interlocuteur direct en cas de besoin.",
    l: [
      'Supervision continue du site et de sa disponibilité',
      'Mises à jour, sauvegardes régulières et vérifiées',
      'Correctifs de sécurité et assistance technique',
      'Rapport régulier lisible, sans jargon technique',
    ],
    p: 'Forfait mensuel, après cadrage',
  },
  {
    n: '03',
    t: 'Réseaux, Box & Sauvegardes PME',
    q: "Vos liaisons Wi-Fi, box, switchs et serveurs NAS demandent une configuration soignée pour sécuriser vos données métier.",
    l: [
      "Audit de couverture Wi-Fi et élimination des zones blanches",
      "Installation et sécurisation de box, routeurs et switchs",
      "Mise en place de serveurs NAS pour sauvegardes automatiques",
      'Partage d\'imprimantes et dossiers réseau entre collaborateurs',
    ],
    p: 'Forfait adapté à votre infrastructure',
    bridge: true,
  },
];

const faq = [
  { q: "Vous remplacez un prestataire réseau ou un service informatique ?", a: "Pour une TPE ou PME qui n'a pas besoin d'un informaticien à temps plein, j'assure ce rôle : installation de votre réseau, paramétrage de box/switchs, serveurs NAS, site web et assistance directe." },
  { q: "Comment se déroule l'optimisation de notre réseau ?", a: "On commence par un diagnostic : mesure du signal Wi-Fi, recensement des équipements connectés, état des sauvegardes et points de blocage. Ensuite, des solutions concrètes (câblage, répéteurs, switchs, NAS) sont déployées sans surcoût inutile." },
  { q: "Intervenez-vous sur site ou à distance ?", a: "Les deux. La maintenance du site web et certains dépannages logiciels se font à distance. Pour les câblages, l'installation de box, switchs, points d'accès Wi-Fi et serveurs NAS, je me déplace dans vos locaux dans les Pyrénées-Orientales." },
  { q: "C'est confidentiel ? Vous avez accès à nos données de travail.", a: "Oui, la confidentialité est absolue. Rien n'est partagé ni conservé en dehors des besoins stricts de votre mission de support. Vos données restent sur vos équipements locaux." },
  { q: "Vous installez des serveurs NAS ?", a: "Oui, mise en place de NAS locaux pour centraliser et sauvegarder automatiquement factures, contrats et documents de l'entreprise, sans abonnement cloud obligatoire." },
  { q: "Que se passe-t-il en cas d'urgence réseau ou panne web ?", a: "Vous me contactez directement, sans passer par un standard téléphonique ou un système de tickets impersonnel. Si l'incident bloque votre activité, une intervention prioritaire est programmée." },
  { q: "Pourquoi aucun tarif fixe n'est affiché ?", a: "Parce qu'un bureau de 2 postes n'a pas les mêmes besoins qu'un atelier ou un commerce avec plusieurs points d'accès et un serveur de stockage. Le premier échange permet de dimensionner le devis exact, au juste prix." },
];
---
<Base
  title="Réseaux Wi-Fi, Box, Sauvegardes & Sites web pour TPE · Perpignan (66)"
  description="Optimisation réseau Wi-Fi, installation de box, switchs, serveurs NAS et création de sites web vitrines pour les artisans et TPE des Pyrénées-Orientales."
>
  <PageHead
    kicker="Réseaux, Équipements & Sites web · Artisans, Commerçants et TPE"
    motcle
    title="Je fais deux choses, et je les fais bien."
    lede="Des réseaux Wi-Fi et des équipements locaux (box, switchs, NAS) fiables pour travailler sereinement au quotidien, et un site web sobre et rapide pour vos clients. Un seul contact direct, sans intermédiaire."
  >
    <div class="flex flex-wrap items-center gap-3">
      <a class="btn btn--cta" href="/contact/">Me contacter <ArrowRight class="arrow" size="1.05em" aria-hidden="true" /></a>
      <a class="btn btn--ghost" href="#formules">Voir les formules</a>
    </div>
    <p class="mt-4 text-[0.9rem] text-ink-soft">Premier échange gratuit et sans engagement.</p>
  </PageHead>

  <!-- ─── Relevé type : terminal + lecture ─────────────── -->
  <section class="section section-rule">
    <div class="shell">
      <SectionHead
        title="Ce que je trouve en arrivant"
        lede="Ce relevé illustre la réalité fréquente d'un réseau de petite entreprise : Wi-Fi instable, box saturée et sauvegardes déconnectées."
      />
      <div class="mt-12 grid grid-cols-1 items-center gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)]">
        <div class="panel on-nuit border-transparent bg-nuit p-[clamp(0.75rem,2vw,1.5rem)]">
          <Terminal
            title="audit-reseau : vérification équipement local & connectivité"
            prompt=">"
            lines={[
              { k: 'cmd', t: 'network-scan --local-lan & check-nas' },
              { k: 'warn', t: 'Zone Wi-Fi atelier : perte de paquets 28% (signal dégradé)' },
              { k: 'warn', t: 'Imprimante réseau : conflit d\'adresse IP avec un terminal' },
              { k: 'warn', t: 'Serveur de fichiers local : aucune sauvegarde automatique active' },
              { k: 'ok', t: 'Déploiement point d\'accès Wi-Fi & attribution baux DHCP fixes' },
              { k: 'ok', t: 'Configuration NAS sécurisé : synchronisation quotidienne vérifiée' },
              { k: 'out', t: 'Réseau stable, débit homogène et données professionnelles à l\'abri' },
            ]}
          />
        </div>

        <div class="flex flex-col items-start gap-4 text-base text-ink-soft">
          <p>
            Ces alertes ne bloquent pas toujours le premier jour. Mais le jour où le Wi-Fi coupe pendant un encaissement ou qu'un disque dur lâche sans sauvegarde NAS, l'activité est paralysée.
          </p>
          <p>
            Une installation réseau propre et des sauvegardes automatisées permettent de travailler en toute sérénité sans risquer de perdre ses documents.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Formules : trois panneaux, le troisième en avant ─ -->
  <section class="section section-rule section-tint" id="formules">
    <div class="shell">
      <SectionHead
        title="Trois façons de travailler ensemble"
        lede="D'une intervention d'urgence ponctuelle à un accompagnement mensuel complet de votre parc."
      />

      <ul class="m-0 mt-12 grid list-none grid-cols-1 gap-5 p-0 lg:grid-cols-3">
        {formules.map((f) => (
          <li
            class:list={[
              'panel flex flex-col gap-5 p-[clamp(1.5rem,2.5vw,2.1rem)]',
              f.bridge && 'on-nuit border-transparent bg-nuit text-ink',
            ]}
            data-reveal
            data-spotlight
          >
            <div>
              <h3 class="text-[1.35rem] tracking-[-0.028em]">{f.t}</h3>
              <p class="mt-2 text-base text-ink-soft">{f.q}</p>
            </div>

            <ul class="m-0 flex flex-1 list-none flex-col gap-3 border-t border-rule p-0 pt-5">
              {f.l.map((x) => (
                <li class="grid grid-cols-[1.25rem_1fr] gap-3 text-base/[1.5]">
                  <Check class="mt-[0.2rem] text-accent" size={17} stroke-width={2.2} aria-hidden="true" />
                  {x}
                </li>
              ))}
            </ul>

            <p class="self-start rounded-full bg-accent-wash px-4 py-[0.4rem] text-[0.9rem] font-semibold text-accent">{f.p}</p>
          </li>
        ))}
      </ul>

      <p class="mt-6 max-w-[62ch] text-base text-ink-soft">
        Aucune mauvaise surprise : le montant est annoncé et cadré après le premier échange technique, par écrit, et ne bouge plus sans votre validation.
      </p>
    </div>
  </section>

  <!-- ─── Périmètre : deux prestations en panneaux + photo ─ -->
  <section class="section section-rule">
    <div class="shell">
      <SectionHead
        title="Deux chantiers, et c'est volontaire"
        lede="La création et maintenance de votre site web d'un côté, l'installation de votre réseau, box et sauvegardes NAS de l'autre. Un périmètre concret pour vous garantir une disponibilité réelle."
      />
      <div class="mt-12 grid grid-cols-1 items-start gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,0.8fr)]">
        {pro.map((s) => (
          <article id={s.id} class="panel flex scroll-mt-28 flex-col gap-4 p-[clamp(1.5rem,2.5vw,2.1rem)]" aria-labelledby={`${s.id}-t`} data-reveal>
            <h3 class="text-[1.35rem] tracking-[-0.03em]" id={`${s.id}-t`}>{s.titre}</h3>
            <p class="text-base text-ink-soft">{s.resume}</p>
            <ul class="m-0 flex list-none flex-col gap-3 border-t border-rule p-0 pt-5">
              {s.livrables.map((l) => (
                <li class="grid grid-cols-[1.25rem_1fr] gap-3 text-[0.97rem]/[1.5]">
                  <Check class="mt-[0.2rem] text-accent" size={17} stroke-width={2.2} aria-hidden="true" />
                  {l}
                </li>
              ))}
            </ul>
          </article>
        ))}

        <figure class="m-0 overflow-hidden rounded-[var(--radius-xl)] lg:sticky lg:top-28">
          <Image
            src={baie}
            alt="Baie de serveurs câblée, câbles réseau branchés sur un panneau de brassage numéroté"
            loading="lazy"
            decoding="async"
            widths={[420, 700, 1000]}
            sizes="(width >= 62rem) 28vw, 100vw"
            quality={68}
            class="aspect-video w-full rounded-none object-cover contrast-105 saturate-70 lg:aspect-3/4"
          />
        </figure>
      </div>
    </div>
  </section>

  <FaqSection title="Les questions fréquentes" items={faq} />

  <CtaBand
    title="Trente minutes pour faire le point sur votre informatique."
    text="Un premier échange sans engagement : vos postes, vos sauvegardes, vos pannes récurrentes ou votre site web. Vous repartez avec un avis direct et un ordre de grandeur clair."
  />
</Base>
