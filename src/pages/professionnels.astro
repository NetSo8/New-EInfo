---
import Base from '../layouts/Base.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import Terminal from '../components/Terminal.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqSection from '../components/FaqSection.astro';
import Check from '@lucide/astro/icons/check';
import { services } from '../data/services';
import { Image } from 'astro:assets';
import baie from '../assets/baie.jpg';

const pro = services.filter((s) => s.pour.includes('entreprise'));

const formules = [
  {
    n: '01',
    t: 'Intervention ponctuelle',
    q: "Un poste en panne, un problème réseau, une mise à niveau matérielle ou une intervention ciblée sur vos systèmes Windows.",
    l: ['Facturation à l\'heure ou au forfait intervention', 'Devis écrit avant démarrage', 'Aucun engagement de durée'],
    p: 'Devis avant démarrage',
  },
  {
    n: '02',
    t: 'Infogérance de site web',
    q: "Vous voulez que votre site internet tourne sans y penser, avec un interlocuteur direct en cas de besoin.",
    l: [
      'Supervision continue du site et de sa disponibilité',
      'Mises à jour, sauvegardes régulières et vérifiées',
      'Correctifs de sécurité et assistance technique',
      'Rapport régulier lisible, sans jargon technique',
    ],
    p: 'Forfait mensuel, après cadrage',
  },
  {
    n: '03',
    t: 'Maintenance & Parc Windows PME',
    q: "Vos postes et serveurs Windows demandent un suivi régulier pour éviter les pannes, les lenteurs et sécuriser vos données métier.",
    l: [
      "Audit régulier de l'état de santé des postes de travail",
      "Suivi des mises à jour Windows et des logiciels métiers",
      "Mise en place et contrôle régulier des sauvegardes",
      'Gestion des droits d\'accès et assistance rapide aux utilisateurs',
    ],
    p: 'Forfait adapté à la taille du parc',
    bridge: true,
  },
];

const faq = [
  { q: "Vous remplacez un service informatique ?", a: "Pour une TPE ou PME qui n'a pas la taille d'avoir un service informatique interne, j'assure ce rôle : maintenance des machines, assistance aux utilisateurs, gestion du site et interlocuteur unique pour vos questions techniques." },
  { q: "Comment se déroule la maintenance de nos postes Windows ?", a: "On commence par un état des lieux : inventaire des machines, état des sauvegardes, logiciels installés et points de blocage. Ensuite, un plan d'action préventif est mis en place pour que vos équipes travaillent sans ralentissement." },
  { q: "Intervenez-vous sur site ou à distance ?", a: "Les deux. Beaucoup d'opérations et de dépannages se font à distance en quelques minutes pour ne pas bloquer vos collaborateurs. Pour les interventions matérielles, les installations réseau ou les pannes bloquantes, je me déplace directement dans vos locaux dans les Pyrénées-Orientales." },
  { q: "C'est confidentiel ? Vous avez accès à nos données de travail.", a: "Oui, la confidentialité est absolue. Rien n'est partagé ni conservé en dehors des besoins stricts de votre mission de support. Un accord de confidentialité (NDA) peut être formalisé avant toute prise en main." },
  { q: "Vous administrez nos serveurs ?", a: "Oui, qu'il s'agisse de serveurs Windows locaux (partages de fichiers, gestion des accès) ou de serveurs d'hébergement web sous Linux. Tout est documenté pour que votre entreprise garde toujours la main sur ses identifiants." },
  { q: "Que se passe-t-il en cas d'urgence ?", a: "Vous m'appelez directement, sans passer par un standard téléphonique ou un système de tickets impersonnel. Si l'incident est bloquant, un diagnostic à distance est lancé immédiatement ou une intervention sur site est programmée." },
  { q: "Pourquoi aucun tarif fixe n'est affiché ?", a: "Parce qu'une entreprise de 3 postes n'a pas les mêmes besoins qu'une PME de 25 machines avec un serveur de données. Le premier échange d'une trentaine de minutes permet de dimensionner le forfait exact, au juste prix et sans mauvaise surprise." },
];
---
<Base
  title="Maintenance informatique Windows & Sites web pour PME · Perpignan (66)"
  description="Maintenance de parc informatique Windows, dépannage, création de sites web et administration système pour les TPE/PME des Pyrénées-Orientales."
>
  <PageHead
    kicker="Maintenance informatique Windows & Sites web · TPE et PME"
    motcle
    title="Je fais deux choses, et je les fais bien."
    lede="Vous n'avez pas de service informatique et vous n'en avez pas besoin d'un à temps plein. Je maintiens et fiabilise vos postes et serveurs Windows au quotidien, et je conçois et fais tourner votre site web. Un seul contact direct, sans intermédiaire."
  >
    <div class="flex flex-wrap items-center gap-3">
      <a class="btn btn--cta" href="/contact/">Me contacter <ArrowRight class="arrow" size="1.05em" aria-hidden="true" /></a>
      <a class="btn btn--ghost" href="#formules">Voir les formules</a>
    </div>
    <p class="mt-4 text-[0.9rem] text-ink-soft">Premier échange gratuit et sans engagement.</p>
  </PageHead>

  <!-- ─── Relevé type : terminal + lecture ─────────────── -->
  <section class="section section-rule">
    <div class="shell">
      <SectionHead
        title="Ce que je trouve en arrivant"
        lede="Ce relevé montre la réalité fréquente d'un poste Windows en entreprise non maintenu : disques encombrés, mises à jour en souffrance et sauvegardes non fonctionnelles."
      />
      <div class="mt-12 grid grid-cols-1 items-center gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)]">
        <div class="panel on-nuit border-transparent bg-nuit p-[clamp(0.75rem,2vw,1.5rem)]">
          <Terminal
            title="audit-parc : vérification poste Windows de travail"
            prompt=">"
            lines={[
              { k: 'cmd', t: 'systeminfo & health-check.bat' },
              { k: 'warn', t: 'Mises à jour de sécurité Windows : 14 correctifs en attente' },
              { k: 'warn', t: 'Disque C: (SSD) saturé à 92% — ralentissements système mesurés' },
              { k: 'warn', t: 'Dernière sauvegarde locale : il y a 83 jours (support déconnecté)' },
              { k: 'ok', t: 'Nettoyage et optimisation stockage : 64 Go d\'espace récupérés' },
              { k: 'ok', t: 'Planification sauvegarde automatique et journalisation active' },
              { k: 'out', t: 'Poste réactif, sécurisé et prêt pour la reprise d\'activité' },
            ]}
          />
        </div>

        <div class="flex flex-col items-start gap-4 text-base text-ink-soft">
          <p>
            Ces alertes ne déclenchent pas toujours une panne visible tout de suite. Mais le jour où un disque lâche ou qu'un logiciel plante, l'absence de sauvegarde paralyse votre activité.
          </p>
          <p>
            La maintenance préventive permet de désamorcer ces blocages avant qu'ils ne coûtent du temps et de l'argent à vos collaborateurs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Formules : trois panneaux, le troisième en avant ─ -->
  <section class="section section-rule section-tint" id="formules">
    <div class="shell">
      <SectionHead
        title="Trois façons de travailler ensemble"
        lede="D'une intervention d'urgence ponctuelle à un accompagnement mensuel complet de votre parc."
      />

      <ul class="m-0 mt-12 grid list-none grid-cols-1 gap-5 p-0 lg:grid-cols-3">
        {formules.map((f) => (
          <li
            class:list={[
              'panel flex flex-col gap-5 p-[clamp(1.5rem,2.5vw,2.1rem)]',
              f.bridge && 'on-nuit border-transparent bg-nuit text-ink',
            ]}
            data-reveal
            data-spotlight
          >
            <div>
              <h3 class="text-[1.35rem] tracking-[-0.028em]">{f.t}</h3>
              <p class="mt-2 text-base text-ink-soft">{f.q}</p>
            </div>

            <ul class="m-0 flex flex-1 list-none flex-col gap-3 border-t border-rule p-0 pt-5">
              {f.l.map((x) => (
                <li class="grid grid-cols-[1.25rem_1fr] gap-3 text-base/[1.5]">
                  <Check class="mt-[0.2rem] text-accent" size={17} stroke-width={2.2} aria-hidden="true" />
                  {x}
                </li>
              ))}
            </ul>

            <p class="self-start rounded-full bg-accent-wash px-4 py-[0.4rem] text-[0.9rem] font-semibold text-accent">{f.p}</p>
          </li>
        ))}
      </ul>

      <p class="mt-6 max-w-[62ch] text-base text-ink-soft">
        Aucune mauvaise surprise : le montant est annoncé et cadré après le premier échange technique, par écrit, et ne bouge plus sans votre validation.
      </p>
    </div>
  </section>

  <!-- ─── Périmètre : deux prestations en panneaux + photo ─ -->
  <section class="section section-rule">
    <div class="shell">
      <SectionHead
        title="Deux chantiers, et c'est volontaire"
        lede="La création et maintenance de votre site web d'un côté, la maintenance et l'administration de vos postes Windows de l'autre. Un périmètre concret pour vous garantir une disponibilité réelle."
      />
      <div class="mt-12 grid grid-cols-1 items-start gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,0.8fr)]">
        {pro.map((s) => (
          <article id={s.id} class="panel flex scroll-mt-28 flex-col gap-4 p-[clamp(1.5rem,2.5vw,2.1rem)]" aria-labelledby={`${s.id}-t`} data-reveal>
            <h3 class="text-[1.35rem] tracking-[-0.03em]" id={`${s.id}-t`}>{s.titre}</h3>
            <p class="text-base text-ink-soft">{s.resume}</p>
            <ul class="m-0 flex list-none flex-col gap-3 border-t border-rule p-0 pt-5">
              {s.livrables.map((l) => (
                <li class="grid grid-cols-[1.25rem_1fr] gap-3 text-[0.97rem]/[1.5]">
                  <Check class="mt-[0.2rem] text-accent" size={17} stroke-width={2.2} aria-hidden="true" />
                  {l}
                </li>
              ))}
            </ul>
          </article>
        ))}

        <figure class="m-0 overflow-hidden rounded-[var(--radius-xl)] lg:sticky lg:top-28">
          <Image
            src={baie}
            alt="Baie de serveurs câblée, câbles réseau branchés sur un panneau de brassage numéroté"
            loading="lazy"
            decoding="async"
            widths={[420, 700, 1000]}
            sizes="(width >= 62rem) 28vw, 100vw"
            quality={68}
            class="aspect-video w-full rounded-none object-cover contrast-105 saturate-70 lg:aspect-3/4"
          />
        </figure>
      </div>
    </div>
  </section>

  <FaqSection title="Les questions fréquentes" items={faq} />

  <CtaBand
    title="Trente minutes pour faire le point sur votre informatique."
    text="Un premier échange sans engagement : vos postes, vos sauvegardes, vos pannes récurrentes ou votre site web. Vous repartez avec un avis direct et un ordre de grandeur clair."
  />
</Base>
