---
import Base from '../layouts/Base.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import Plus from '@lucide/astro/icons/plus';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import Terminal from '../components/Terminal.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { services } from '../data/services';
import { Image } from 'astro:assets';
import baie from '../assets/baie.jpg';


const pro = services.filter((s) => s.pour.includes('entreprise'));

const formules = [
  {
    n: '01',
    t: 'Intervention ponctuelle',
    q: "Un site à construire, une fonctionnalité à ajouter, ou un lot de code généré par IA à faire relire avant la mise en production.",
    l: ['Facturation à l\'heure ou au forfait projet', 'Devis écrit avant démarrage', 'Aucun engagement de durée'],
    p: 'Devis avant démarrage',
  },
  {
    n: '02',
    t: 'Infogérance mensuelle',
    q: "Vous voulez que le site tourne sans y penser, avec quelqu'un à appeler.",
    l: [
      'Supervision continue du site et de sa disponibilité',
      'Mises à jour, sauvegardes vérifiées, correctifs de sécurité',
      'Relecture du code livré par un prestataire ou une IA avant chaque mise en ligne',
      'Rapport mensuel lisible, sans jargon',
    ],
    p: 'Forfait mensuel, après cadrage',
  },
  {
    n: '03',
    t: 'Revue de code approfondie',
    q: "Votre équipe utilise Copilot, Cursor ou ChatGPT en production, et personne n'a de vue d'ensemble sur ce qui part réellement en ligne.",
    l: [
      "Cartographie du code généré par IA dans le dépôt",
      "Détection des erreurs récurrentes propres à l'assistant utilisé",
      'Vérification que le comportement livré correspond à la spécification',
      'Rapport priorisé : ce qui est urgent, ce qui peut attendre, ce qui est correct',
    ],
    p: 'Devis après échange',
    bridge: true,
  },
];

const faq = [
  { q: "Vous remplacez notre développeur ou notre agence ?", a: "Pas nécessairement. Je peux relire ce qu'ils livrent avant la mise en ligne, reprendre un projet abandonné, ou construire et maintenir le site en direct si vous n'avez personne d'autre. Vous décidez du périmètre." },
  { q: "Comment vous détectez les problèmes propres à Copilot, Cursor ou ChatGPT ?", a: "Chaque assistant a ses tics : tel modèle laisse des secrets en dur plus souvent, tel autre invente des noms de dépendances plausibles. Je relis en connaissant ces schémas récurrents, pas seulement les motifs génériques qu'un linter automatique connaît déjà." },
  { q: "Vous corrigez directement le code, ou juste un rapport ?", a: "Les deux sont possibles. Un rapport priorisé si votre équipe préfère corriger elle-même, des correctifs directs si vous voulez que ce soit réglé. Le tarif suit ce choix." },
  { q: "C'est confidentiel ? Vous voyez notre code source.", a: "Oui. Le code n'est partagé avec personne d'autre, et rien n'en est conservé après la mission sauf accord contraire. Un accord de confidentialité peut être signé avant tout accès." },
  { q: "Vous administrez nos serveurs ?", a: "Je configure et j'exploite les serveurs Linux et les VPS dont dépend le site, et je les documente pour qu'un autre puisse les reprendre. Si votre activité repose sur un parc de serveurs déjà important, un administrateur système à temps plein sera plus pertinent que moi, et je le dis avant de commencer plutôt qu'après." },
  { q: "Que se passe-t-il si vous n'êtes pas disponible ?", a: "C'est la vraie limite d'un freelance et je ne la cache pas. Tout ce que je gère est documenté et reproductible, les accès de secours sont détenus par le dirigeant, et rien ne dépend d'un savoir qui resterait dans ma tête. Un confrère peut reprendre sans repartir de zéro." },
  { q: "Pourquoi aucun tarif n'est affiché ?", a: "Parce qu'un forfait annoncé sans avoir vu le projet est soit trop cher pour vous, soit intenable pour moi. Le premier échange de trente minutes est gratuit et suffit en général à donner un ordre de grandeur ferme, avant tout engagement." },
];

const bridgeItems = [
  { t: 'Harnais de sécurité pour agents IA', d: "Exécution isolée d'un agent non fiable : sandboxing dans un premier temps, enclave matérielle ensuite." },
  { t: 'Scanner de code généré par IA', d: 'Patterns dangereux propres à chaque assistant : Copilot, Cursor, Claude et GPT ont chacun leurs tics.' },
  { t: 'Orchestrateur de vérification', d: "Typage, analyse statique, cohérence entre le README et l'implémentation réelle, en un seul passage." },
  { t: 'Outillage de migration post-quantique', d: 'Préparer le remplacement des algorithmes actuels par des versions résistantes (Kyber, Dilithium).' },
];
---
<Base
  title="Sites web & revue de code IA pour TPE/PME · Perpignan (66)"
  description="Création et maintenance de site web, et relecture de code généré par IA (Copilot, Cursor, ChatGPT, Claude) pour les TPE des Pyrénées-Orientales."
>
  <PageHead
    tone="warm"
    kicker="Entreprises · TPE, PME, professions libérales"
    title="Je fais deux choses, et je les fais bien."
    lede="Vous n'avez pas de service informatique et vous n'en aurez pas. Je ne vous propose pas pour autant un catalogue de dix lignes : je construis et je maintiens votre site, et je relis le code que votre équipe ou ses prestataires produisent avec une IA. Ce qui sort de ce périmètre, je le dis et je vous oriente."
  >
    <div class="flex flex-wrap gap-3">
      <a class="btn btn--cta" href="/contact/">Demander une relecture <ArrowRight class="arrow" size="1.05em" aria-hidden="true" /></a>
      <a class="btn btn--ghost" href="#formules">Voir les formules</a>
    </div>
    <p class="mt-4 font-mono text-[0.7rem] tracking-[0.04em] text-ink-faint">
      Premier échange gratuit et sans engagement
    </p>
  </PageHead>

  <section class="section">
    <div class="shell">
      <SectionHead
        n="01"
        kicker="Le point de départ"
        title="Ce que je trouve en arrivant"
        lede="Ce relevé n'a rien d'exceptionnel : c'est la situation ordinaire d'une équipe qui utilise un assistant IA depuis quelques mois et n'a jamais eu de raison de tout relire."
      />
      <div class="grid12 mt-12 items-start gap-y-8">
        <div class="col-span-full mid:col-span-7">
          <Terminal
            title="premier relevé : dépôt client, 62 fichiers générés par IA"
            lines={[
              { k: 'cmd', t: 'grep -rniE "sk-|api_key|password|TODO" src/' },
              { k: 'ok', t: 'src/auth/session.js   tokens signés, expiration correcte' },
              { k: 'ok', t: 'src/db/pool.js        requêtes préparées, pas de concat.' },
              { k: 'warn', t: 'src/config.js:14      clé Stripe laissée en dur' },
              { k: 'warn', t: 'src/api/upload.js:22  aucune limite de taille ni de type' },
              { k: 'warn', t: 'src/lib/pdf-gen.js    dépendance "pdf-easy-gen" introuvable sur npm' },
              { k: 'warn', t: 'src/api/users.js:41   requête SQL construite par concatenation' },
              { k: 'out', t: 'fichiers signalés      6 sur 62 générés par l\'assistant IA' },
              { k: 'out', t: 'couverture de tests     aucune sur les routes signalées' },
              { k: 'dim', t: '' },
              { k: 'dim', t: 'aucune de ces lignes ne déclenche d\'alerte aujourd\'hui.' },
            ]}
          />
        </div>

        <div class="col-span-full flex flex-col items-start gap-4 text-base text-ink-soft mid:col-start-9 mid:col-span-4">
          <p>
            Aucune de ces lignes ne provoque de panne aujourd'hui. Elles décident
            simplement de ce qui se passera le jour où quelqu'un les trouve avant vous :
            une correction d'une heure, ou un incident de sécurité.
          </p>
          <p>
            La relecture sert à transformer cette liste floue en décisions chiffrées,
            avec un ordre de priorité que vous pouvez tenir sur les prochaines mises en
            ligne.
          </p>
          <a class="tlink" href="/contact/">Demander la relecture</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-rule section-tint" id="formules">
    <div class="shell">
      <SectionHead
        n="02"
        kicker="Formules"
        title="Trois façons de travailler ensemble"
        lede="On commence rarement par la troisième. On finit souvent par la deuxième."
      />

      <div class="mt-12 grid grid-cols-1 border-t border-rule-strong lg:grid-cols-3" data-reveal>
        {formules.map((f) => (
          <article
            class:list={[
              'flex flex-col gap-[1.1rem] border-b border-rule px-6 py-7',
              f.bridge ? 'on-nuit bg-nuit' : 'lg:not-first:border-l',
            ]}
          >
            <header>
              <span class="font-mono text-[0.72rem] font-semibold text-accent">{f.n}</span>
              <h3 class="mt-2 text-[1.25rem] tracking-[-0.028em]">{f.t}</h3>
              <p class="mt-[0.4rem] text-base text-ink-soft">{f.q}</p>
            </header>

            <ul class="m-0 flex flex-1 list-none flex-col gap-[0.55rem] p-0">
              {f.l.map((x) => (
                <li class="relative pl-[1.1rem] text-base/[1.5]">
                  <Plus class="absolute top-[0.4rem] left-0 text-accent" size="0.75em" aria-hidden="true" />
                  {x}
                </li>
              ))}
            </ul>

            <p class="font-mono text-[0.8rem] font-semibold tracking-[0.02em] text-accent">{f.p}</p>
          </article>
        ))}
      </div>

      <p class="mt-5 max-w-[62ch] text-base text-ink-faint">
        Aucune grille tarifaire affichée : le montant dépend de la taille du projet, du
        volume de code à relire et du niveau de disponibilité attendu. Il est chiffré
        après le premier échange, par écrit, et ne bouge plus sans votre accord.
      </p>
    </div>
  </section>

  <section class="section section-rule">
    <div class="shell">
      <SectionHead
        n="03"
        kicker="Périmètre technique"
        title="Deux chantiers, et c'est volontaire"
        lede="Le site web d'un côté, la relecture du code généré par IA de l'autre. Un périmètre étroit assumé : c'est ce qui me permet d'aller plus loin que la liste de contrôle sur les deux."
      />
      <div class="grid12 mt-12 items-start gap-y-10">
        <ol class="col-span-full m-0 list-none border-t border-rule-strong p-0 mid:col-span-7">
          {pro.map((s) => (
            <li id={s.id} class="grid scroll-mt-28 grid-cols-[3rem_1fr] gap-4 border-b border-rule py-7">
              <span class="pt-[0.35rem] font-mono text-[0.75rem] font-semibold text-accent">{s.n}</span>
              <div>
                <h3 class="text-[1.3rem] tracking-[-0.03em]">{s.titre}</h3>
                <p class="mt-[0.45rem] max-w-[52ch] text-base text-ink-soft">{s.resume}</p>
                <ul class="m-0 mt-[0.9rem] flex list-none flex-col gap-[0.35rem] p-0">
                  {s.livrables.map((l) => (
                    <li class="relative pl-[1.1rem] text-base text-ink-soft">
                      <Plus class="absolute top-[0.45rem] left-0 text-accent" size="0.75em" aria-hidden="true" />
                      {l}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>

        <figure class="col-span-full m-0 mid:col-start-9 mid:col-span-4 mid:sticky mid:top-28">
          <Image
            src={baie}
            alt="Baie de serveurs câblée, voyants allumés dans la pénombre d'un local technique"
            loading="lazy"
            decoding="async"
            widths={[420, 700, 1000]}
            sizes="(width >= 60rem) 32vw, 100vw"
            quality={68}
            class="aspect-video w-full object-cover contrast-105 saturate-70 mid:aspect-3/4"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section on-nuit bg-nuit">
    <div class="shell max-w-[62rem]">
      <p class="label text-accent">04 / Harnais, scanners et outils IA</p>
      <h2 class="mt-[0.9rem] text-x1">Ce qui se construit derrière, pas encore facturé</h2>
      <p class="mt-[1.1rem] max-w-[58ch] text-ink-soft">
        Je construis, à titre personnel, des outils pour sécuriser le code et les
        agents produits par l'IA : harnais d'exécution, scanners, orchestrateurs de
        vérification. Rien de ce qui suit n'est vendu tant que ce n'est pas publié et
        vérifiable : c'est la direction, pas une prestation du jour.
      </p>

      <div class="mt-10 grid grid-cols-1 items-start gap-10 mid:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="label mb-[0.9rem]">Ce qui se construit</p>
          <ul class="m-0 flex list-none flex-col p-0">
            {bridgeItems.map((b) => (
              <li class="relative border-b border-rule py-[0.7rem] pl-[1.2rem] text-base first:border-t">
                <ChevronRight class="absolute top-[0.8rem] left-0 text-accent" size="0.9em" aria-hidden="true" />
                <strong class="font-semibold text-nuit-text">{b.t}</strong>
                <span class="block text-[0.92rem] text-nuit-soft">{b.d}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="label mb-[0.9rem]">À quoi ça ressemble aujourd'hui</p>
          <Terminal
            title="prototype personnel : ia-scan"
            lines={[
              { k: 'cmd', t: 'ia-scan run --model copilot ./repo' },
              { k: 'ok', t: 'typage       0 erreur, 412 fichiers' },
              { k: 'warn', t: 'secrets      2 clés API trouvées en dur' },
              { k: 'warn', t: "dépendances  1 paquet introuvable sur npm (halluciné)" },
              { k: 'dim', t: 'prototype personnel, pas encore public' },
            ]}
          />
        </div>
      </div>

      <div class="mt-10 max-w-[58ch] border-t border-rule-nuit pt-6">
        <p class="text-base text-nuit-soft">
          Aucun de ces outils n'est disponible à la vente aujourd'hui. Si votre
          entreprise fait déjà tourner des agents IA en production et que le sujet
          vous concerne, dites-le-moi : je préviens en priorité les personnes
          intéressées quand l'un d'eux sort de la phase de prototype.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a class="btn btn--nuit-ghost" href="/contact/">En parler <ArrowRight class="arrow" size="1.05em" aria-hidden="true" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="shell">
      <SectionHead n="05" kicker="Questions fréquentes" title="Les objections légitimes" />
      <div class="mt-10 max-w-[62rem]"><Faq items={faq} /></div>
    </div>
  </section>

  <CtaBand
    kicker="Prochaine étape"
    title="Trente minutes pour savoir où vous en êtes."
    text="Un échange sans engagement : votre projet, ce qui vous inquiète, ce que votre équipe a déjà produit avec une IA. Vous repartez avec un premier avis, même si nous ne travaillons pas ensemble."
    href="/contact/"
    cta="Demander une relecture"
  />
</Base>
