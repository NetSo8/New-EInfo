---
import Base from '../layouts/Base.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import Terminal from '../components/Terminal.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqSection from '../components/FaqSection.astro';
import Check from '@lucide/astro/icons/check';
import { services } from '../data/services';
import { Image } from 'astro:assets';
import baie from '../assets/baie.jpg';

const pro = services.filter((s) => s.pour.includes('entreprise'));

const formules = [
  {
    n: '01',
    t: 'Diagnostic & Intervention ponctuelle',
    q: "Un logiciel qui rame, un goulot d'étranglement à identifier, ou un besoin d'assistance technique ciblée sur votre parc Windows.",
    l: [
      'Analyse du comportement réel : CPU, mémoire, I/O disque',
      'Rapport technique chiffré et recommandations d\'action',
      'Aucun engagement de durée, devis annoncé avant de commencer',
    ],
  },
  {
    n: '02',
    t: 'Mission de développement sur mesure',
    q: "Conception d'un utilitaire ou service Windows léger, reprise d'un ancien outil ou réécriture d'un module critique.",
    l: [
      'Cadrage écrit : objectif, périmètre, mesures de réussite',
      'Développement natif C++ / Win32 ou Go sans runtime lourd',
      'Code source, documentation claire et tests remis à la fin',
      'Mesures de performance avant / après livraison',
    ],
  },
  {
    n: '03',
    t: 'Administration système & Automatisation',
    q: "Fiabiliser vos postes et serveurs Windows : scripts PowerShell/batch sur mesure, durcissement des accès et automatisation de tâches récurrentes.",
    l: [
      'Automatisation des tâches de maintenance et d\'exploitation',
      'Configuration des services Windows, tâches planifiées et droits',
      'Audit de configuration système et fiabilisation des postes',
      'Documentation complète pour que vos équipes restent autonomes',
    ],
    bridge: true,
  },
];

const faq = [
  {
    q: "Vous remplacez notre développeur ou prestataire informatique ?",
    a: "Pas nécessairement. J'interviens là où il y a un besoin pointu : concevoir un outil Windows qui n'existe pas dans le commerce, accélérer une application qui rame, automatiser des processus ou régler un problème système complexe. Vous décidez du périmètre.",
  },
  {
    q: "Vous développez avec quelles technologies ?",
    a: "Priorité absolue aux technologies natives et légères : C++20 et Win32 pour les outils nécessitant une vélocité maximale, Go pour les services autonomes et outils réseau, et scripts PowerShell pour l'automatisation système Windows. Zéro framework web lourd inutile sur les postes de travail.",
  },
  {
    q: "C'est confidentiel ? Vous voyez notre code ou nos systèmes.",
    a: "Oui, totalement. Les données et codes sources ne quittent jamais votre périmètre et rien n'est conservé après la mission. Un accord de confidentialité (NDA) peut être signé avant toute intervention.",
  },
  {
    q: "Faites-vous de l'infogérance ou de la maintenance sous contrat d'astreinte ?",
    a: "Non. Je travaille par missions bien définies : un diagnostic, un développement, une configuration système, puis une livraison documentée. Vous n'êtes pas captif d'un contrat mensuel récurrent, et votre équipe garde la maîtrise de ses postes.",
  },
  {
    q: "Que se passe-t-il si vous n'êtes pas disponible ?",
    a: "C'est la vraie limite d'un freelance et je l'assume en toute transparence : tout ce que je livre est documenté, le code source vous appartient, et aucun fonctionnement ne repose sur une recette cachée dans ma tête. N'importe quel développeur ou administrateur peut reprendre le travail.",
  },
  {
    q: "Pourquoi aucun tarif n'est affiché ?",
    a: "Parce qu'un forfait annoncé sans avoir vu le problème est soit trop cher pour vous, soit intenable pour moi. Un premier échange d'une demi-heure permet de cerner le besoin et de vous fournir un ordre de grandeur ferme, avant tout engagement.",
  },
];
---
<Base
  title="Développement Windows sur mesure & Administration système pour PME | E-Informatique"
  description="Développement de logiciels Windows natifs, diagnostic de performance et administration système pour les PME. Basé à Rivesaltes, interventions sur site ou à distance."
>
  <PageHead
    kicker="Ingénierie logicielle & Systèmes Windows · PME"
    motcle
    title="Des logiciels Windows qui vont vite, et des systèmes fiables."
    lede="Vous avez besoin d'outils sur mesure qui ne ralentissent pas vos équipes, d'accélérer un logiciel existant ou de fiabiliser votre environnement Windows. Je travaille par missions claires, avec des résultats mesurés."
  >
    <div class="flex flex-wrap items-center gap-3">
      <a class="btn btn--cta" href="/contact/">Me contacter <ArrowRight class="arrow" size="1.05em" aria-hidden="true" /></a>
      <a class="btn btn--ghost" href="#formules">Voir les formules</a>
    </div>
    <p class="mt-4 text-[0.9rem] text-ink-soft">Premier échange gratuit et sans engagement.</p>
  </PageHead>

  <!-- ─── Relevé type : terminal + lecture ─────────────── -->
  <section class="section section-rule">
    <div class="shell">
      <SectionHead
        title="Ce que je trouve en arrivant"
        lede="Un logiciel qui met plusieurs secondes à démarrer, consomme des centaines de mégaoctets de RAM pour des tâches simples, et des postes de travail ralentis par des services mal configurés."
      />
      <div class="mt-12 grid grid-cols-1 items-center gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)]">
        <div class="panel on-nuit border-transparent bg-nuit p-[clamp(0.75rem,2vw,1.5rem)]">
          <Terminal
            title="diagnostic : inspection système et process Windows"
            prompt=">"
            lines={[
              { k: 'cmd', t: 'proc-check.exe --analyze --target MetierApp' },
              { k: 'warn', t: '[MetierApp] Démarrage mesuré : 4.8 s (UI bloquée sur le thread principal)' },
              { k: 'warn', t: '[MetierApp] Mémoire résidente : 380 Mo (runtime web encapsulé)' },
              { k: 'ok', t: 'Profilage : 82% du temps passé en allocations mémoire inutiles' },
              { k: 'ok', t: 'Solution native : réécriture ciblée du module de calcul' },
              { k: 'out', t: 'Résultat après patch : ouverture < 80 ms, RAM < 12 Mo' },
            ]}
          />
        </div>

        <div class="flex flex-col items-start gap-4 text-base text-ink-soft">
          <p>
            Ces lenteurs et frictions au quotidien ne sont pas une fatalité liée à Windows. Elles viennent presque toujours de couches d'abstractions superflues empilées au fil des années.
          </p>
          <p>
            Le diagnostic permet de cibler exactement où le temps et la mémoire sont perdus, pour accélérer vos outils ou concevoir des alternatives légères et directes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Formules : trois panneaux, le troisième en avant ─ -->
  <section class="section section-rule section-tint" id="formules">
    <div class="shell">
      <SectionHead
        title="Trois façons de travailler ensemble"
        lede="Du diagnostic ponctuel au développement complet de vos utilitaires Windows sur mesure."
      />

      <ul class="m-0 mt-12 grid list-none grid-cols-1 gap-5 p-0 lg:grid-cols-3">
        {formules.map((f) => (
          <li
            class:list={[
              'panel flex flex-col gap-5 p-[clamp(1.5rem,2.5vw,2.1rem)]',
              f.bridge && 'on-nuit border-transparent bg-nuit text-ink',
            ]}
            data-reveal
            data-spotlight
          >
            <div>
              <h3 class="text-[1.35rem] tracking-[-0.028em]">{f.t}</h3>
              <p class="mt-2 text-base text-ink-soft">{f.q}</p>
            </div>

            <ul class="m-0 flex flex-1 list-none flex-col gap-3 border-t border-rule p-0 pt-5">
              {f.l.map((x) => (
                <li class="grid grid-cols-[1.25rem_1fr] gap-3 text-base/[1.5]">
                  <Check class="mt-[0.2rem] text-accent" size={17} stroke-width={2.2} aria-hidden="true" />
                  {x}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>

      <p class="mt-6 max-w-[62ch] text-base text-ink-soft">
        Aucune grille tarifaire arbitraire : le devis dépend de la complexité technique et du périmètre de la mission. Il est fixé par écrit avant démarrage, et ne bouge plus sans votre accord.
      </p>
    </div>
  </section>

  <!-- ─── Périmètre : deux prestations en panneaux + photo ─ -->
  <section class="section section-rule">
    <div class="shell">
      <SectionHead
        title="Deux piliers d'intervention"
        lede="Le diagnostic de performance logicielle d'un côté, le développement d'outils Windows et l'administration système de l'autre. Un périmètre technique maîtrisé de bout en bout."
      />
      <div class="mt-12 grid grid-cols-1 items-stretch gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,0.8fr)]">
        {pro.map((s) => (
          <article id={s.id} class="panel flex h-full scroll-mt-28 flex-col gap-4 p-[clamp(1.5rem,2.5vw,2.1rem)]" aria-labelledby={`${s.id}-t`} data-reveal>
            <h3 class="text-[1.35rem] tracking-[-0.03em]" id={`${s.id}-t`}>{s.titre}</h3>
            <p class="text-base text-ink-soft">{s.resume}</p>
            <ul class="m-0 mt-auto flex list-none flex-col gap-3 border-t border-rule p-0 pt-5">
              {s.livrables.map((l) => (
                <li class="grid grid-cols-[1.25rem_1fr] gap-3 text-[0.97rem]/[1.5]">
                  <Check class="mt-[0.2rem] text-accent" size={17} stroke-width={2.2} aria-hidden="true" />
                  {l}
                </li>
              ))}
            </ul>
          </article>
        ))}

        <figure class="m-0 h-full overflow-hidden rounded-[var(--radius-xl)]">
          <Image
            src={baie}
            alt="Baie de serveurs câblée, câbles réseau branchés sur un panneau de brassage numéroté"
            loading="lazy"
            decoding="async"
            widths={[420, 700, 1000]}
            sizes="(width >= 62rem) 28vw, 100vw"
            quality={68}
            class="size-full rounded-none object-cover contrast-105 saturate-70"
          />
        </figure>
      </div>
    </div>
  </section>

  <FaqSection title="Les questions fréquentes" items={faq} />

  <CtaBand
    title="Trente minutes pour faire le point sur vos outils."
    text="Un premier échange sans engagement : vos ralentissements, vos besoins logiciels ou vos questions système sous Windows. Vous repartez avec un avis technique clair et un ordre de grandeur."
  />
</Base>
