---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('labo');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });

const others = (await getCollection('labo'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Person', name: 'Elian', url: 'https://einformatique.fr/a-propos/' },
  keywords: post.data.tags.join(', '),
  publisher: { '@id': 'https://einformatique.fr/#business' },
};
---
<Base
  theme="nuit"
  track="labo"
  title={post.data.title}
  description={post.data.summary}
>
  <article class="art">
    <header class="art-h">
      <div class="shell art-hin">
        <a class="back mono" href="/labo/">← Labo</a>
        <div class="art-m">
          <time class="mono" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          {post.data.status !== 'publié' && <span class="st">{post.data.status}</span>}
          {post.data.readingTime && <span class="mono rt">{post.data.readingTime}</span>}
        </div>
        <h1>{post.data.title}</h1>
        <p class="art-s">{post.data.summary}</p>
        <div class="art-tg">
          {post.data.tags.map((t) => <span class="mono">{t}</span>)}
          {post.data.repo && <a class="mono repo" href={post.data.repo} rel="noopener" target="_blank">code ↗</a>}
        </div>
      </div>
    </header>

    <div class="shell art-body">
      {headings.filter((h) => h.depth === 2).length > 1 && (
        <nav class="toc" aria-label="Sommaire">
          <p class="label">Sommaire</p>
          <ol>
            {headings.filter((h) => h.depth === 2).map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}
      <div class="prose">
        <Content />
      </div>
    </div>

    <footer class="art-f">
      <div class="shell art-fin">
        <div class="af-cta">
          <p class="label">Une mission sur ce terrain</p>
          <p>
            Sécurité applicative, revue de code système, cryptographie appliquée : si le
            sujet correspond à ce que vous cherchez, écrivez avec le contexte technique.
          </p>
          <a class="btn btn--grenat" href="/contact/?profil=mission">Écrire <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        {others.length > 0 && (
          <div class="af-next">
            <p class="label">À lire ensuite</p>
            <ul>
              {others.map((o) => (
                <li><a href={`/labo/${o.id}/`}>{o.data.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </footer>
  </article>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</Base>

<style>
  .art-h { padding-block: clamp(2rem, 4vw, 3.5rem) clamp(2rem, 3.5vw, 3rem); border-bottom: 1px solid var(--rule); }
  .art-hin { max-width: 60rem; }
  .back { color: var(--ink-faint); text-decoration: none; font-size: 0.72rem; letter-spacing: 0.08em; }
  .back:hover { color: var(--grenat); }
  .art-m { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; margin-top: 1.75rem; }
  .art-m time, .rt { font-size: 0.68rem; color: var(--ink-faint); letter-spacing: 0.08em; text-transform: uppercase; }
  .st { font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; background: var(--or); color: oklch(0.198 0.022 40); padding: 0.1rem 0.45rem; font-weight: 600; }
  .art-h h1 { margin-top: 1rem; font-size: clamp(1.95rem, 1rem + 3.3vw, 3.25rem); max-width: 22ch; }
  .art-s { margin-top: 1.15rem; color: var(--ink-soft); max-width: 62ch; font-size: 1.05rem; line-height: 1.6; }
  .art-tg { margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .art-tg span, .repo { font-size: 0.65rem; color: var(--ink-faint); border: 1px solid var(--rule); padding: 0.15rem 0.5rem; }
  .repo { text-decoration: none; color: var(--grenat); border-color: var(--grenat); }

  .art-body {
    display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem);
    align-items: start; padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  @media (max-width: 62rem) { .art-body { grid-template-columns: 1fr; } }

  .toc { position: sticky; top: 7rem; border-top: 1px solid var(--rule-strong); padding-top: 0.9rem; }
  @media (max-width: 62rem) { .toc { position: static; } }
  .toc ol { list-style: none; padding: 0; margin: 0.8rem 0 0; display: flex; flex-direction: column; gap: 0.5rem; counter-reset: t; }
  .toc li { counter-increment: t; }
  .toc a { display: block; font-size: 0.82rem; color: var(--ink-soft); text-decoration: none; line-height: 1.35; }
  .toc a::before { content: counter(t, decimal-leading-zero) '  '; font-family: var(--mono); font-size: 0.66rem; color: var(--grenat); }
  .toc a:hover { color: var(--ink); }

  .art-f { border-top: 1px solid var(--rule); padding-block: clamp(2.5rem, 5vw, 4rem); background: var(--paper-warm); }
  .art-fin { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 2.5rem; align-items: start; }
  @media (max-width: 60rem) { .art-fin { grid-template-columns: 1fr; } }
  .af-cta p:not(.label) { margin: 0.8rem 0 1.5rem; color: var(--ink-soft); max-width: 48ch; font-size: 0.95rem; }
  .af-next ul { list-style: none; padding: 0; margin: 0.9rem 0 0; border-top: 1px solid var(--rule); }
  .af-next li { border-bottom: 1px solid var(--rule); }
  .af-next a { display: block; padding: 0.9rem 0; text-decoration: none; font-weight: 600; letter-spacing: -0.02em; }
  .af-next a:hover { color: var(--grenat); }
</style>
