---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('labo');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });
const sections = headings.filter((h) => h.depth === 2);

const others = (await getCollection('labo'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Person', name: 'Elian', url: 'https://einformatique.fr/a-propos/' },
  keywords: post.data.tags.join(', '),
  publisher: { '@id': 'https://einformatique.fr/#business' },
};

const meta = 'font-mono text-[0.68rem] uppercase tracking-[0.08em] text-ink-faint';
---
<Base
  theme="nuit"
  track="labo"
  title={post.data.title}
  description={post.data.summary}
>
  <article>
    <header class="border-b border-rule pt-[clamp(2rem,4vw,3.5rem)] pb-[clamp(2rem,3.5vw,3rem)]">
      <div class="shell max-w-[60rem]">
        <a class="font-mono text-[0.72rem] tracking-[0.08em] text-ink-faint no-underline hover:text-accent" href="/labo/">← Labo</a>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <time class={meta} datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          {post.data.status !== 'publié' && (
            <span class="rounded-md bg-state-warn px-[0.45rem] py-[0.1rem] font-mono text-[0.62rem] font-semibold uppercase tracking-[0.1em] text-fixed-nuit">
              {post.data.status}
            </span>
          )}
          {post.data.readingTime && <span class={meta}>{post.data.readingTime}</span>}
        </div>

        <h1 class="mt-4 max-w-[22ch] text-[clamp(1.95rem,1rem+3.3vw,3.25rem)]">{post.data.title}</h1>
        <p class="mt-[1.15rem] max-w-[62ch] text-[1.05rem]/[1.6] text-ink-soft">{post.data.summary}</p>

        <div class="mt-6 flex flex-wrap gap-[0.4rem]">
          {post.data.tags.map((t) => (
            <span class="rounded-md border border-rule px-2 py-[0.15rem] font-mono text-[0.65rem] text-ink-faint">{t}</span>
          ))}
          {post.data.repo && (
            <a
              class="rounded-md border border-accent px-2 py-[0.15rem] font-mono text-[0.65rem] text-accent no-underline"
              href={post.data.repo}
              rel="noopener"
              target="_blank"
            >code ↗</a>
          )}
        </div>
      </div>
    </header>

    <div class="shell grid grid-cols-1 items-start gap-[clamp(2rem,5vw,4rem)] py-[clamp(2.5rem,5vw,4rem)] lg:grid-cols-[13rem_minmax(0,1fr)]">
      {sections.length > 1 && (
        <nav class="border-t border-rule-strong pt-[0.9rem] lg:sticky lg:top-28" aria-label="Sommaire">
          <p class="label">Sommaire</p>
          <ol class="m-0 mt-[0.8rem] flex list-none flex-col gap-2 p-0">
            {sections.map((h, i) => (
              <li>
                <a class="block text-[0.82rem]/[1.35] text-ink-soft no-underline hover:text-ink" href={`#${h.slug}`}>
                  <span class="mr-2 font-mono text-[0.66rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      <div class="prose">
        <Content />
      </div>
    </div>

    <footer class="border-t border-rule bg-paper-warm py-[clamp(2.5rem,5vw,4rem)]">
      <div class="shell grid grid-cols-1 items-start gap-10 mid:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
        <div>
          <p class="label">Une mission sur ce terrain</p>
          <p class="mt-[0.8rem] mb-6 max-w-[48ch] text-[0.95rem] text-ink-soft">
            Sécurité applicative, revue de code système, cryptographie appliquée : si le
            sujet correspond à ce que vous cherchez, écrivez avec le contexte technique.
          </p>
          <a class="btn btn--cta" href="/contact/?profil=mission">Écrire <span class="arrow" aria-hidden="true">→</span></a>
        </div>

        {others.length > 0 && (
          <div>
            <p class="label">À lire ensuite</p>
            <ul class="m-0 mt-[0.9rem] list-none border-t border-rule p-0">
              {others.map((o) => (
                <li class="border-b border-rule">
                  <a class="block py-[0.9rem] font-semibold tracking-[-0.02em] no-underline hover:text-accent" href={`/labo/${o.id}/`}>{o.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </footer>
  </article>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</Base>
