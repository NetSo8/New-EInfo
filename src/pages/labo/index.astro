---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('labo')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

const puce = 'border border-rule px-2 py-[0.15rem] font-mono text-[0.66rem] text-ink-faint';
---
<Base
  theme="nuit"
  track="labo"
  title="Labo · notes techniques et cryptographie appliquée"
  description="Writeups : durcissement Linux, canaux auxiliaires temporels, confidential computing, attestation AWS Nitro Enclaves. Notes écrites pour des pairs."
>
  <PageHead
    kicker="Labo · registre technique"
    title="Notes de travail, pas de plaquette"
    lede="Ce qui est écrit ici s'adresse à des pairs. Aucune conclusion n'est avancée avant d'être reproductible, et les travaux inachevés sont annoncés comme tels."
  >
    {tags.length > 0 && (
      <ul class="m-0 flex list-none flex-wrap gap-[0.4rem] p-0">
        {tags.map((t) => <li class={puce}>{t}</li>)}
      </ul>
    )}
  </PageHead>

  <section class="py-band">
    <div class="shell">
      {posts.length === 0 ? (
        <p class="max-w-[54ch] border-y border-rule py-12 text-ink-soft">
          Rien de publié pour l'instant. Les notes arrivent quand le banc de test tient
          debout, pas avant.
        </p>
      ) : (
        <ol class="m-0 list-none border-t border-rule-strong p-0">
          {posts.map((p, i) => (
            <li class="border-b border-rule">
              <a
                href={`/labo/${p.id}/`}
                class="group grid grid-cols-[3rem_minmax(0,1fr)_1.5rem] items-start gap-5 py-8 text-inherit no-underline transition-[background-color,padding-inline] duration-200 ease-out-soft hover:bg-accent-wash hover:px-4"
              >
                <span class="pt-[0.4rem] font-mono text-[0.75rem] font-semibold text-accent">
                  {String(posts.length - i).padStart(2, '0')}
                </span>

                <span class="flex flex-col gap-2">
                  <span class="flex flex-wrap items-center gap-3">
                    <time class="font-mono text-[0.68rem] uppercase tracking-[0.06em] text-ink-faint" datetime={p.data.date.toISOString()}>
                      {fmt(p.data.date)}
                    </time>
                    {p.data.status !== 'publié' && (
                      <span class="rounded-md bg-state-warn px-[0.45rem] py-[0.1rem] font-mono text-[0.62rem] font-semibold uppercase tracking-[0.1em] text-fixed-nuit">
                        {p.data.status}
                      </span>
                    )}
                    {p.data.readingTime && (
                      <span class="font-mono text-[0.68rem] uppercase tracking-[0.06em] text-ink-faint">{p.data.readingTime}</span>
                    )}
                  </span>

                  <span class="max-w-[26ch] text-[clamp(1.25rem,1.05rem+0.95vw,1.85rem)]/[1.15] font-bold tracking-[-0.032em]">{p.data.title}</span>
                  <span class="max-w-[66ch] text-[0.95rem] text-ink-soft">{p.data.summary}</span>

                  <span class="mt-[0.2rem] flex flex-wrap gap-[0.4rem]">
                    {p.data.tags.map((t) => (
                      <span class="rounded-md border border-rule px-[0.45rem] py-[0.1rem] font-mono text-[0.63rem] text-ink-faint">{t}</span>
                    ))}
                  </span>
                </span>

                <span
                  class="justify-self-end pt-[0.4rem] text-accent transition-transform duration-200 ease-out-soft group-hover:translate-x-1"
                  aria-hidden="true"
                >→</span>
              </a>
            </li>
          ))}
        </ol>
      )}

      <div class="mt-16 flex max-w-[54ch] flex-col gap-[0.8rem] border-t border-rule pt-5">
        <p class="label">Pourquoi ces pages sont sombres</p>
        <p class="text-[0.9rem] text-ink-soft">
          Parce qu'elles ne sont pas écrites pour convertir. Le reste du site s'adresse à
          quelqu'un qui a un problème à régler. Ici, on lit du code à 23 h.
        </p>
        <p class="text-[0.9rem] text-ink-soft">
          Une mission technique à discuter&nbsp;?
          <a class="tlink" href="/contact/?profil=mission">Écrivez-moi directement</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
