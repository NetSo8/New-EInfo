---
import Base from '../layouts/Base.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Plus from '@lucide/astro/icons/plus';
import SectionHead from '../components/SectionHead.astro';
import Receipt from '@lucide/astro/icons/receipt';
import MessageCircle from '@lucide/astro/icons/message-circle';
import FileText from '@lucide/astro/icons/file-text';
import Compass from '@lucide/astro/icons/compass';
import HeroNetworkBg from '../components/HeroNetworkBg.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqSection from '../components/FaqSection.astro';
import { Image } from 'astro:assets';
import { services, lienService } from '../data/services';
import atelier from '../assets/atelier.jpg';
import cote from '../assets/cote.jpg';
import etabli from '../assets/etabli.jpg';
import paysage from '../assets/paysage.jpg';
import baie from '../assets/baie.jpg';

/* Mise en scène des quatre prestations dans la grille : deux tuiles
   larges portées par une photo, deux tuiles étroites sur surface pleine.
   L'ordre suit `services`, la disposition est décidée ici. */
const tuiles: Record<string, { span: string; tone: 'photo' | 'sand' | 'raised' | 'nuit'; img?: ImageMetadata }> = {
  depannage: { span: 'lg:col-span-2', tone: 'photo', img: atelier },
  'formation-ia': { span: '', tone: 'sand' },
  web: { span: '', tone: 'raised' },
  'revue-ia': { span: 'lg:col-span-2', tone: 'nuit', img: paysage },
};

const faq = [
  {
    q: "Pourquoi ne pas utiliser les technologies web habituelles pour un logiciel de bureau ?",
    a: "Beaucoup de logiciels actuels embarquent un navigateur complet : ils consomment 150 à 350 Mo de mémoire et mettent plusieurs secondes à s'ouvrir. Un logiciel écrit directement pour Windows s'ouvre instantanément et tient dans moins de 8 Mo. Sur les postes de vos équipes, cela se voit tous les jours.",
  },
  {
    q: "Mon logiciel est lent : pouvez-vous l'accélérer sans tout refaire ?",
    a: "Souvent, oui. Je commence par mesurer où le temps est perdu, puis je corrige uniquement les parties qui posent problème. Vous recevez un rapport chiffré, avec les gains attendus avant que vous ne décidiez de quoi que ce soit.",
  },
  {
    q: "Qu'est-ce que je reçois à la fin d'une mission ?",
    a: "Un logiciel ou un correctif qui fonctionne, le code source, une documentation écrite et les mesures avant/après. Rien ne reste dans ma tête : un autre développeur peut reprendre le travail sans repartir de zéro.",
  },
  {
    q: "Mes données restent-elles chez moi ?",
    a: "Oui. Les outils fonctionnent entièrement en local : pas de compte à créer, pas de serveur distant, pas de collecte de données, pas d'installation intrusive. Ils se lancent et se suppriment comme un simple fichier.",
  },
];


const engagements = [
  { icon: Receipt, t: 'Rapide dès le premier clic', d: "Le logiciel s'ouvre immédiatement et reste fluide, même sur un poste ancien. Chaque gain est mesuré, pas promis." },
  { icon: MessageCircle, t: 'Léger et sans dépendance', d: "Un seul fichier à déployer, rien d'autre à installer. Moins de pannes, moins de mises à jour à gérer pour vous." },
  { icon: FileText, t: 'Documenté et repris facilement', d: "Code source, notes et mesures vous sont remis. Vous ne dépendez pas de moi pour la suite." },
  { icon: Compass, t: 'Vos données restent chez vous', d: "Tout tourne en local. Aucune donnée envoyée à l'extérieur, aucun abonnement imposé." },
];

const pannesCourantes = [
  "S'ouvre instantanément, sans écran de chargement",
  'Tient dans moins de 8 Mo de mémoire',
  'Retrouve un fichier en une fraction de seconde',
  'Un seul fichier à copier, rien à installer',
  "Aucune donnée envoyée sur internet",
];

const besoinsEntreprises = [
  'Un logiciel métier lent, qui fait attendre vos équipes',
  "Un traitement qui plante ou ralentit quand il y a beaucoup de données",
  'Un ancien outil à reprendre pour le rendre rapide et fiable',
  'Un petit service qui tourne en arrière-plan sans ralentir les postes',
  "Administration ou automatisation système Windows pour fiabiliser vos outils",
];
---
<Base
  title="Logiciels Windows rapides et sur mesure pour les PME"
  description="Logiciels Windows rapides, légers et sur mesure pour les PME : outils locaux, accélération de logiciels existants, développement natif. Ingénieur à Rivesaltes (66)."
>
  <!-- ─── HERO ─────────────────────────────────────────── -->
  <section class="relative isolate overflow-hidden pt-[clamp(2rem,4.5vw,4.5rem)] pb-[clamp(3.5rem,6vw,6rem)]">
    <HeroNetworkBg class="-z-10 opacity-45" />
    <div class="shell grid items-center gap-x-14 gap-y-12 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)]">
      <div>
        {/* L'étiquette fait partie du titre principal : c'est elle qui dit à
            Google de quoi parle la page, l'accroche porte le ton. */}
        <h1>
          <span class="chip rise text-[0.8rem] font-medium tracking-normal" style="--i:0"><span class="chip__mark" aria-hidden="true">66</span>Logiciels Windows sur mesure, Rivesaltes<span class="sr-only"> :</span></span>
          <span class="rise mt-7 block text-[clamp(2.4rem,1.2rem+3.6vw,4.15rem)]/[1.02] tracking-[-0.045em]" style="--i:1">
            Des logiciels Windows rapides.<br /><span class="text-accent">Légers, sur mesure, fiables.</span>
          </span>
        </h1>

        <p class="rise mt-6 max-w-[42ch] text-lede/[1.5] text-ink-soft" style="--i:2">
          Outils pour utilisateurs exigeants, accélération de vos logiciels
          et développement sur mesure pour les PME.
        </p>

        <div class="rise mt-9 flex flex-wrap items-center gap-3" style="--i:3">
          <a class="btn btn--cta" href="/contact/">Me contacter <ArrowRight class="arrow" size="1.05em" aria-hidden="true" /></a>
          <a class="btn btn--ghost" href="#services">Voir les domaines</a>
        </div>
      </div>

      <figure class="unveil relative m-0 overflow-hidden rounded-[var(--radius-xl)] shadow-[var(--shadow-raise-hi)]">
        <Image
          src={etabli}
          alt="Carte électronique sur un établi, outils de précision"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          widths={[560, 840, 1120, 1400]}
          sizes="(width >= 62rem) 44vw, 100vw"
          quality={72}
          data-parallax="14"
          class="aspect-[4/3] w-full rounded-none object-cover object-[72%_50%] lg:aspect-[4/5]"
        />
      </figure>
    </div>
  </section>

  <!-- ─── DOUBLE AIGUILLAGE ────────────────────────────── -->
  <section class="pb-[clamp(3.5rem,6vw,6rem)]" aria-label="Choisir votre parcours">
    <div class="shell grid grid-cols-1 gap-5 lg:grid-cols-2">
      <div class="panel flex flex-col gap-[1.1rem] border-transparent bg-sand px-[clamp(1.4rem,3.5vw,3rem)] pt-[clamp(1.8rem,3.5vw,3rem)] pb-[clamp(2rem,3.5vw,3rem)]" data-reveal>
        {/* Photo d'ambiance en fond, volontairement très effacée. */}
        <Image
          src={atelier}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          widths={[480, 800, 1200]}
          sizes="(width >= 62rem) 45vw, 100vw"
          quality={35}
          class="absolute inset-0 -z-10 size-full object-cover opacity-[0.07] grayscale contrast-125"
        />
        <span class="badge badge--accent self-start" aria-hidden="true">Power-users</span>
        {/* L'étiquette visible est rattachée au titre pour qui navigue de titre en titre. */}
        <h2 class="text-[clamp(1.6rem,1.15rem+1.6vw,2.35rem)]/[1.08] tracking-[-0.035em]"><span class="sr-only">Vous êtes un power-user : </span>Des outils Windows instantanés, sans superflu.</h2>

        <ul class="m-0 flex list-none flex-col p-0">
          {pannesCourantes.map((p) => (
            <li class="relative border-b border-rule py-[0.6rem] pl-6 text-base last:border-b-0">
              <Plus class="absolute top-[0.95rem] left-0 text-accent" size="0.85em" aria-hidden="true" />
              {p}
            </li>
          ))}
        </ul>

        <p class="max-w-[42ch] text-base text-ink-soft">
          Des outils qui font une chose, et la font vite : ouverture immédiate,
          très peu de mémoire, aucune installation lourde.
        </p>
        <a class="btn btn--cta mt-auto self-start" href="/particuliers/">
          Voir l'offre power-users <ArrowRight class="arrow" size="1.05em" aria-hidden="true" />
        </a>
      </div>

      <div class="panel on-nuit flex flex-col gap-[1.1rem] border-transparent bg-nuit px-[clamp(1.4rem,3.5vw,3rem)] pt-[clamp(1.8rem,3.5vw,3rem)] pb-[clamp(2rem,3.5vw,3rem)]" data-reveal>
        <Image
          src={baie}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          widths={[480, 800, 1200]}
          sizes="(width >= 62rem) 45vw, 100vw"
          quality={35}
          class="absolute inset-0 -z-10 size-full object-cover opacity-[0.06] grayscale contrast-125"
        />
        <span class="badge badge--accent self-start" aria-hidden="true">Entreprise</span>
        <h2 class="text-[clamp(1.6rem,1.15rem+1.6vw,2.35rem)]/[1.08] tracking-[-0.035em]"><span class="sr-only">Vous êtes une entreprise : </span>Votre logiciel fait attendre vos équipes.</h2>

        <ul class="m-0 flex list-none flex-col p-0">
          {besoinsEntreprises.map((b) => (
            <li class="relative border-b border-rule py-[0.6rem] pl-6 text-base last:border-b-0">
              <Plus class="absolute top-[0.95rem] left-0 text-accent" size="0.85em" aria-hidden="true" />
              {b}
            </li>
          ))}
        </ul>

        <p class="max-w-[42ch] text-base text-ink-soft">
          Diagnostic, accélération, développement sur mesure.
          Des mesures avant et après, un rapport clair, un devis annoncé.
        </p>
        <a class="btn btn--cta mt-auto self-start" href="/professionnels/">
          Voir l'offre entreprises <ArrowRight class="arrow" size="1.05em" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- ─── SERVICES : grille à quatre tuiles ────────────── -->
  <section class="section section-rule" id="services">
    <div class="shell">
      <SectionHead
        title="Quatre services, deux publics"
        lede="Outils et optimisation pour les utilisateurs exigeants, diagnostic et développement sur mesure pour les PME. Je ne promets que ce que je peux mesurer."
      />

      <ul class="m-0 mt-12 grid list-none grid-cols-1 gap-5 p-0 lg:grid-cols-3">
        {services.map((s) => {
          const t = tuiles[s.id];
          const sombre = t.tone === 'photo' || t.tone === 'nuit';
          return (
            <li class:list={[t.span]} data-reveal>
              <a
                href={lienService(s)}
                data-spotlight
                aria-labelledby={`tuile-${s.id}`}
                aria-describedby={`tuile-${s.id}-d`}
                class:list={[
                  'panel panel-link h-full min-h-[19rem] flex-col justify-end gap-3 p-[clamp(1.4rem,2.5vw,2.1rem)]',
                  sombre && 'on-nuit border-transparent bg-nuit text-ink',
                  t.tone === 'sand' && 'border-transparent bg-sand',
                ]}
              >
                {t.img && (
                  <>
                    <Image
                      src={t.img}
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      decoding="async"
                      widths={[480, 800, 1200]}
                      sizes="(width >= 80rem) 52rem, (width >= 62rem) 64vw, 100vw"
                      quality={50}
                      class:list={['panel-media absolute inset-0 -z-20 size-full object-cover', t.tone === 'nuit' ? 'opacity-45' : 'opacity-70']}
                    />
                    {/* Voile : garantit le contraste du texte posé sur la photo. */}
                    <span class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,var(--color-nuit)_18%,color-mix(in_oklch,var(--color-nuit)_55%,transparent)_60%,color-mix(in_oklch,var(--color-nuit)_15%,transparent))]" aria-hidden="true"></span>
                  </>
                )}
                <span class="flex flex-wrap gap-[0.35rem]" aria-hidden="true">
                  {s.pour.includes('particulier') && <span class="badge">Power-users</span>}
                  {s.pour.includes('entreprise') && <span class="badge">Entreprises</span>}
                </span>
                <span class="flex items-end justify-between gap-6">
                  <span class="flex flex-col gap-2">
                    <h3 class="text-[clamp(1.3rem,1.05rem+0.9vw,1.85rem)]/[1.1] tracking-[-0.03em]" id={`tuile-${s.id}`}>{s.titre}</h3>
                    <span class="max-w-[48ch] text-[0.97rem]/[1.55] text-ink-soft" id={`tuile-${s.id}-d`}>
                      {s.probleme}
                      <span class="sr-only">Pour les {s.pour.map((x) => (x === 'particulier' ? 'power-users' : 'entreprises')).join(' et les ')}.</span>
                    </span>
                  </span>
                  <span class="grid size-10 flex-none place-items-center rounded-full border border-rule text-accent" aria-hidden="true">
                    <ArrowRight class="arrow" size="1.05em" />
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ─── ENGAGEMENTS ──────────────────────────────────── -->
  <section class="section section-rule section-tint">
    <div class="shell">
      <SectionHead
        title="Quatre engagements, quel que soit le projet"
        lede="Un petit outil ou un logiciel d'entreprise : la façon de travailler ne change pas."
      />
      <ul class="trace-line m-0 mt-14 grid list-none grid-cols-1 gap-y-10 p-0 sm:grid-cols-2 lg:grid-cols-4" data-inview>
        {engagements.map((e, i) => (
          <li
            class:list={[
              'flex flex-col gap-3 pt-8 sm:pr-8',
              i > 0 && 'lg:border-l lg:border-rule lg:pl-8',
              i % 2 === 1 && 'sm:max-lg:border-l sm:max-lg:border-rule sm:max-lg:pl-8',
            ]}
            data-reveal
          >
            <span class="pop-icon grid size-11 place-items-center rounded-full bg-raised text-accent shadow-[var(--shadow-raise)]" style={`--i:${i}`} aria-hidden="true">
              <e.icon size={20} stroke-width={1.8} />
            </span>
            <h3 class="mt-2 text-[1.25rem]/[1.2] tracking-[-0.028em]">{e.t}</h3>
            <p class="text-base text-ink-soft">{e.d}</p>
          </li>
        ))}
      </ul>
      <a class="tlink mt-12 inline-block" href="/a-propos/">Comment je travaille</a>
    </div>
  </section>

  <!-- ─── COMPARATIF : ce que ça change ─────────────────── -->
  <section class="section section-rule">
    <div class="shell">
      <SectionHead
        title="Concrètement, ce que ça change"
        lede="Un logiciel écrit directement pour Windows, comparé à un logiciel classique qui embarque un navigateur. Valeurs typiques mesurées sur un poste de bureau courant."
      />
      <div class="mt-12 grid grid-cols-1 items-stretch gap-5 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
        <div class="panel flex flex-col justify-center p-[clamp(1.4rem,3vw,2.5rem)]" data-reveal>
          <div class="grid grid-cols-[1.2fr_1fr_1fr] gap-x-4 border-b border-rule pb-3 font-mono text-[0.75rem] text-ink-soft">
            <span></span><span>Logiciel classique</span><span class="text-accent">Logiciel sur mesure</span>
          </div>
          {[
            ['Temps d\'ouverture', '1 à 2 secondes', 'instantané'],
            ['Mémoire utilisée', '150 à 350 Mo', 'moins de 8 Mo'],
            ['Poids du logiciel', '140 à 240 Mo', 'moins de 2 Mo'],
            ['À installer', 'programme + composants', 'un seul fichier'],
            ['Données envoyées dehors', 'souvent', 'aucune'],
          ].map(([k, a, b]) => (
            <div class="grid grid-cols-[1.2fr_1fr_1fr] gap-x-4 border-b border-rule py-3 text-[0.95rem] last:border-b-0">
              <span class="text-ink-soft">{k}</span><span>{a}</span><span class="font-semibold">{b}</span>
            </div>
          ))}
        </div>
        <figure class="m-0 overflow-hidden rounded-[var(--radius-xl)]" data-reveal>
          <Image
            src={cote}
            alt="Mains sur le clavier d'un ordinateur portable pendant une session de travail"
            loading="lazy" decoding="async"
            widths={[480, 768, 1100]}
            sizes="(width >= 62rem) 40vw, 100vw"
            quality={68}
            class="aspect-video size-full rounded-none object-cover saturate-[0.82] lg:aspect-auto"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ─── FAQ ──────────────────────────────────────────── -->
  <FaqSection title="Ce qu'on me demande avant de commencer" items={faq} />

  <CtaBand
    title="Un logiciel lent ou un outil à créer ?"
    text="Quelques lignes suffisent : ce qui ralentit, sur quels postes, depuis quand. Je réponds avec un plan clair et un ordre de prix, avant tout engagement."
  />
</Base>
