---
import Base from '../layouts/Base.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Plus from '@lucide/astro/icons/plus';
import SectionHead from '../components/SectionHead.astro';
import Terminal from '../components/Terminal.astro';
import ChainDiagram from '../components/ChainDiagram.astro';
import ZoneRadar from '../components/ZoneRadar.astro';
import HeroNetworkBg from '../components/HeroNetworkBg.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { Image } from 'astro:assets';
import { services } from '../data/services';
import atelier from '../assets/atelier.jpg';
import cote from '../assets/cote.jpg';

const faq = [
  {
    q: "Vous vous déplacez jusqu'où ?",
    a: "Je me déplace sans supplément dans un rayon de 15 km autour de Rivesaltes, ce qui couvre Perpignan et les communes proches. Au-delà, un forfait kilométrique est annoncé avant l'intervention. Le reste de la France est couvert à distance.",
  },
  {
    q: "Combien ça coûte ?",
    a: "Le diagnostic est annoncé et chiffré avant que je touche à la machine. Pour les particuliers, l'intervention se facture à l'heure, sans frais de dossier. Pour les entreprises, un audit ou un forfait mensuel est proposé après un premier échange gratuit d'une trentaine de minutes.",
  },
  {
    q: "Je n'y connais rien du tout, c'est un problème ?",
    a: "Non, c'est même le cas le plus fréquent. Je vous explique ce qui s'est passé en français, je vous montre ce que j'ai changé, et vous repartez avec les quelques réflexes qui évitent que ça recommence.",
  },
  {
    q: "Vous travaillez avec quels systèmes ?",
    a: "Windows, macOS et Linux côté poste de travail. Debian et Ubuntu côté serveur. Pour les logiciels métiers, je m'adapte : j'ai déjà repris des environnements dont l'éditeur avait disparu.",
  },
];

const faits = [
  { v: '15 km', d: 'Déplacement inclus depuis Rivesaltes' },
  { v: '1', d: 'Interlocuteur, du poste au réseau' },
];

const pannesCourantes = [
  "Il rame, il chauffe, il s'éteint tout seul",
  'Écran noir, plus de démarrage',
  'Boîte mail piratée, fenêtres suspectes',
  'Photos et documents à récupérer',
  'Imprimante, box, wifi qui ne suivent plus',
];
---
<Base
  title="Dépannage informatique Rivesaltes et Perpignan (66)"
  description="Technicien réseau et sécurité à Rivesaltes (66). Dépannage informatique pour les particuliers ; réseau local, VLAN, pare-feu, VPN, sauvegardes et sites web pour les TPE des Pyrénées-Orientales."
>
  <!-- ─── HERO ─────────────────────────────────────────── -->
  <section class="relative isolate overflow-hidden pt-[clamp(3rem,6vw,6rem)] pb-[clamp(3.5rem,7vw,7.5rem)]">
    <HeroNetworkBg class="-z-10 opacity-70" />
    <div class="shell relative">
      <div class="max-w-[38rem]">
        <p class="label flex items-center gap-[0.55rem] text-ink-soft">
          <span class="size-[7px] flex-none rounded-full bg-accent" aria-hidden="true"></span>
          Technicien réseau et sécurité · Rivesaltes · Pyrénées-Orientales
        </p>

        <h1 class="mt-5 text-[clamp(2.35rem,1rem+4.1vw,4rem)]/[0.98]">
          Une&nbsp;panne.<br />Un&nbsp;réseau.<br />Un&nbsp;site.<br /><span class="text-accent">Un seul numéro.</span>
        </h1>

        <p class="mt-6 max-w-[44ch] text-lede/[1.5] text-ink-soft">
          Je dépanne les particuliers du Roussillon, et je tiens le réseau et la
          sécurité des entreprises qui n'ont pas de service technique. Un périmètre
          court, assumé, travaillé en profondeur plutôt qu'étalé sur dix lignes.
        </p>

        <ul class="m-0 mt-9 flex list-none flex-wrap border-t border-rule p-0">
          {faits.map((f) => (
            <li class="mr-6 flex flex-col gap-[0.1rem] pt-[0.9rem] pr-6 not-first:border-l not-first:border-rule not-first:pl-6">
              <strong class="text-2xl/none font-bold tracking-[-0.04em]">{f.v}</strong>
              <span class="max-w-[15ch] text-[0.75rem]/[1.35] text-ink-soft">{f.d}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ─── DOUBLE AIGUILLAGE ────────────────────────────── -->
  <section class="grid grid-cols-1 border-t border-rule lg:grid-cols-2" aria-label="Choisir votre parcours">
    <div class="relative overflow-hidden bg-sand px-[clamp(1.25rem,3.5vw,3.25rem)] pt-[clamp(2rem,4vw,3.5rem)] pb-[clamp(2.5rem,4vw,3.75rem)]">
      {/* Photo d'ambiance en fond, volontairement très effacée. */}
      <Image
        src={atelier}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        widths={[640, 960, 1280]}
        sizes="(width >= 62rem) 50vw, 100vw"
        quality={45}
        class="absolute inset-0 size-full object-cover opacity-10 grayscale contrast-125"
      />
      <div class="relative mx-auto flex max-w-[34rem] flex-col gap-[1.1rem]">
        <p class="label text-accent">01 / Vous êtes un particulier</p>
        <h2 class="text-[clamp(1.65rem,1.15rem+1.8vw,2.5rem)] tracking-[-0.035em]">Mon ordinateur ne va pas.</h2>

        <ul class="m-0 flex list-none flex-col p-0">
          {pannesCourantes.map((p) => (
            <li class="relative border-b border-rule py-[0.6rem] pl-6 text-base">
              <Plus class="absolute top-[0.95rem] left-0 text-accent" size="0.85em" aria-hidden="true" />
              {p}
            </li>
          ))}
        </ul>

        <p class="max-w-[42ch] text-base text-ink-soft">
          Vous savez ce que ça coûte avant que je touche à la machine. Si la réparation
          ne vaut pas le coup, je vous le dis.
        </p>
        <a class="btn btn--cta mt-[0.4rem] self-start" href="/particuliers/">
          Décrire mon problème <ArrowRight class="arrow" size="1.05em" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="on-nuit bg-nuit px-[clamp(1.25rem,3.5vw,3.25rem)] pt-[clamp(2rem,4vw,3.5rem)] pb-[clamp(2.5rem,4vw,3.75rem)]">
      <div class="mx-auto flex max-w-[34rem] flex-col gap-[1.1rem]">
        <p class="label text-accent">02 / Vous êtes une entreprise</p>
        <h2 class="text-[clamp(1.65rem,1.15rem+1.8vw,2.5rem)] tracking-[-0.035em]">Mon réseau tient mon activité.</h2>

        <Terminal
          title="scan : réseau client, 12 postes"
          lines={[
            { k: 'cmd', t: 'nmap -sV --top-ports 1000 192.168.1.0/24' },
            { k: 'ok', t: '192.168.1.1    passerelle · firmware à jour' },
            { k: 'warn', t: '192.168.1.14   3389/tcp rdp · publié sur l\'IP publique' },
            { k: 'warn', t: '192.168.1.22   445/tcp smb · SMBv1 encore actif' },
            { k: 'warn', t: 'wifi-invites   même VLAN que les caisses' },
            { k: 'out', t: 'hôtes actifs   17 · 12 postes, 3 adresses inconnues' },
            { k: 'dim', t: 'rapport lisible, priorisé, sans jargon' },
          ]}
        />

        <p class="max-w-[42ch] text-base text-ink-soft">
          Un audit du réseau et des accès, puis une seule personne pour le tenir dans la
          durée. Pas d'allers-retours entre trois prestataires qui se renvoient la
          panne.
        </p>
        <a class="btn btn--cta mt-[0.4rem] self-start" href="/professionnels/">
          Demander un diagnostic <ArrowRight class="arrow" size="1.05em" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- ─── § 01 SERVICES ────────────────────────────────── -->
  <section class="section section-rule" id="services">
    <div class="shell">
      <SectionHead
        n="01"
        kicker="Ce que je couvre"
        title="Trois prestations, une seule chaîne technique"
        lede="Une liste courte, et c'est le but : le réseau et sa sécurité sont ma spécialité, le dépannage est le métier dont je viens, le site web le prolongement des deux."
      />

      <ol class="rowlist mt-12" data-reveal>
        {services.map((s) => (
          <li>
            <a
              href={`/services/#${s.id}`}
              class="grid grid-cols-[2.5rem_1fr_1.25rem] items-baseline gap-4 py-[1.4rem] hover:px-[0.9rem] mid:grid-cols-[3rem_minmax(0,1fr)_12rem_1.5rem]"
            >
              <span class="font-mono text-[0.75rem] font-semibold text-accent">{s.n}</span>

              <span class="flex flex-col gap-1">
                <span class="text-[clamp(1.2rem,1.05rem+0.7vw,1.65rem)]/[1.15] font-bold tracking-[-0.03em]">{s.titre}</span>
                <span class="max-w-[52ch] text-base text-ink-soft">{s.probleme}</span>
              </span>

              <span class="col-start-2 flex flex-wrap items-center gap-[0.35rem] mid:col-start-3">
                {s.pour.includes('particulier') && <span class="badge">Particuliers</span>}
                {s.pour.includes('entreprise') && <span class="badge">Entreprises</span>}
              </span>

              <ArrowRight class="arrow justify-self-end text-accent" size="1.1em" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── § 02 L'ARGUMENT ──────────────────────────────── -->
  <section class="section section-rule section-tint">
    <div class="shell">
      <SectionHead
        n="02"
        kicker="L'avantage du freelance"
        title="La panne est rarement là où on la cherche"
      />
      <div class="grid12 mt-12 gap-y-10">
        <div class="col-span-full mid:col-span-7">
          <ChainDiagram />
        </div>
        <div class="col-span-full flex flex-col items-start gap-4 text-base text-ink-soft mid:col-start-9 mid:col-span-4">
          <p>
            Un site lent peut venir du code, d'une base mal indexée, d'un disque saturé
            ou d'un routeur qui perd des paquets. Trois prestataires spécialisés
            regardent chacun leur étage et concluent que le problème vient de l'étage
            d'à côté.
          </p>
          <p>
            Je ne prétends pas tout couvrir, et je ne veux pas. Je couvre un périmètre
            précis, poste de travail, réseau local, sécurité, site web, et ce périmètre
            suffit à la très grande majorité des besoins d'une petite structure. Ce qui
            sort de ce cadre, je le dis, et je vous oriente.
          </p>
          <a class="tlink mt-[0.4rem]" href="/a-propos/">Comment je travaille</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── § 03 ZONE ────────────────────────────────────── -->
  <section class="section section-rule">
    <div class="shell">
      <SectionHead
        n="03"
        kicker="Zone d'intervention"
        title="Je privilégie la proximité"
        lede="Pour tout ce qui se touche, être à vingt minutes change la nature du service. Pour le reste, la distance ne change rien."
      />
      <div class="grid12 mt-12 items-end gap-y-10">
        <div class="col-span-full mid:col-span-6"><ZoneRadar /></div>
        <figure class="col-span-full m-0 mid:col-start-8 mid:col-span-5">
          <Image
            src={cote}
            alt="Mains sur le clavier d'un ordinateur portable pendant une intervention à distance"
            loading="lazy" decoding="async"
            widths={[480, 768, 1100]}
            sizes="(width >= 60rem) 40vw, 100vw"
            quality={68}
            class="aspect-video w-full object-cover saturate-[0.82] mid:aspect-3/4"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ─── § 04 FAQ ─────────────────────────────────────── -->
  <section class="section section-rule">
    <div class="shell">
      <SectionHead n="04" kicker="Questions fréquentes" title="Ce qu'on me demande avant d'appeler" />
      <div class="mt-10 max-w-[62rem]"><Faq items={faq} /></div>
    </div>
  </section>

  <CtaBand
    kicker="Prochaine étape"
    title="Dites-moi ce qui ne va pas."
    text="Quelques lignes suffisent : la machine, le symptôme, depuis quand. Je réponds avec un plan concret et un ordre de prix, avant tout engagement."
    second={{ href: '/services/', label: 'Voir le détail des prestations' }}
  />
</Base>
