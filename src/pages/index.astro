---
import Base from '../layouts/Base.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Plus from '@lucide/astro/icons/plus';
import SectionHead from '../components/SectionHead.astro';
import Terminal from '../components/Terminal.astro';
import Receipt from '@lucide/astro/icons/receipt';
import MessageCircle from '@lucide/astro/icons/message-circle';
import FileText from '@lucide/astro/icons/file-text';
import Compass from '@lucide/astro/icons/compass';
import ZoneRadar from '../components/ZoneRadar.astro';
import HeroNetworkBg from '../components/HeroNetworkBg.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqSection from '../components/FaqSection.astro';
import { Image } from 'astro:assets';
import { services, lienService } from '../data/services';
import atelier from '../assets/atelier.jpg';
import cote from '../assets/cote.jpg';
import etabli from '../assets/etabli.jpg';
import paysage from '../assets/paysage.jpg';

/* Mise en scène des quatre prestations dans la grille : deux tuiles
   larges portées par une photo, deux tuiles étroites sur surface pleine.
   L'ordre suit `services`, la disposition est décidée ici. */
const tuiles: Record<string, { span: string; tone: 'photo' | 'sand' | 'raised' | 'nuit'; img?: ImageMetadata }> = {
  depannage: { span: 'lg:col-span-2', tone: 'photo', img: atelier },
  'formation-ia': { span: '', tone: 'sand' },
  web: { span: '', tone: 'raised' },
  'revue-ia': { span: 'lg:col-span-2', tone: 'nuit', img: paysage },
};

const faq = [
  {
    q: "Vous vous déplacez jusqu'où ?",
    a: "Je me déplace sans supplément dans un rayon de 15 km autour de Rivesaltes, ce qui couvre Perpignan et les communes proches. Au-delà, un forfait kilométrique est annoncé avant l'intervention. Le reste de la France est couvert à distance.",
  },
  {
    q: "Combien ça coûte ?",
    a: "Le diagnostic est annoncé et chiffré avant que je touche à la machine. Pour les particuliers, l'intervention se facture à l'heure, sans frais de dossier. Pour les entreprises, un forfait est proposé après un premier échange gratuit d'une trentaine de minutes.",
  },
  {
    q: "Je n'y connais rien du tout, c'est un problème ?",
    a: "Non, c'est même le cas le plus fréquent, aussi bien pour une panne que pour découvrir l'IA. Je vous explique ce qui s'est passé en français, je vous montre ce que j'ai changé, et vous repartez avec les quelques réflexes qui évitent que ça recommence.",
  },
  {
    q: "Vous travaillez avec quels systèmes ?",
    a: "Windows, macOS et Linux côté poste de travail. Pour le code généré par IA, PHP, JavaScript/TypeScript et Python en priorité. Pour les logiciels métiers, je m'adapte : j'ai déjà repris des environnements dont l'éditeur avait disparu.",
  },
];


/* Engagements repris des pages Particuliers et À propos : rien de promis
   ici qui ne soit déjà écrit ailleurs sur le site. */
const engagements = [
  { icon: Receipt, t: 'Le prix avant de commencer', d: "Vous savez ce que ça coûte avant que je touche à quoi que ce soit. Si quelque chose change en cours de route, je m'arrête et je vous appelle." },
  { icon: MessageCircle, t: 'Des explications en français', d: "Je vous montre ce qui s'est passé et ce que j'ai changé, sans jargon, avec les réflexes qui évitent que ça recommence." },
  { icon: FileText, t: 'Rien ne reste dans ma tête', d: "Ce que je mets en place est documenté et les accès de secours restent chez vous. Quelqu'un d'autre peut reprendre sans repartir de zéro." },
  { icon: Compass, t: 'Je dis quand ce n\'est pas pour moi', d: "Hors de mon périmètre, je vous le dis et je vous oriente vers quelqu'un de compétent, plutôt que d'apprendre à vos frais." },
];

const pannesCourantes = [
  "Il rame, il chauffe, il s'éteint tout seul",
  'Écran noir, plus de démarrage',
  'Boîte mail piratée, fenêtres suspectes',
  'Photos et documents à récupérer',
  "Vous voulez enfin comprendre l'IA, sans vous faire piéger",
];
---
<Base
  title="Technicien informatique à Rivesaltes et Perpignan (66)"
  description="Technicien informatique à Rivesaltes (66) : dépannage, formation à l'IA, sites web et relecture de code IA pour les TPE des Pyrénées-Orientales."
>
  <!-- ─── HERO ─────────────────────────────────────────── -->
  <section class="relative isolate overflow-hidden pt-[clamp(2rem,4.5vw,4.5rem)] pb-[clamp(3.5rem,6vw,6rem)]">
    <HeroNetworkBg class="-z-10 opacity-45" />
    <div class="shell grid items-center gap-x-14 gap-y-12 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)]">
      <div>
        {/* L'étiquette fait partie du titre principal : c'est elle qui dit à
            Google de quoi parle la page, l'accroche porte le ton. */}
        <h1>
          <span class="chip rise text-[0.8rem] font-medium tracking-normal" style="--i:0"><span class="chip__mark" aria-hidden="true">66</span>Technicien informatique à Rivesaltes et Perpignan<span class="sr-only"> :</span></span>
          <span class="rise mt-7 block text-[clamp(2.4rem,1.2rem+3.6vw,4.15rem)]/[1.02] tracking-[-0.045em]" style="--i:1">
            Une panne, un site, une&nbsp;IA.<br /><span class="text-accent">Un seul interlocuteur.</span>
          </span>
        </h1>

        <p class="rise mt-6 max-w-[42ch] text-lede/[1.5] text-ink-soft" style="--i:2">
          Dépannage et formation à l'IA pour les particuliers, sites et relecture de
          code pour les entreprises du Roussillon.
        </p>

        <div class="rise mt-9 flex flex-wrap items-center gap-3" style="--i:3">
          <a class="btn btn--cta" href="/contact/">Me contacter <ArrowRight class="arrow" size="1.05em" aria-hidden="true" /></a>
          <a class="btn btn--ghost" href="#services">Voir les prestations</a>
        </div>
      </div>

      <figure class="unveil relative m-0 overflow-hidden rounded-[var(--radius-xl)] shadow-[var(--shadow-raise-hi)]">
        <Image
          src={etabli}
          alt="Réparation d'une carte électronique au tournevis de précision, sur l'établi"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          widths={[560, 840, 1120, 1400]}
          sizes="(width >= 62rem) 44vw, 100vw"
          quality={72}
          data-parallax="14"
          class="aspect-[4/3] w-full rounded-none object-cover object-[72%_50%] lg:aspect-[4/5]"
        />
      </figure>
    </div>
  </section>

  <!-- ─── DOUBLE AIGUILLAGE ────────────────────────────── -->
  <section class="pb-[clamp(3.5rem,6vw,6rem)]" aria-label="Choisir votre parcours">
    <div class="shell grid grid-cols-1 gap-5 lg:grid-cols-2">
      <div class="panel flex flex-col gap-[1.1rem] border-transparent bg-sand px-[clamp(1.4rem,3.5vw,3rem)] pt-[clamp(1.8rem,3.5vw,3rem)] pb-[clamp(2rem,3.5vw,3rem)]" data-reveal>
        {/* Photo d'ambiance en fond, volontairement très effacée. */}
        <Image
          src={atelier}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          widths={[480, 800, 1200]}
          sizes="(width >= 62rem) 45vw, 100vw"
          quality={35}
          class="absolute inset-0 -z-10 size-full object-cover opacity-[0.07] grayscale contrast-125"
        />
        <span class="badge badge--accent self-start" aria-hidden="true">Particulier</span>
        {/* L'étiquette visible est rattachée au titre pour qui navigue de titre en titre. */}
        <h2 class="text-[clamp(1.6rem,1.15rem+1.6vw,2.35rem)]/[1.08] tracking-[-0.035em]"><span class="sr-only">Vous êtes un particulier : </span>Mon ordinateur ne va pas, ou je ne sais pas utiliser l'IA.</h2>

        <ul class="m-0 flex list-none flex-col p-0">
          {pannesCourantes.map((p) => (
            <li class="relative border-b border-rule py-[0.6rem] pl-6 text-base last:border-b-0">
              <Plus class="absolute top-[0.95rem] left-0 text-accent" size="0.85em" aria-hidden="true" />
              {p}
            </li>
          ))}
        </ul>

        <p class="max-w-[42ch] text-base text-ink-soft">
          Vous savez ce que ça coûte avant que je touche à la machine. Si la réparation
          ne vaut pas le coup, je vous le dis.
        </p>
        <a class="btn btn--cta mt-auto self-start" href="/particuliers/">
          Voir l'offre particuliers <ArrowRight class="arrow" size="1.05em" aria-hidden="true" />
        </a>
      </div>

      <div class="panel on-nuit flex flex-col gap-[1.1rem] border-transparent bg-nuit px-[clamp(1.4rem,3.5vw,3rem)] pt-[clamp(1.8rem,3.5vw,3rem)] pb-[clamp(2rem,3.5vw,3rem)]" data-reveal>
        <span class="badge badge--accent self-start" aria-hidden="true">Entreprise</span>
        <h2 class="text-[clamp(1.6rem,1.15rem+1.6vw,2.35rem)]/[1.08] tracking-[-0.035em]"><span class="sr-only">Vous êtes une entreprise : </span>Votre site tourne. Qui a relu le code ?</h2>

        <Terminal
          title="revue : dépôt client, code généré par IA"
          lines={[
            { k: 'cmd', t: 'grep -rniE "sk-|api_key|password" src/' },
            { k: 'warn', t: 'src/config.js:14      clé API laissée en dur' },
            { k: 'warn', t: 'src/api/users.js:41   requête SQL construite par concatenation' },
            { k: 'ok', t: 'src/auth/*.js         vérifié : pas d\'injection, tokens signés' },
            { k: 'out', t: 'fichiers signalés     3 sur 62 générés par l\'assistant IA' },
            { k: 'dim', t: 'rapport lisible, priorisé, sans jargon' },
          ]}
        />

        <p class="max-w-[42ch] text-base text-ink-soft">
          Une relecture du code généré par IA, puis une seule personne pour tenir le
          site dans la durée. Pas de flou entre qui a écrit quoi et qui répond si ça
          casse.
        </p>
        <a class="btn btn--cta mt-auto self-start" href="/professionnels/">
          Voir l'offre entreprises <ArrowRight class="arrow" size="1.05em" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- ─── SERVICES : grille à quatre tuiles ────────────── -->
  <section class="section section-rule" id="services">
    <div class="shell">
      <SectionHead
        title="Quatre prestations, deux publics"
        lede="Dépannage et formation à l'IA pour les particuliers, site web et relecture de code IA pour les entreprises. Je ne facture que ce que je peux vérifier moi-même."
      />

      <ul class="m-0 mt-12 grid list-none grid-cols-1 gap-5 p-0 lg:grid-cols-3">
        {services.map((s) => {
          const t = tuiles[s.id];
          const sombre = t.tone === 'photo' || t.tone === 'nuit';
          return (
            <li class:list={[t.span]} data-reveal>
              <a
                href={lienService(s)}
                data-spotlight
                aria-labelledby={`tuile-${s.id}`}
                aria-describedby={`tuile-${s.id}-d`}
                class:list={[
                  'panel panel-link h-full min-h-[19rem] flex-col justify-end gap-3 p-[clamp(1.4rem,2.5vw,2.1rem)]',
                  sombre && 'on-nuit border-transparent bg-nuit text-ink',
                  t.tone === 'sand' && 'border-transparent bg-sand',
                ]}
              >
                {t.img && (
                  <>
                    <Image
                      src={t.img}
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      decoding="async"
                      widths={[480, 800, 1200]}
                      sizes="(width >= 80rem) 52rem, (width >= 62rem) 64vw, 100vw"
                      quality={50}
                      class:list={['panel-media absolute inset-0 -z-20 size-full object-cover', t.tone === 'nuit' ? 'opacity-45' : 'opacity-70']}
                    />
                    {/* Voile : garantit le contraste du texte posé sur la photo. */}
                    <span class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,var(--color-nuit)_18%,color-mix(in_oklch,var(--color-nuit)_55%,transparent)_60%,color-mix(in_oklch,var(--color-nuit)_15%,transparent))]" aria-hidden="true"></span>
                  </>
                )}
                <span class="flex flex-wrap gap-[0.35rem]" aria-hidden="true">
                  {s.pour.includes('particulier') && <span class="badge">Particuliers</span>}
                  {s.pour.includes('entreprise') && <span class="badge">Entreprises</span>}
                </span>
                <span class="flex items-end justify-between gap-6">
                  <span class="flex flex-col gap-2">
                    <h3 class="text-[clamp(1.3rem,1.05rem+0.9vw,1.85rem)]/[1.1] tracking-[-0.03em]" id={`tuile-${s.id}`}>{s.titre}</h3>
                    <span class="max-w-[48ch] text-[0.97rem]/[1.55] text-ink-soft" id={`tuile-${s.id}-d`}>
                      {s.probleme}
                      <span class="sr-only">Pour les {s.pour.map((x) => (x === 'particulier' ? 'particuliers' : 'entreprises')).join(' et les ')}.</span>
                    </span>
                  </span>
                  <span class="grid size-10 flex-none place-items-center rounded-full border border-rule text-accent" aria-hidden="true">
                    <ArrowRight class="arrow" size="1.05em" />
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ─── ENGAGEMENTS ──────────────────────────────────── -->
  <section class="section section-rule section-tint">
    <div class="shell">
      <SectionHead
        title="Quatre engagements, quel que soit le chantier"
        lede="Une panne chez un particulier ou un site d'entreprise : la façon de travailler ne change pas."
      />
      <ul class="trace-line m-0 mt-14 grid list-none grid-cols-1 gap-y-10 p-0 sm:grid-cols-2 lg:grid-cols-4" data-inview>
        {engagements.map((e, i) => (
          <li
            class:list={[
              'flex flex-col gap-3 pt-8 sm:pr-8',
              i > 0 && 'lg:border-l lg:border-rule lg:pl-8',
              i % 2 === 1 && 'sm:max-lg:border-l sm:max-lg:border-rule sm:max-lg:pl-8',
            ]}
            data-reveal
          >
            <span class="pop-icon grid size-11 place-items-center rounded-full bg-raised text-accent shadow-[var(--shadow-raise)]" style={`--i:${i}`} aria-hidden="true">
              <e.icon size={20} stroke-width={1.8} />
            </span>
            <h3 class="mt-2 text-[1.25rem]/[1.2] tracking-[-0.028em]">{e.t}</h3>
            <p class="text-base text-ink-soft">{e.d}</p>
          </li>
        ))}
      </ul>
      <a class="tlink mt-12 inline-block" href="/a-propos/">Comment je travaille</a>
    </div>
  </section>

  <!-- ─── ZONE ─────────────────────────────────────────── -->
  <section class="section section-rule">
    <div class="shell">
      <SectionHead
        title="Je privilégie la proximité"
        lede="Pour tout ce qui se touche ou se montre, être à vingt minutes change la nature du service. Pour le reste, la distance ne change rien."
      />
      <div class="mt-12 grid grid-cols-1 items-stretch gap-5 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
        <div class="panel p-[clamp(1rem,2.5vw,2rem)]" data-reveal><ZoneRadar /></div>
        <figure class="m-0 overflow-hidden rounded-[var(--radius-xl)]" data-reveal>
          <Image
            src={cote}
            alt="Mains sur le clavier d'un ordinateur portable pendant une intervention à distance"
            loading="lazy" decoding="async"
            widths={[480, 768, 1100]}
            sizes="(width >= 62rem) 40vw, 100vw"
            quality={68}
            class="aspect-video size-full rounded-none object-cover saturate-[0.82] lg:aspect-auto"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ─── FAQ ──────────────────────────────────────────── -->
  <FaqSection title="Ce qu'on me demande avant d'appeler" items={faq} />

  <CtaBand
    title="Dites-moi ce qui ne va pas."
    text="Quelques lignes suffisent : la machine, le symptôme, ou le projet, depuis quand. Je réponds avec un plan concret et un ordre de prix, avant tout engagement."
  />
</Base>
