---
import Base from '../layouts/Base.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Plus from '@lucide/astro/icons/plus';
import SectionHead from '../components/SectionHead.astro';
import Receipt from '@lucide/astro/icons/receipt';
import MessageCircle from '@lucide/astro/icons/message-circle';
import FileText from '@lucide/astro/icons/file-text';
import Compass from '@lucide/astro/icons/compass';
import ZoneRadar from '../components/ZoneRadar.astro';
import HeroNetworkBg from '../components/HeroNetworkBg.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqSection from '../components/FaqSection.astro';
import { Image } from 'astro:assets';
import { services, lienService } from '../data/services';
import atelier from '../assets/atelier.jpg';
import cote from '../assets/cote.jpg';
import etabli from '../assets/etabli.jpg';
import paysage from '../assets/paysage.jpg';
import baie from '../assets/baie.jpg';

/* Disposition des tuiles dans la grille */
const tuiles: Record<string, { span: string; tone: 'photo' | 'sand' | 'raised' | 'nuit'; img?: ImageMetadata }> = {
  depannage: { span: 'lg:col-span-2', tone: 'photo', img: atelier },
  'formation-ia': { span: '', tone: 'sand' },
  web: { span: '', tone: 'raised' },
  'revue-ia': { span: 'lg:col-span-2', tone: 'nuit', img: paysage },
};

const faq = [
  {
    q: "Vous vous déplacez jusqu'où ?",
    a: "Je me déplace sans supplément dans un rayon de 15 km autour de Rivesaltes, ce qui couvre Perpignan et les communes proches (Baixas, Salses, Cabestany, Le Barcarès, Saint-Estève, Bompas, Pia...). Au-delà, un forfait kilométrique est annoncé avant l'intervention. L'assistance logicielle et les projets web se font aussi à distance partout en France.",
  },
  {
    q: "Combien coûte une intervention ?",
    a: "Le diagnostic est clair et chiffré avant que je commence. Pour les dépannages, la facturation se fait à l'heure ou au forfait selon l'opération (changement de disque SSD, réinstallation, etc.). Pour les sites web et la maintenance d'entreprise, un devis forfaitaire précis est établi après un premier échange gratuit.",
  },
  {
    q: "Je n'y connais rien en informatique, est-ce un problème ?",
    a: "Non, c'est même très fréquent. Je vous explique ce qui s'est passé avec des mots simples en français, sans jargon inutile. Je vous montre ce qui a été fait et vous repartez avec les bons réflexes pour éviter que le problème ne réapparaisse.",
  },
  {
    q: "Si la réparation coûte trop cher par rapport à la valeur de l'ordinateur ?",
    a: "Je vous le dis en toute transparence avant d'engager des frais. Si votre matériel est trop ancien ou que la réparation n'est pas rentable, je vous conseille franchement sur la meilleure option sans chercher à facturer inutilement.",
  },
];

const engagements = [
  {
    icon: Receipt,
    t: 'Le prix avant de commencer',
    d: "Vous savez exactement ce que ça coûte avant toute intervention. Si une pièce s'avère nécessaire, je m'arrête et nous validons ensemble.",
  },
  {
    icon: MessageCircle,
    t: 'Des explications en français',
    d: "Pas de jargon technique pour noyer le poisson. Je vous explique clairement ce qui a été réparé et comment garder votre machine saine.",
  },
  {
    icon: FileText,
    t: 'Vos accès restent chez vous',
    d: "Vos mots de passe, vos comptes et vos codes restent votre propriété exclusive. Tout ce qui est configuré est noté sur une fiche récapitulative.",
  },
  {
    icon: Compass,
    t: 'Honnêteté et bon sens',
    d: "Si réparer un vieil appareil n'en vaut pas la peine, je vous le dis franchement plutôt que d'engager des frais inutiles à vos dépens.",
  },
];

const pannesCourantes = [
  "Ordinateur très lent, blocages au démarrage",
  "Virus, fenêtres publicitaires suspectes, piratage de compte",
  "Écran noir, panne de chargeur, ordinateur qui ne s'allume plus",
  "Photos et documents à récupérer ou sauvegarder",
  "Wi-Fi faible, imprimante bloquée, box internet à configurer",
  "Initiation pratique aux outils numériques et à l'IA du quotidien",
];

const besoinsEntreprises = [
  "Création ou refonte de site web vitrine rapide et adapté aux mobiles",
  "Visibilité sur Google & Google Maps pour que les clients locaux vous appellent",
  "Postes et serveurs Windows entretenus pour éviter les pannes en plein travail",
  "Sauvegardes automatiques fiables pour protéger vos données professionnelles",
  "Un artisan de proximité disponible directement, sans intermédiaire",
];
---
<Base
  title="Dépannage informatique & Sites Web à Rivesaltes et Perpignan (66)"
  description="Dépannage et réparation d'ordinateurs, assistance à domicile, création de sites vitrines et maintenance informatique pour particuliers, artisans et TPE des Pyrénées-Orientales."
>
  <!-- ─── HERO ─────────────────────────────────────────── -->
  <section class="relative isolate overflow-hidden pt-[clamp(2rem,4.5vw,4.5rem)] pb-[clamp(3.5rem,6vw,6rem)]">
    <HeroNetworkBg class="-z-10 opacity-45" />
    <div class="shell grid items-center gap-x-14 gap-y-12 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)]">
      <div>
        <h1>
          <span class="chip rise text-[0.8rem] font-medium tracking-normal" style="--i:0">
            <span class="chip__mark" aria-hidden="true">66</span>Rivesaltes · Perpignan · Pyrénées-Orientales
          </span>
          <span class="rise mt-7 block text-[clamp(2.4rem,1.2rem+3.6vw,4.15rem)]/[1.02] tracking-[-0.045em]" style="--i:1">
            Votre informatique en ordre de marche.<br /><span class="text-accent">Vos outils, votre site web.</span>
          </span>
        </h1>

        <p class="rise mt-6 max-w-[42ch] text-lede/[1.5] text-ink-soft" style="--i:2">
          Dépannage et maintenance de vos ordinateurs sur place ou en atelier, création et suivi de sites web pour artisans, commerçants et particuliers. Un interlocuteur unique, sans intermédiaire.
        </p>

        <div class="rise mt-9 flex flex-wrap items-center gap-3" style="--i:3">
          <a class="btn btn--cta" href="/contact/">Demander un diagnostic <ArrowRight class="arrow" size="1.05em" aria-hidden="true" /></a>
          <a class="btn btn--ghost" href="#services">Découvrir les prestations</a>
        </div>

        <p class="rise mt-4 text-[0.85rem] text-ink-soft" style="--i:4">
          Déplacement inclus jusqu'à 15 km autour de Rivesaltes · Devis annoncé avant toute intervention.
        </p>
      </div>

      <figure class="unveil relative m-0 overflow-hidden rounded-[var(--radius-xl)] shadow-[var(--shadow-raise-hi)]">
        <Image
          src={etabli}
          alt="Réparation et maintenance d'un ordinateur de précision sur l'établi"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          widths={[560, 840, 1120, 1400]}
          sizes="(width >= 62rem) 44vw, 100vw"
          quality={72}
          data-parallax="14"
          class="aspect-[4/3] w-full rounded-none object-cover object-[72%_50%] lg:aspect-[4/5]"
        />
      </figure>
    </div>
  </section>

  <!-- ─── DOUBLE AIGUILLAGE ────────────────────────────── -->
  <section class="pb-[clamp(3.5rem,6vw,6rem)]" aria-label="Choisir votre parcours">
    <div class="shell grid grid-cols-1 gap-5 lg:grid-cols-2">
      <!-- Volet Particuliers -->
      <div class="panel flex flex-col gap-[1.1rem] border-transparent bg-sand px-[clamp(1.4rem,3.5vw,3rem)] pt-[clamp(1.8rem,3.5vw,3rem)] pb-[clamp(2rem,3.5vw,3rem)]" data-reveal>
        <Image
          src={atelier}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          widths={[480, 800, 1200]}
          sizes="(width >= 62rem) 45vw, 100vw"
          quality={35}
          class="absolute inset-0 -z-10 size-full object-cover opacity-[0.07] grayscale contrast-125"
        />
        <span class="badge badge--accent self-start" aria-hidden="true">Particuliers & Domicile</span>
        <h2 class="text-[clamp(1.6rem,1.15rem+1.6vw,2.35rem)]/[1.08] tracking-[-0.035em]">
          <span class="sr-only">Pour les particuliers : </span>Mon ordinateur rame, est bloqué ou je veux apprendre à l'utiliser.
        </h2>

        <ul class="m-0 flex list-none flex-col p-0">
          {pannesCourantes.map((p) => (
            <li class="relative border-b border-rule py-[0.6rem] pl-6 text-base last:border-b-0">
              <Plus class="absolute top-[0.95rem] left-0 text-accent" size="0.85em" aria-hidden="true" />
              {p}
            </li>
          ))}
        </ul>

        <p class="max-w-[42ch] text-base text-ink-soft">
          Vous savez ce que ça coûte avant que je touche à la machine. Si la réparation n'en vaut pas la peine, je vous le dis en toute honnêteté.
        </p>
        <a class="btn btn--cta mt-auto self-start" href="/particuliers/">
          Voir les services particuliers <ArrowRight class="arrow" size="1.05em" aria-hidden="true" />
        </a>
      </div>

      <!-- Volet Professionnels -->
      <div class="panel on-nuit flex flex-col gap-[1.1rem] border-transparent bg-nuit px-[clamp(1.4rem,3.5vw,3rem)] pt-[clamp(1.8rem,3.5vw,3rem)] pb-[clamp(2rem,3.5vw,3rem)]" data-reveal>
        <Image
          src={baie}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          widths={[480, 800, 1200]}
          sizes="(width >= 62rem) 45vw, 100vw"
          quality={35}
          class="absolute inset-0 -z-10 size-full object-cover opacity-[0.06] grayscale contrast-125"
        />
        <span class="badge badge--accent self-start" aria-hidden="true">Artisans, Commerçants & PME</span>
        <h2 class="text-[clamp(1.6rem,1.15rem+1.6vw,2.35rem)]/[1.08] tracking-[-0.035em]">
          <span class="sr-only">Pour les professionnels : </span>Un site internet qui rapporte des clients et un matériel fiable.
        </h2>

        <ul class="m-0 flex list-none flex-col p-0">
          {besoinsEntreprises.map((b) => (
            <li class="relative border-b border-rule py-[0.6rem] pl-6 text-base last:border-b-0">
              <Plus class="absolute top-[0.95rem] left-0 text-accent" size="0.85em" aria-hidden="true" />
              {b}
            </li>
          ))}
        </ul>

        <p class="max-w-[42ch] text-base text-ink-soft">
          Création de site web sobre et rapide, présence sur Google Maps, et entretien de vos ordinateurs de travail. Pas de sous-traitance, un seul interlocuteur réactif.
        </p>
        <a class="btn btn--cta mt-auto self-start" href="/professionnels/">
          Voir les offres entreprises <ArrowRight class="arrow" size="1.05em" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- ─── SERVICES : grille à quatre tuiles ────────────── -->
  <section class="section section-rule" id="services">
    <div class="shell">
      <SectionHead
        title="Quatre prestations, deux publics"
        lede="Dépannage et assistance pour votre confort à la maison, visibilité web et tranquillité informatique pour votre activité professionnelle."
      />

      <ul class="m-0 mt-12 grid list-none grid-cols-1 gap-5 p-0 lg:grid-cols-3">
        {services.map((s) => {
          const t = tuiles[s.id];
          const sombre = t.tone === 'photo' || t.tone === 'nuit';
          return (
            <li class:list={[t.span]} data-reveal>
              <a
                href={lienService(s)}
                data-spotlight
                aria-labelledby={`tuile-${s.id}`}
                aria-describedby={`tuile-${s.id}-d`}
                class:list={[
                  'panel panel-link h-full min-h-[19rem] flex-col justify-end gap-3 p-[clamp(1.4rem,2.5vw,2.1rem)]',
                  sombre && 'on-nuit border-transparent bg-nuit text-ink',
                  t.tone === 'sand' && 'border-transparent bg-sand',
                ]}
              >
                {t.img && (
                  <>
                    <Image
                      src={t.img}
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      decoding="async"
                      widths={[480, 800, 1200]}
                      sizes="(width >= 80rem) 52rem, (width >= 62rem) 64vw, 100vw"
                      quality={50}
                      class:list={['panel-media absolute inset-0 -z-20 size-full object-cover', t.tone === 'nuit' ? 'opacity-45' : 'opacity-70']}
                    />
                    <span class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,var(--color-nuit)_18%,color-mix(in_oklch,var(--color-nuit)_55%,transparent)_60%,color-mix(in_oklch,var(--color-nuit)_15%,transparent))]" aria-hidden="true"></span>
                  </>
                )}
                <span class="flex flex-wrap gap-[0.35rem]" aria-hidden="true">
                  {s.pour.includes('particulier') && <span class="badge">Particuliers</span>}
                  {s.pour.includes('entreprise') && <span class="badge">Entreprises</span>}
                </span>
                <span class="flex items-end justify-between gap-6">
                  <span class="flex flex-col gap-2">
                    <h3 class="text-[clamp(1.3rem,1.05rem+0.9vw,1.85rem)]/[1.1] tracking-[-0.03em]" id={`tuile-${s.id}`}>{s.titre}</h3>
                    <span class="max-w-[48ch] text-[0.97rem]/[1.55] text-ink-soft" id={`tuile-${s.id}-d`}>
                      {s.probleme}
                      <span class="sr-only">Pour les {s.pour.map((x) => (x === 'particulier' ? 'particuliers' : 'entreprises')).join(' et les ')}.</span>
                    </span>
                  </span>
                  <span class="grid size-10 flex-none place-items-center rounded-full border border-rule text-accent" aria-hidden="true">
                    <ArrowRight class="arrow" size="1.05em" />
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ─── ENGAGEMENTS ──────────────────────────────────── -->
  <section class="section section-rule section-tint">
    <div class="shell">
      <SectionHead
        title="Quatre engagements, quel que soit le travail"
        lede="Une panne à domicile ou un site d'entreprise : la façon de travailler reste la même, avec rigueur et clarté."
      />
      <ul class="trace-line m-0 mt-14 grid list-none grid-cols-1 gap-y-10 p-0 sm:grid-cols-2 lg:grid-cols-4" data-inview>
        {engagements.map((e, i) => (
          <li
            class:list={[
              'flex flex-col gap-3 pt-8 sm:pr-8',
              i > 0 && 'lg:border-l lg:border-rule lg:pl-8',
              i % 2 === 1 && 'sm:max-lg:border-l sm:max-lg:border-rule sm:max-lg:pl-8',
            ]}
            data-reveal
          >
            <span class="pop-icon grid size-11 place-items-center rounded-full bg-raised text-accent shadow-[var(--shadow-raise)]" style={`--i:${i}`} aria-hidden="true">
              <e.icon size={20} stroke-width={1.8} />
            </span>
            <h3 class="mt-2 text-[1.25rem]/[1.2] tracking-[-0.028em]">{e.t}</h3>
            <p class="text-base text-ink-soft">{e.d}</p>
          </li>
        ))}
      </ul>
      <a class="tlink mt-12 inline-block" href="/a-propos/">En savoir plus sur ma façon de travailler</a>
    </div>
  </section>

  <!-- ─── ZONE RADAR ───────────────────────────────────── -->
  <section class="section section-rule">
    <div class="shell">
      <SectionHead
        title="Proximité et réactivité locale"
        lede="Déplacement sans surcoût jusqu'à 15 km autour de Rivesaltes (Perpignan et communes voisines). Au-delà ou pour vos sites web, tout est également réalisable à distance."
      />
      <div class="mt-12 grid grid-cols-1 items-stretch gap-5 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
        <div class="panel p-[clamp(1rem,2.5vw,2rem)]" data-reveal><ZoneRadar /></div>
        <figure class="m-0 overflow-hidden rounded-[var(--radius-xl)]" data-reveal>
          <Image
            src={cote}
            alt="Mains sur le clavier d'un ordinateur portable pendant une intervention d'assistance informatique"
            loading="lazy" decoding="async"
            widths={[480, 768, 1100]}
            sizes="(width >= 62rem) 40vw, 100vw"
            quality={68}
            class="aspect-video size-full rounded-none object-cover saturate-[0.82] lg:aspect-auto"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ─── FAQ ──────────────────────────────────────────── -->
  <FaqSection title="Ce qu'on me demande avant d'appeler" items={faq} />

  <!-- ─── BANDEAU FINAL ────────────────────────────────── -->
  <CtaBand
    title="Un problème d'ordinateur ou un projet de site web ?"
    text="Quelques lignes suffisent : la panne rencontrée, le matériel concerné ou ce que vous souhaitez pour votre activité. Je vous réponds avec une estimation claire et sans aucun engagement."
    cta="Demander un devis"
  />
</Base>
