---
import Base from '../../layouts/Base.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import PageHead from '../../components/PageHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { AUDIENCE_LABEL, formatDate } from '../../lib/blog';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base
  title="Blog · code, sécurité et cryptographie (66)"
  description="Sites web, sécurité du code généré par IA, et notes de veille sur la cryptographie post-quantique : des articles pour les particuliers et les petites entreprises du Roussillon, sans jargon inutile."
>
  <PageHead
    kicker="Blog"
    title="Ce que j'explique le plus souvent"
    lede="Les mêmes questions reviennent sur presque toutes les missions, et c'est aussi ici que je documente ce que j'apprends en ce moment. Autant l'écrire une fois pour toutes, en français, sans supposer que vous connaissez le vocabulaire."
  />

  <section class="section">
    <div class="shell">
      {posts.length === 0 ? (
        <p class="border-y border-rule py-12 text-ink-soft">Aucun article publié pour l'instant.</p>
      ) : (
        <ol class="rowlist">
          {posts.map((p) => (
            <li>
              <a
                href={`/blog/${p.id}/`}
                class="grid grid-cols-[1fr_1.5rem] items-start gap-6 py-[1.9rem] hover:px-4 [@media(width>52rem)]:grid-cols-[11rem_minmax(0,1fr)_1.5rem]"
              >
                <span class="flex flex-row items-center gap-3 [@media(width>52rem)]:flex-col [@media(width>52rem)]:items-start [@media(width>52rem)]:gap-[0.45rem] [@media(width>52rem)]:pt-[0.35rem]">
                  <time class="font-mono text-[0.68rem] uppercase tracking-[0.06em] text-ink-faint" datetime={p.data.date.toISOString()}>
                    {formatDate(p.data.date)}
                  </time>
                  <span class="badge badge--accent w-fit">{AUDIENCE_LABEL[p.data.audience]}</span>
                </span>

                <span class="flex flex-col gap-[0.45rem]">
                  <span class="max-w-[28ch] text-[clamp(1.2rem,1.05rem+0.85vw,1.7rem)]/[1.18] font-bold tracking-[-0.032em]">{p.data.title}</span>
                  <span class="max-w-[66ch] text-base text-ink-soft">{p.data.summary}</span>
                </span>

                <ArrowRight class="arrow justify-self-end mt-[0.4rem] text-accent" size="1.1em" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <CtaBand
    kicker="Un cas particulier"
    title="Votre situation n'est pas dans la liste ?"
    text="Décrivez-la. Si la réponse peut servir à d'autres, elle finira probablement en article, et vous l'aurez eue en premier."
  />
</Base>
