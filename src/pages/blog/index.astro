---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });
const etiq = { particulier: 'Particuliers', entreprise: 'Entreprises', tous: 'Tout public' } as const;
---
<Base
  title="Blog · conseils informatiques pratiques (66)"
  description="Sauvegarde, sécurité, matériel, accès à distance : des articles pour les particuliers et les petites entreprises du Roussillon, sans jargon inutile."
>
  <PageHead
    kicker="Blog"
    title="Ce que j'explique le plus souvent"
    lede="Les mêmes questions reviennent sur presque toutes les interventions. Autant les écrire une fois pour toutes, en français, sans supposer que vous connaissez le vocabulaire."
  >
    <p class="split mono">
      Vous cherchez le registre technique&nbsp;?
      <a class="tlink" href="/labo/">Le labo est ici</a>.
    </p>
  </PageHead>

  <section class="band">
    <div class="shell">
      {posts.length === 0 ? (
        <p class="empty">Aucun article publié pour l'instant.</p>
      ) : (
        <ol class="list">
          {posts.map((p) => (
            <li>
              <a href={`/blog/${p.id}/`}>
                <span class="li-m">
                  <time class="mono" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                  <span class="aud">{etiq[p.data.audience]}</span>
                </span>
                <span class="li-b">
                  <span class="li-t">{p.data.title}</span>
                  <span class="li-s">{p.data.summary}</span>
                </span>
                <span class="li-go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <CtaBand
    kicker="Un cas particulier"
    title="Votre situation n'est pas dans la liste ?"
    text="Décrivez-la. Si la réponse peut servir à d'autres, elle finira probablement en article, et vous l'aurez eue en premier."
  />
</Base>

<style>
  .split { font-size: 0.72rem; color: var(--ink-faint); letter-spacing: 0.04em; }
  .list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule-strong); }
  .list li { border-bottom: 1px solid var(--rule); }
  .list a {
    display: grid; grid-template-columns: 11rem minmax(0, 1fr) 1.5rem; gap: 1.5rem;
    padding: 1.9rem 0; text-decoration: none; color: inherit; align-items: start;
    transition: background .18s var(--ease), padding-inline .18s var(--ease);
  }
  .list a:hover { background: var(--accent-wash); padding-inline: 1rem; }
  .li-m { display: flex; flex-direction: column; gap: 0.45rem; padding-top: 0.35rem; }
  .li-m time { font-size: 0.68rem; color: var(--ink-faint); letter-spacing: 0.06em; text-transform: uppercase; }
  .aud {
    font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--accent); border: 1px solid var(--accent); padding: 0.1rem 0.45rem; width: fit-content;
  }
  .li-b { display: flex; flex-direction: column; gap: 0.45rem; }
  .li-t { font-size: clamp(1.2rem, 1.05rem + 0.85vw, 1.7rem); font-weight: 700; letter-spacing: -0.032em; line-height: 1.18; max-width: 28ch; }
  .li-s { color: var(--ink-soft); font-size: 0.93rem; max-width: 66ch; }
  .li-go { color: var(--accent); justify-self: end; padding-top: 0.4rem; transition: transform .18s var(--ease); }
  .list a:hover .li-go { transform: translateX(4px); }
  .empty { color: var(--ink-soft); border-block: 1px solid var(--rule); padding: 3rem 0; }
  @media (max-width: 52rem) {
    .list a { grid-template-columns: 1fr 1.5rem; }
    .li-m { flex-direction: row; align-items: center; gap: 0.75rem; padding-top: 0; }
  }
</style>
