---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });
const etiq = { particulier: 'Particuliers', entreprise: 'Entreprises', tous: 'Tout public' } as const;
const cible = post.data.audience === 'entreprise' ? '/professionnels/' : '/particuliers/';

const others = (await getCollection('blog'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Person', name: 'Elian', url: 'https://einformatique.fr/a-propos/' },
  publisher: { '@id': 'https://einformatique.fr/#business' },
};
---
<Base title={post.data.title} description={post.data.summary}>
  <article>
    <header class="art-h">
      <div class="shell art-hin">
        <a class="back mono" href="/blog/">← Blog</a>
        <div class="art-m">
          <time class="mono" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          <span class="aud">{etiq[post.data.audience]}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="art-s">{post.data.summary}</p>
      </div>
    </header>

    <div class="shell art-body">
      <div class="prose"><Content /></div>

      <aside class="aside">
        <div class="ab">
          <p class="label">En pratique</p>
          <p>
            Cet article décrit ce que je fais chez mes clients. Si vous préférez que je
            m'en occupe, la mise en place se règle en général en une intervention.
          </p>
          <a class="btn btn--grenat" href="/contact/">Me confier ça <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="ab">
          <p class="label">Voir aussi</p>
          <ul class="ab-l">
            <li><a href={cible}>{post.data.audience === 'entreprise' ? 'Prestations entreprises' : 'Dépannage particuliers'}</a></li>
            {others.map((o) => <li><a href={`/blog/${o.id}/`}>{o.data.title}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </article>

  <CtaBand
    kicker="Après lecture"
    title="Une question qui reste ?"
    text="Écrivez-la telle quelle. Je réponds sous 24 h ouvrées, y compris quand la réponse est que vous n'avez besoin de personne."
  />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</Base>

<style>
  .art-h { padding-block: clamp(2rem, 4vw, 3.5rem) clamp(1.75rem, 3vw, 2.75rem); border-bottom: 1px solid var(--rule); background: var(--paper-warm); }
  .art-hin { max-width: 58rem; }
  .back { color: var(--ink-faint); text-decoration: none; font-size: 0.72rem; letter-spacing: 0.08em; }
  .back:hover { color: var(--grenat); }
  .art-m { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; margin-top: 1.75rem; }
  .art-m time { font-size: 0.68rem; color: var(--ink-faint); letter-spacing: 0.08em; text-transform: uppercase; }
  .aud {
    font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--grenat); border: 1px solid var(--grenat); padding: 0.1rem 0.45rem;
  }
  .art-h h1 { margin-top: 1rem; font-size: clamp(1.9rem, 1rem + 3.1vw, 3rem); max-width: 24ch; }
  .art-s { margin-top: 1.1rem; color: var(--ink-soft); max-width: 60ch; font-size: 1.05rem; line-height: 1.6; }

  .art-body {
    display: grid; grid-template-columns: minmax(0, 1fr) 16rem; gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start; padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  @media (max-width: 62rem) { .art-body { grid-template-columns: 1fr; } }

  .aside { display: flex; flex-direction: column; gap: 1.75rem; position: sticky; top: 7rem; }
  @media (max-width: 62rem) { .aside { position: static; } }
  .ab { border-top: 1px solid var(--rule-strong); padding-top: 1rem; }
  .ab p:not(.label) { margin: 0.7rem 0 1.1rem; font-size: 0.875rem; color: var(--ink-soft); }
  .ab-l { list-style: none; padding: 0; margin: 0.8rem 0 0; }
  .ab-l li { border-bottom: 1px solid var(--rule); }
  .ab-l a { display: block; padding: 0.7rem 0; font-size: 0.875rem; font-weight: 600; text-decoration: none; letter-spacing: -0.015em; }
  .ab-l a:hover { color: var(--grenat); }
</style>
