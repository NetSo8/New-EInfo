---
import Base from '../../layouts/Base.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection, render } from 'astro:content';
import { AUDIENCE_LABEL, formatDate } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const cible = post.data.audience === 'entreprise' ? '/professionnels/' : '/particuliers/';

const others = (await getCollection('blog'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Person', name: 'Elian', url: 'https://einformatique.fr/a-propos/' },
  publisher: { '@id': 'https://einformatique.fr/#business' },
};
---
<Base title={post.data.title} description={post.data.summary}>
  <article>
    <header class="border-b border-rule bg-paper-warm pt-[clamp(2rem,4vw,3.5rem)] pb-[clamp(1.75rem,3vw,2.75rem)]">
      <div class="shell max-w-[58rem]">
        <a class="inline-flex min-h-[24px] items-center gap-[0.4rem] font-mono text-[0.72rem] tracking-[0.08em] text-ink-faint no-underline hover:text-accent" href="/blog/">
          <ArrowLeft size="1em" aria-hidden="true" /> Blog
        </a>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <time class="font-mono text-[0.68rem] uppercase tracking-[0.08em] text-ink-faint" datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
          <span class="badge badge--accent">{AUDIENCE_LABEL[post.data.audience]}</span>
        </div>
        <h1 class="mt-4 max-w-[24ch] text-[clamp(1.9rem,1rem+3.1vw,3rem)]">{post.data.title}</h1>
        <p class="mt-[1.1rem] max-w-[60ch] text-[1.05rem]/[1.6] text-ink-soft">{post.data.summary}</p>
      </div>
    </header>

    <div class="shell grid grid-cols-1 items-start gap-[clamp(2rem,5vw,4.5rem)] py-[clamp(2.5rem,5vw,4rem)] lg:grid-cols-[minmax(0,1fr)_16rem]">
      <div class="prose"><Content /></div>

      <aside class="flex flex-col gap-7 lg:sticky lg:top-28">
        <div class="border-t border-rule-strong pt-4">
          <p class="label">En pratique</p>
          <p class="mt-[0.7rem] mb-[1.1rem] text-base text-ink-soft">
            Cet article décrit ce que je fais chez mes clients. Si vous préférez que je
            m'en occupe, la mise en place se règle en général en une intervention.
          </p>
          <a class="btn btn--cta" href="/contact/">Me confier ça <ArrowRight class="arrow" size="1.05em" aria-hidden="true" /></a>
        </div>

        <div class="border-t border-rule-strong pt-4">
          <p class="label">Voir aussi</p>
          <ul class="m-0 mt-[0.8rem] list-none p-0">
            <li class="border-b border-rule">
              <a class="block py-[0.7rem] text-[0.875rem] font-semibold tracking-[-0.015em] no-underline hover:text-accent" href={cible}>
                {post.data.audience === 'entreprise' ? 'Prestations entreprises' : 'Pour les particuliers'}
              </a>
            </li>
            {others.map((o) => (
              <li class="border-b border-rule">
                <a class="block py-[0.7rem] text-[0.875rem] font-semibold tracking-[-0.015em] no-underline hover:text-accent" href={`/blog/${o.id}/`}>{o.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </article>

  <CtaBand
    kicker="Après lecture"
    title="Une question qui reste ?"
    text="Écrivez-la telle quelle, y compris quand la réponse est que vous n'avez besoin de personne."
  />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</Base>
