---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { projets } from '../data/portfolio';

const etiq = { 'livré': 'Livré', 'maintenance': 'En maintenance', 'recherche': 'Recherche en cours' } as const;
const livres = projets.filter((p) => p.type !== 'recherche');
const rech = projets.filter((p) => p.type === 'recherche');
---
<Base
  title="Réalisations et travaux en cours · E Informatique"
  description="Interventions livrées chez des clients des Pyrénées-Orientales et travaux de recherche en cours : migration de parc, reprise de serveur, refonte de site."
>
  <PageHead
    kicker="Réalisations"
    title="Ce qui est livré, et ce qui est en train de se faire"
    lede="Deux catégories volontairement séparées. Les missions client sont terminées et mesurées. Les travaux de recherche sont affichés avec leur état réel, y compris quand il n'y a pas encore de conclusion."
  >
    <p class="gh mono">
      Dépôts publics :
      <a class="tlink" href="https://github.com/NetSo8" rel="noopener" target="_blank">github.com/NetSo8 ↗</a>
    </p>
  </PageHead>

  <section class="band">
    <div class="shell">
      <p class="sec-k label">01 / Missions client</p>
      <ol class="projets">
        {livres.map((p, i) => (
          <li class="pj" data-reveal>
            <div class="pj-h">
              <span class="pj-n mono">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2>{p.titre}</h2>
                <p class="pj-c mono">{p.client} · {p.annee}</p>
              </div>
              <span class:list={['pj-st', p.type]}>{etiq[p.type]}</span>
            </div>
            <div class="pj-b">
              <p class="pj-r">{p.resume}</p>
              <ul class="pj-f">
                {p.faits.map((f) => <li>{f}</li>)}
              </ul>
            </div>
            <p class="pj-s">
              {p.stack.map((s) => <span class="mono">{s}</span>)}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band rule nuitband">
    <div class="shell">
      <p class="sec-k label ork">02 / Travaux de recherche</p>
      <p class="rech-l">
        Non facturés, non finis, publiés quand même. Ils indiquent la direction que
        prend le travail technique sans prétendre qu'elle est déjà atteinte.
      </p>
      <ol class="projets projets--nuit">
        {rech.map((p, i) => (
          <li class="pj" data-reveal>
            <div class="pj-h">
              <span class="pj-n mono">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2>{p.titre}</h2>
                <p class="pj-c mono">{p.client} · {p.annee}</p>
              </div>
              <span class="pj-st recherche">{etiq[p.type]}</span>
            </div>
            <div class="pj-b">
              <p class="pj-r">{p.resume}</p>
              <ul class="pj-f">
                {p.faits.map((f) => <li>{f}</li>)}
              </ul>
            </div>
            <p class="pj-s">
              {p.stack.map((s) => <span class="mono">{s}</span>)}
              {p.lien && <a class="pj-l" href={p.lien.href}>{p.lien.label} →</a>}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand
    kicker="Votre cas"
    title="Un contexte proche du vôtre ?"
    text="Les chiffres ci-dessus viennent d'entreprises de moins de vingt personnes, avec un budget réel et des contraintes d'activité. Décrivez le vôtre, je vous dis franchement s'il ressemble à ce que je sais faire."
    second={{ href: '/labo/', label: 'Voir le labo technique' }}
  />
</Base>

<style>
  .gh { font-size: 0.72rem; color: var(--ink-faint); }
  .sec-k { color: var(--accent); margin-bottom: 2rem; }
  .ork { color: var(--accent-nuit); margin-bottom: 1rem; }
  .rech-l { color: var(--nuit-soft); max-width: 56ch; margin-bottom: 2.5rem; font-size: 0.95rem; }

  .projets { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule-strong); }
  .pj { padding: 2.25rem 0; border-bottom: 1px solid var(--rule); }
  .pj-h { display: grid; grid-template-columns: 3rem minmax(0, 1fr) auto; gap: 1rem; align-items: start; }
  .pj-n { color: var(--accent); font-weight: 600; font-size: 0.75rem; padding-top: 0.4rem; }
  .pj h2 { font-size: clamp(1.25rem, 1.05rem + 1vw, 1.85rem); letter-spacing: -0.032em; max-width: 30ch; }
  .pj-c { margin-top: 0.4rem; font-size: 0.72rem; color: var(--ink-faint); letter-spacing: 0.05em; }
  .pj-st {
    font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.2rem 0.55rem; border: 1px solid var(--rule-strong); color: var(--ink-soft); white-space: nowrap;
  }
  .pj-st.livré { border-color: var(--accent); color: var(--accent); }
  .pj-st.recherche { background: var(--state-warn); border-color: var(--state-warn); color: var(--fixed-nuit); font-weight: 600; }

  .pj-b { margin-top: 1.25rem; margin-left: 4rem; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem 3rem; align-items: start; }
  .pj-r { color: var(--ink-soft); font-size: 0.95rem; max-width: 50ch; }
  .pj-f { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule); }
  .pj-f li { padding: 0.6rem 0 0.6rem 1.2rem; border-bottom: 1px solid var(--rule); position: relative; font-size: 0.875rem; }
  .pj-f li::before { content: '›'; position: absolute; left: 0; color: var(--accent); }
  .pj-s { margin: 1.25rem 0 0 4rem; display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .pj-s .mono { font-size: 0.63rem; color: var(--ink-faint); border: 1px solid var(--rule); padding: 0.12rem 0.45rem; }
  .pj-l { margin-left: 0.6rem; font-size: 0.8rem; font-weight: 600; color: var(--accent); text-decoration: none; }
  .pj-l:hover { text-decoration: underline; }

  @media (max-width: 60rem) {
    .pj-h { grid-template-columns: 2.5rem 1fr; }
    .pj-st { grid-column: 2; justify-self: start; }
    .pj-b, .pj-s { margin-left: 0; }
    .pj-b { grid-template-columns: 1fr; }
  }

  .nuitband { background: var(--nuit); color: var(--nuit-text); border-top-color: var(--nuit); }
  .nuitband .projets { border-top-color: var(--rule-nuit); }
  .nuitband .pj { border-bottom-color: var(--rule-nuit); }
  .nuitband .pj-c, .nuitband .pj-s .mono { color: var(--nuit-faint); border-color: var(--rule-nuit); }
  .nuitband .pj-r { color: var(--nuit-soft); }
  .nuitband .pj-f, .nuitband .pj-f li { border-color: var(--rule-nuit); }
  .nuitband .pj-n, .nuitband .pj-f li::before, .nuitband .pj-l { color: var(--accent-nuit); }
</style>
