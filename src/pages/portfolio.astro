---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projets } from '../data/portfolio';

const livres = projets.filter((p) => p.type !== 'recherche');
const rech = projets.filter((p) => p.type === 'recherche');
---
<Base
  title="Réalisations et travaux en cours · E Informatique"
  description="Interventions livrées chez des clients des Pyrénées-Orientales et travaux de recherche en cours : migration de parc, reprise de serveur, refonte de site."
>
  <PageHead
    kicker="Réalisations"
    title="Ce qui est livré, et ce qui est en train de se faire"
    lede="Deux catégories volontairement séparées. Les missions client sont terminées et mesurées. Les travaux de recherche sont affichés avec leur état réel, y compris quand il n'y a pas encore de conclusion."
  >
    <p class="font-mono text-[0.72rem] text-ink-faint">
      Dépôts publics :
      <a class="tlink" href="https://github.com/NetSo8" rel="noopener" target="_blank">github.com/NetSo8 ↗</a>
    </p>
  </PageHead>

  <section class="py-band">
    <div class="shell">
      <p class="label mb-8 text-accent">01 / Missions client</p>
      <ol class="m-0 list-none border-t border-rule-strong p-0">
        {livres.map((p, i) => <ProjectCard projet={p} n={i + 1} />)}
      </ol>
    </div>
  </section>

  {/* Bande sombre : la recherche relève du registre du labo. */}
  <section class="bg-nuit py-band text-nuit-text">
    <div class="shell">
      <p class="label mb-4 text-accent-nuit">02 / Travaux de recherche</p>
      <p class="mb-10 max-w-[56ch] text-[0.95rem] text-nuit-soft">
        Non facturés, non finis, publiés quand même. Ils indiquent la direction que
        prend le travail technique sans prétendre qu'elle est déjà atteinte.
      </p>
      <ol class="m-0 list-none border-t border-rule-nuit p-0">
        {rech.map((p, i) => <ProjectCard projet={p} n={i + 1} nuit />)}
      </ol>
    </div>
  </section>

  <CtaBand
    kicker="Votre cas"
    title="Un contexte proche du vôtre ?"
    text="Les chiffres ci-dessus viennent d'entreprises de moins de vingt personnes, avec un budget réel et des contraintes d'activité. Décrivez le vôtre, je vous dis franchement s'il ressemble à ce que je sais faire."
    second={{ href: '/labo/', label: 'Voir le labo technique' }}
  />
</Base>
