---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import LayerStack from '../components/LayerStack.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { Image } from 'astro:assets';
import cote from '../assets/cote.jpg';

/* Le parcours, raconté couche par couche : chaque étape allume la couche
   correspondante de la pile 3D (LayerStack). Les couches sont de vrais
   niveaux d'abstraction, de ce que l'utilisateur touche jusqu'au
   processeur : « un étage plus bas » à chaque fois. */
const couches = ['Interface', 'Réseau', 'Service', 'Système', 'Matériel'];

const etapes = [
  {
    t: "J'ai commencé par ce que les gens voient.",
    d: "Le poste qui rame, le logiciel qui fait attendre. Ce début apprend une chose que le diplôme n'apprend pas : le problème décrit au téléphone n'est presque jamais le problème réel. Vérifier avant de conclure.",
    fil: "Aujourd'hui, je mets cette rigueur au service des PME : des logiciels Windows rapides, sur mesure, et des diagnostics de performance chiffrés.",
    liens: [
      { href: '/particuliers/', label: 'Pour les utilisateurs exigeants' },
      { href: '/professionnels/', label: 'Pour les entreprises' },
    ],
  },
  {
    t: "Puis le serveur, parce qu'il le fallait.",
    d: "Un projet demandait un site, puis un serveur pour l'héberger, puis des sauvegardes qui fonctionnent vraiment. Chaque couche s'apprend quand celle du dessus ne suffit plus.",
  },
  {
    t: 'Sous le site, le service qui répond.',
    d: "Pour le back-end, le Go : un seul binaire, peu de dépendances, un code qu'on relit sans effort. Le genre de logiciel qu'on oublie parce qu'il tient.",
  },
  {
    t: 'Plus bas, le C et Win32 : là où tout se paie.',
    d: "La mémoire qu'on alloue soi-même, le système qu'on appelle sans intermédiaire. C'est là que j'écris un petit langage de programmation, une bibliothèque graphique au-dessus de Win32, et des utilitaires système natifs.",
  },
  {
    t: "Tout en bas : l'assembleur, au plus près du processeur.",
    d: "C'est là que je veux aller, et là que je m'entraîne : écrire de l'assembleur x86-64 à la main, lire ce que le compilateur produit, comprendre les registres, les caches et les instructions vectorielles. Une bibliothèque d'algèbre linéaire poussée jusqu'à la machine, et un petit moteur d'inférence pour modèles d'IA bâti dessus, servent de terrain d'essai.",
    fil: "Ma vision : faire du bas niveau mon métier. Comprendre la couche du dessous, puis écrire l'outil qui manquait, plutôt que d'empiler des logiciels déjà lourds. Pour vous, cela donne des programmes plus rapides et plus légers.",
    note: "L'assembleur est un apprentissage en cours, pas un acquis. Rien n'est présenté comme maîtrisé tant que ce n'est pas publié, mesuré et vérifiable. Le blog en rendra compte.",
  },
];

const principes = [
  { t: "Le prix avant de commencer", d: "Rien ne démarre avant d'avoir annoncé ce que je fais, le temps que cela prend et ce que cela coûte." },
  { t: 'Documenter ce que je laisse', d: "Code, notes et mesures sont remis par écrit. Un autre développeur peut reprendre sans repartir de zéro." },
  { t: "Dire quand ce n'est pas pour moi", d: "Hors de mon périmètre, je vous oriente plutôt que d'apprendre à vos frais." },
  { t: "Mesurer plutôt qu'affirmer", d: "Ce qui n'est pas mesuré ne va ni dans un rapport, ni sur ce site." },
];
---
<Base
  title="À propos · Elian, ingénieur logiciel à Rivesaltes"
  description="Elian, ingénieur logiciel à Rivesaltes (66) : logiciels Windows rapides et sur mesure pour les PME, et une vision tournée vers le bas niveau et l'assembleur."
>
  <!-- ─── Récit en couches : texte qui défile, pile 3D fixe ─────── -->
  <section class="relative isolate overflow-x-clip">
    <div class="pointer-events-none absolute inset-x-0 -top-28 -z-10 h-[36rem] bg-[radial-gradient(75%_65%_at_20%_0%,var(--color-accent-wash),transparent_75%)]" aria-hidden="true"></div>

    <div class="shell grid grid-cols-1 gap-x-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div class="pt-[clamp(2.5rem,5vw,4.5rem)]">
        <div class="lg:flex lg:min-h-[calc(100dvh-7rem)] lg:flex-col lg:justify-center lg:pb-24">
          <p class="chip rise self-start pl-[0.8rem]" style="--i:0">À propos</p>
          <h1 class="rise mt-6 max-w-[16ch] text-[clamp(2.4rem,1.1rem+3.8vw,4.2rem)]/[1.02]" style="--i:1">Un ingénieur, une vision : le bas niveau.</h1>
          <p class="rise mt-6 max-w-[44ch] text-lede/[1.5] text-ink-soft" style="--i:2">
            Je m'appelle Elian. Je travaille seul : vous avez un interlocuteur unique, et
            tout ce que je laisse derrière moi peut être repris par n'importe qui.
            Mon but : faire du bas niveau, jusqu'à l'assembleur, pour écrire des logiciels Windows plus rapides et plus légers.
          </p>
        </div>

        {/* Pile 3D sur mobile : en tête du récit, sans rester collée. */}
        <LayerStack couches={couches} class="my-8 h-[22rem] lg:hidden" />

        <ol class="m-0 list-none p-0 pb-[var(--spacing-band)]">
          {etapes.map((e, i) => (
            <li class="etape relative border-l-2 border-rule py-6 pl-6 lg:flex lg:min-h-[72dvh] lg:flex-col lg:justify-center lg:py-0" data-couche={i}>
              <p class="font-mono text-[0.8rem] font-semibold uppercase tracking-[0.12em] text-accent">
                <span aria-hidden="true">{String(i + 1).padStart(2, '0')} · </span>{couches[i]}
              </p>
              <h2 class="mt-3 max-w-[20ch] text-[clamp(1.6rem,1.1rem+1.8vw,2.5rem)]/[1.08] tracking-[-0.035em]">{e.t}</h2>
              <p class="mt-4 max-w-[46ch] text-[1.05rem]/[1.65] text-ink-soft">{e.d}</p>
              {e.fil && <p class="mt-4 max-w-[46ch] text-[1.05rem]/[1.65] text-ink">{e.fil}</p>}
              {e.liens && (
                <p class="mt-6 flex flex-wrap gap-3">
                  {e.liens.map((l) => (
                    <a class="btn btn--ghost" href={l.href}>{l.label} <ArrowRight class="arrow" size="1em" aria-hidden="true" /></a>
                  ))}
                </p>
              )}
              {e.note && <p class="mt-5 max-w-[46ch] rounded-[var(--radius-md)] bg-accent-wash px-4 py-3 text-[0.95rem] text-ink">{e.note}</p>}
            </li>
          ))}
        </ol>
      </div>

      {/* Pile 3D sur grand écran : collée pendant tout le récit. */}
      <div class="hidden lg:block">
        <LayerStack couches={couches} class="sticky top-20 h-[calc(100dvh-6rem)]" />
      </div>
    </div>
  </section>

  <!-- ─── Principes : panneau sombre, quatre phrases ────────────── -->
  <section class="pb-[var(--spacing-band)]">
    <div class="shell">
      <div class="panel on-nuit border-transparent bg-nuit px-[clamp(1.4rem,4.5vw,4rem)] py-[clamp(2.5rem,5vw,4.5rem)] text-ink">
        <SectionHead title="Quatre principes qui tiennent depuis le début" />
        <ul class="m-0 mt-12 grid list-none grid-cols-1 gap-x-12 gap-y-10 p-0 md:grid-cols-2">
          {principes.map((p, i) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-4" data-reveal>
              <span class="font-mono text-[1.1rem] font-semibold text-accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-[1.3rem]/[1.2] tracking-[-0.028em]">{p.t}</h3>
                <p class="mt-2 max-w-[40ch] text-base text-ink-soft">{p.d}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ─── Pourquoi ici ────────────────────────────────────────── -->
  <section class="section section-rule">
    <div class="shell grid grid-cols-1 items-center gap-x-16 gap-y-10 lg:grid-cols-2">
      <figure class="m-0 overflow-hidden rounded-[var(--radius-xl)]">
        <Image
          src={cote}
          alt="Mains sur le clavier d'un ordinateur portable pendant une session de travail"
          loading="lazy"
          decoding="async"
          widths={[560, 900, 1300]}
          sizes="(width >= 62rem) 48vw, 100vw"
          quality={68}
          class="aspect-3/2 w-full rounded-none object-cover saturate-[0.82]"
        />
      </figure>
      <div>
        <SectionHead title="Basé à Rivesaltes, au service des PME" />
        <p class="mt-5 max-w-[46ch] text-lede/[1.5] text-ink-soft">
          Je travaille à distance avec des entreprises de toute la France, et sur place dans le Roussillon quand c'est utile. Dans les deux cas, vous parlez directement à la personne qui écrit le code.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Le plus simple : décrire votre situation."
    text="PME ou utilisateur exigeant, la première réponse est toujours la même : un avis honnête, et un ordre de prix. Ensuite, vous décidez."
  />
</Base>

<style>
  /* Étape en cours : le filet de gauche passe à l'accent. Le texte ne
     s'éteint jamais autour, il reste lisible à pleine intensité. */
  .etape { transition: border-color 0.3s ease; }
  .etape.is-active { border-color: var(--color-accent); }
</style>
