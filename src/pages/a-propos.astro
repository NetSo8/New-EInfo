---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import LayerStack from '../components/LayerStack.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { Image } from 'astro:assets';
import cote from '../assets/cote.jpg';

/* Le parcours, raconté couche par couche */
const couches = ['Matériel', 'Système', 'Réseau', 'Web & Outils', 'Proximité'];

const etapes = [
  {
    t: "Le matériel : remettre en état plutôt que jeter.",
    d: "Un composant en panne, un disque dur d'origine essoufflé, une surchauffe : dans la grande majorité des cas, un diagnostic précis et le remplacement d'une seule pièce (comme un passage sur SSD) redonne plusieurs années de vie à votre ordinateur sans racheter de machine neuve.",
    fil: "Mon approche : réparer ce qui peut l'être avec bon sens et rentabilité pour vous.",
  },
  {
    t: "Le système : un environnement propre et réactif.",
    d: "Windows et macOS s'encrassent vite : logiciels publicitaires indésirables, pilotes mal réglés, lenteurs au démarrage. Je nettoie le système, élimine les logiciels parasites et sécurise vos accès pour que votre outil de travail ou de maison réponde instantanément.",
  },
  {
    t: "Le réseau : connecter vos équipements sans prise de tête.",
    d: "Box internet, partage Wi-Fi dans toute la maison, imprimante en réseau, sauvegardes automatiques. Je configure vos appareils pour qu'ils fonctionnent ensemble de manière fluide et transparente au quotidien.",
  },
  {
    t: "Le web & les outils : une présence locale claire et efficace.",
    d: "Pour les artisans et petites entreprises, concevoir un site web sobre, rapide et bien référencé sur Google Maps est essentiel. Pas de complication technique : je crée votre vitrine en ligne et m'occupe du suivi pour que vos clients locaux vous appellent directement.",
    fil: "Deux activités complémentaires : dépanner vos postes informatiques et valoriser votre savoir-faire sur internet.",
    liens: [
      { href: '/particuliers/', label: 'Services Particuliers' },
      { href: '/professionnels/', label: 'Services Professionnels' },
    ],
  },
  {
    t: "La proximité : un artisan informatique à vos côtés.",
    d: "Je travaille en indépendant : vous avez un contact direct, qui se déplace chez vous ou vous reçoit en atelier, sans intermédiaire ni ticket de support impersonnel. Tout ce qui est fait est documenté et vos accès restent toujours chez vous.",
    note: "Un engagement simple : le prix est annoncé avant de commencer, et si une réparation ne vaut pas son coût, je vous le dis franchement.",
  },
];

const principes = [
  { t: 'Le prix annoncé avant de commencer', d: "Rien ne démarre sans votre accord préalable sur le temps et le coût." },
  { t: 'Des explications en français', d: "Pas de jargon technique pour faire savant. Tout est expliqué simplement." },
  { t: 'Vos accès restent chez vous', d: "Vos comptes, vos mots de passe et vos fichiers vous appartiennent." },
  { t: 'Transparence et bon sens', d: "Si réparer coûte plus cher que racheter, je vous le dis franchement." },
];
---
<Base
  title="À propos · Elian Brodhag, informaticien à Rivesaltes (66)"
  description="À propos d'E Informatique (Elian Brodhag) : artisan informaticien à Rivesaltes. Dépannage informatique de proximité et création de sites web locaux dans les Pyrénées-Orientales."
>
  <!-- ─── Récit en couches : texte qui défile, pile 3D fixe ─────── -->
  <section class="relative isolate overflow-x-clip">
    <div class="pointer-events-none absolute inset-x-0 -top-28 -z-10 h-[36rem] bg-[radial-gradient(75%_65%_at_20%_0%,var(--color-accent-wash),transparent_75%)]" aria-hidden="true"></div>

    <div class="shell grid grid-cols-1 gap-x-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div class="pt-[clamp(2.5rem,5vw,4.5rem)]">
        <div class="lg:flex lg:min-h-[calc(100dvh-7rem)] lg:flex-col lg:justify-center lg:pb-24">
          <p class="chip rise self-start pl-[0.8rem]" style="--i:0">À propos</p>
          <h1 class="rise mt-6 max-w-[16ch] text-[clamp(2.4rem,1.1rem+3.8vw,4.2rem)]/[1.02]" style="--i:1">Un artisan de proximité pour votre informatique.</h1>
          <p class="rise mt-6 max-w-[44ch] text-lede/[1.5] text-ink-soft" style="--i:2">
            Je m'appelle Elian Brodhag (E Informatique). Je travaille en indépendant à Rivesaltes auprès des particuliers, des artisans et des TPE du Roussillon.
            Mon rôle : être votre contact unique pour réparer vos ordinateurs, fiabiliser votre matériel et faire rayonner votre activité sur internet.
          </p>
        </div>

        {/* Pile 3D sur mobile : en tête du récit, sans rester collée. */}
        <LayerStack couches={couches} class="my-8 h-[22rem] lg:hidden" />

        <ol class="m-0 list-none p-0 pb-[var(--spacing-band)]">
          {etapes.map((e, i) => (
            <li class="etape relative border-l-2 border-rule py-6 pl-6 lg:flex lg:min-h-[72dvh] lg:flex-col lg:justify-center lg:py-0" data-couche={i}>
              <p class="font-mono text-[0.8rem] font-semibold uppercase tracking-[0.12em] text-accent">
                <span aria-hidden="true">{String(i + 1).padStart(2, '0')} · </span>{couches[i]}
              </p>
              <h2 class="mt-3 max-w-[20ch] text-[clamp(1.6rem,1.1rem+1.8vw,2.5rem)]/[1.08] tracking-[-0.035em]">{e.t}</h2>
              <p class="mt-4 max-w-[46ch] text-[1.05rem]/[1.65] text-ink-soft">{e.d}</p>
              {e.fil && <p class="mt-4 max-w-[46ch] text-[1.05rem]/[1.65] text-ink">{e.fil}</p>}
              {e.liens && (
                <p class="mt-6 flex flex-wrap gap-3">
                  {e.liens.map((l) => (
                    <a class="btn btn--ghost" href={l.href}>{l.label} <ArrowRight class="arrow" size="1em" aria-hidden="true" /></a>
                  ))}
                </p>
              )}
              {e.note && <p class="mt-5 max-w-[46ch] rounded-[var(--radius-md)] bg-accent-wash px-4 py-3 text-[0.95rem] text-ink">{e.note}</p>}
            </li>
          ))}
        </ol>
      </div>

      {/* Pile 3D sur grand écran : collée pendant tout le récit. */}
      <div class="hidden lg:block">
        <LayerStack couches={couches} class="sticky top-20 h-[calc(100dvh-6rem)]" />
      </div>
    </div>
  </section>

  <!-- ─── Principes : panneau sombre, quatre phrases ────────────── -->
  <section class="pb-[var(--spacing-band)]">
    <div class="shell">
      <div class="panel on-nuit border-transparent bg-nuit px-[clamp(1.4rem,4.5vw,4rem)] py-[clamp(2.5rem,5vw,4.5rem)] text-ink">
        <SectionHead title="Quatre engagements qui guident chaque journée" />
        <ul class="m-0 mt-12 grid list-none grid-cols-1 gap-x-12 gap-y-10 p-0 md:grid-cols-2">
          {principes.map((p, i) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-4" data-reveal>
              <span class="font-mono text-[1.1rem] font-semibold text-accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-[1.3rem]/[1.2] tracking-[-0.028em]">{p.t}</h3>
                <p class="mt-2 max-w-[40ch] text-base text-ink-soft">{p.d}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ─── Pourquoi ici ────────────────────────────────────────── -->
  <section class="section section-rule">
    <div class="shell grid grid-cols-1 items-center gap-x-16 gap-y-10 lg:grid-cols-2">
      <figure class="m-0 overflow-hidden rounded-[var(--radius-xl)]">
        <Image
          src={cote}
          alt="Intervention informatique de précision sur ordinateur portable à Rivesaltes"
          loading="lazy"
          decoding="async"
          widths={[560, 900, 1300]}
          sizes="(width >= 62rem) 48vw, 100vw"
          quality={68}
          class="aspect-3/2 w-full rounded-none object-cover saturate-[0.82]"
        />
      </figure>
      <div>
        <SectionHead title="Rivesaltes et les Pyrénées-Orientales" />
        <p class="mt-5 max-w-[46ch] text-lede/[1.5] text-ink-soft">
          Être à proximité immédiate change tout : un ordinateur qui refuse de démarrer, une panne bloquante ou un site web à construire autour d'un café demandent un artisan disponible, sur place et réactif.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Besoin d'un dépannage ou d'un site web ?"
    text="Particulier, artisan ou commerçant : appelez-moi ou écrivez-moi. Je vous donne un premier avis honnête et une estimation claire, sans engagement."
  />
</Base>

<style>
  .etape { transition: border-color 0.3s ease; }
  .etape.is-active { border-color: var(--color-accent); }
</style>
