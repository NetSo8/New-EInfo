---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
---
<Base noindex title="Page introuvable · E Informatique" description="Cette adresse ne correspond à aucune page du site.">
  <section class="section">
    <div class="shell grid min-h-[48vh] grid-cols-1 items-center gap-[clamp(2rem,5vw,4rem)] mid:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
      <div>
        <p class="label text-accent">Erreur 404</p>
        <h1 class="mt-4 text-[clamp(2rem,1rem+3.2vw,3.25rem)]">Cette page n'existe pas.</h1>
        <p class="mt-[1.15rem] max-w-[46ch] text-lede/[1.5] text-ink-soft">
          Le lien est faux, la page a été renommée, ou elle n'a jamais existé.
          Dans les trois cas, ce n'est pas votre faute.
        </p>
        <nav class="mt-8 flex flex-wrap gap-[0.6rem]" aria-label="Pages principales">
          <a class="btn btn--cta" href="/">Retour à l'accueil</a>
          <a class="btn btn--ghost" href="/particuliers/">Particuliers</a>
          <a class="btn btn--ghost" href="/professionnels/">Entreprises</a>
          <a class="btn btn--ghost" href="/contact/">Contact</a>
        </nav>
      </div>
      <Terminal
        title="trace : résolution du chemin"
        lines={[
          { k: 'cmd', t: 'curl -sI https://$HOST$URI' },
          { k: 'ok', t: 'dns      A 5 ms · enregistrement résolu' },
          { k: 'ok', t: 'tls      TLS 1.3 · chaîne complète, certificat valide' },
          { k: 'warn', t: 'http     404 not found' },
          { k: 'out', t: 'cause    lien obsolète ou faute de frappe dans l\'URL' },
          { k: 'dim', t: 'le serveur répond : c\'est le chemin qui n\'existe pas.' },
        ]}
      />
    </div>
  </section>
</Base>
