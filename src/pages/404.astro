---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
---
<Base noindex title="Page introuvable | E Informatique" description="Cette adresse ne correspond à aucune page du site.">
  <section class="band">
    <div class="shell nf">
      <div>
        <p class="label nf-k">Erreur 404</p>
        <h1>Cette page n'existe pas.</h1>
        <p class="lede">
          Le lien est faux, la page a été renommée, ou elle n'a jamais existé.
          Dans les trois cas, ce n'est pas votre faute.
        </p>
        <nav class="nf-l" aria-label="Pages principales">
          <a class="btn btn--cta" href="/">Retour à l'accueil</a>
          <a class="btn btn--ghost" href="/particuliers/">Particuliers</a>
          <a class="btn btn--ghost" href="/professionnels/">Entreprises</a>
          <a class="btn btn--ghost" href="/contact/">Contact</a>
        </nav>
      </div>
      <Terminal
        title="resolve : chemin demandé"
        lines={[
          { k: 'cmd', t: 'resolve $URI' },
          { k: 'warn', t: 'statut         404 not found' },
          { k: 'out', t: 'cause probable lien obsolète ou faute de frappe' },
          { k: 'ok', t: 'site           en ligne, rien de cassé' },
        ]}
      />
    </div>
  </section>
</Base>

<style>
  .nf { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; min-height: 48vh; }
  @media (max-width: 60rem) { .nf { grid-template-columns: 1fr; } }
  .nf-k { color: var(--accent); }
  .nf h1 { margin-top: 1rem; font-size: clamp(2rem, 1rem + 3.2vw, 3.25rem); }
  .nf .lede { margin-top: 1.15rem; }
  .nf-l { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
