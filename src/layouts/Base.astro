---
import '../styles/app.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { services, lienService } from '../data/services';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://einformatique.fr').href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://einformatique.fr/#business',
  name: 'E Informatique',
  description:
    "Technicien informatique freelance à Rivesaltes : dépannage et assistance pour les particuliers, formation à l'usage de l'IA grand public, création et maintenance de sites, et relecture de code généré par IA pour les TPE/PME des Pyrénées-Orientales.",
  url: 'https://einformatique.fr',
  image: 'https://einformatique.fr/logo.png',
  logo: 'https://einformatique.fr/logo.png',
  founder: { '@type': 'Person', name: 'Elian', jobTitle: 'Technicien informatique · formation et sécurité IA' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rivesaltes',
    postalCode: '66600',
    addressRegion: 'Pyrénées-Orientales',
    addressCountry: 'FR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 42.7706, longitude: 2.8722 },
  areaServed: [
    { '@type': 'City', name: 'Rivesaltes' },
    { '@type': 'City', name: 'Perpignan' },
    { '@type': 'City', name: 'Cabestany' },
    { '@type': 'City', name: 'Le Barcarès' },
    { '@type': 'City', name: 'Baixas' },
    { '@type': 'City', name: 'Salses-le-Château' },
  ],
  knowsAbout: [
    'Dépannage informatique',
    "Formation à l'usage de l'intelligence artificielle",
    'Création et maintenance de site web',
    'Relecture et sécurité du code généré par IA',
    'Harnais de sécurité pour agents IA',
    'Cryptographie appliquée',
    'Cryptographie post-quantique',
    'Confidential computing',
  ],
  sameAs: ['https://github.com/NetSo8'],
  // Catalogue des prestations, chacune reliée à sa page de référence : c'est
  // ce qui remplace l'ancienne liste de `Service` de la page /services/.
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Prestations',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: s.titre,
        description: s.resume,
        url: `https://einformatique.fr${lienService(s)}`,
        areaServed: 'Pyrénées-Orientales, France',
      },
    })),
  },
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f8f8" />
    <meta name="color-scheme" content="light dark" />

    <!-- Thème : résolu avant le premier rendu, pour éviter tout flash. -->
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        const stored = (() => { try { return localStorage.getItem('theme'); } catch { return null; } })();
        const dark = stored ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        if (!stored) document.documentElement.dataset.themeSource = 'system';

        /* Même principe pour le mouvement : appliqué avant le premier rendu,
           sinon les fonds démarrent leur boucle avant d'être coupés. */
        try {
          const motion = localStorage.getItem('motion');
          if (motion === 'reduced' || motion === 'full') {
            document.documentElement.dataset.motion = motion;
          }
        } catch {}
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="E Informatique" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/logo.png', Astro.site ?? 'https://einformatique.fr').href} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    {/* Polices servies depuis ce serveur : aucune requête vers un tiers, donc
        aucune adresse IP de visiteur transmise hors de l'hébergement. Les deux
        fichiers ci-dessous portent le texte visible dès le premier rendu. */}
    <link rel="preload" href="/fonts/satoshi-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(business)} />
  </head>
  <body>
    <a class="skip" href="#main">Aller au contenu</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Suit le système tant que le visiteur n'a pas tranché lui-même.
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (document.documentElement.dataset.themeSource !== 'system') return;
        document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
        document.dispatchEvent(new CustomEvent('themechange'));
      });
    </script>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('revealed');
              io.unobserve(e.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el, i) => {
        (el as HTMLElement).style.setProperty('--d', `${(i % 6) * 70}ms`);
        io.observe(el);
      });

      // Mises en scène jouées une seule fois à l'arrivée dans l'écran
      // (radar, filets qui se tracent…) : la classe `in-view` les déclenche.
      const vu = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('in-view');
          vu.unobserve(e.target);
        }),
        { threshold: 0.3 }
      );
      document.querySelectorAll('[data-inview]').forEach((el) => vu.observe(el));

      // Fonds et schémas animés en boucle : en pause dès qu'ils quittent
      // l'écran, relancés quand ils y reviennent.
      const decor = new IntersectionObserver((entries) => {
        entries.forEach((e) => e.target.classList.toggle('is-offscreen', !e.isIntersecting));
      });
      document.querySelectorAll('.hero-mesh, .crack-bg, .world-bg, [data-decor]').forEach((el) => decor.observe(el));

      // ── Effets au pointeur ─────────────────────────────────────
      // Réservés à la souris (inutiles au doigt) et coupés si la personne
      // a demandé moins de mouvement, par son système ou par le site.
      const root = document.documentElement;
      const calme = () =>
        root.dataset.motion === 'reduced' ||
        (root.dataset.motion !== 'full' && matchMedia('(prefers-reduced-motion: reduce)').matches);
      const souris = matchMedia('(hover: hover) and (pointer: fine)').matches;

      if (souris) {
        // Halo des cartes : position du pointeur dans la carte, en variables CSS.
        document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', `${e.clientX - r.left}px`);
            el.style.setProperty('--my', `${e.clientY - r.top}px`);
          });
        });

        // Profondeur : l'élément glisse de quelques pixels à l'opposé du
        // pointeur, avec un amorti pour qu'il suive sans coller à la souris.
        document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
          const force = Number(el.dataset.parallax) || 10;
          const zone = el.closest('section') ?? el;
          let cx = 0, cy = 0, tx = 0, ty = 0, raf = 0;
          const pas = () => {
            cx += (tx - cx) * 0.08;
            cy += (ty - cy) * 0.08;
            el.style.setProperty('--px', `${cx.toFixed(2)}px`);
            el.style.setProperty('--py', `${cy.toFixed(2)}px`);
            raf = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.05 ? requestAnimationFrame(pas) : 0;
          };
          const viser = (x: number, y: number) => {
            tx = x; ty = y;
            if (!raf) raf = requestAnimationFrame(pas);
          };
          zone.addEventListener('pointermove', (e) => {
            if (calme()) return;
            const r = zone.getBoundingClientRect();
            viser(-((e.clientX - r.left) / r.width - 0.5) * force, -((e.clientY - r.top) / r.height - 0.5) * force);
          });
          zone.addEventListener('pointerleave', () => viser(0, 0));
        });
      }
    </script>
  </body>
</html>
