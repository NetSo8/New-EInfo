---
import '../styles/base.css';
import '../styles/prose.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Fil d'audience affiché dans la barre d'état : particulier | pro | labo | null */
  track?: 'particulier' | 'pro' | 'labo' | null;
  /** Registre visuel. Le labo bascule en encre sombre. */
  theme?: 'paper' | 'nuit';
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, track = null, noindex = false, theme = 'paper' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://einformatique.fr').href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://einformatique.fr/#business',
  name: 'E Informatique',
  description:
    "Technicien informatique freelance à Rivesaltes : dépannage, infrastructure VPS, sécurité et sites web pour particuliers et TPE/PME des Pyrénées-Orientales.",
  url: 'https://einformatique.fr',
  founder: { '@type': 'Person', name: 'Elian', jobTitle: 'Technicien systèmes et réseaux' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rivesaltes',
    postalCode: '66600',
    addressRegion: 'Pyrénées-Orientales',
    addressCountry: 'FR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 42.7706, longitude: 2.8722 },
  areaServed: [
    { '@type': 'City', name: 'Rivesaltes' },
    { '@type': 'City', name: 'Perpignan' },
    { '@type': 'City', name: 'Canet-en-Roussillon' },
    { '@type': 'City', name: 'Saint-Cyprien' },
    { '@type': 'City', name: 'Cabestany' },
    { '@type': 'AdministrativeArea', name: 'Pyrénées-Orientales' },
  ],
  knowsAbout: ['Dépannage informatique', 'Administration système Linux', 'Sécurité informatique', 'Hébergement VPS', 'Création de site web'],
  priceRange: '€€',
  sameAs: ['https://github.com/NetSo8'],
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={theme === 'nuit' ? '#22201c' : '#f6f1e7'} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="E Informatique" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400..800&family=Spline+Sans+Mono:wght@400;500;600&display=swap"
    />
    <link rel="preconnect" href="https://images.unsplash.com" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(business)} />
  </head>
  <body class:list={[{ 't-nuit': theme === 'nuit' }]}>
    <a class="skip" href="#main">Aller au contenu</a>
    <Nav track={track} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('revealed');
              io.unobserve(e.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el, i) => {
        (el as HTMLElement).style.setProperty('--d', `${(i % 6) * 70}ms`);
        io.observe(el);
      });
    </script>
  </body>
</html>
