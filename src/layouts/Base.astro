---
import '../styles/app.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://einformatique.fr').href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://einformatique.fr/#business',
  name: 'E Informatique',
  description:
    "Technicien réseau et sécurité freelance à Rivesaltes : dépannage informatique pour les particuliers, réseau local, segmentation VLAN, pare-feu, VPN, sauvegardes testées et sites web pour les TPE/PME des Pyrénées-Orientales.",
  url: 'https://einformatique.fr',
  founder: { '@type': 'Person', name: 'Elian', jobTitle: 'Technicien réseau et sécurité' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rivesaltes',
    postalCode: '66600',
    addressRegion: 'Pyrénées-Orientales',
    addressCountry: 'FR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 42.7706, longitude: 2.8722 },
  areaServed: [
    { '@type': 'City', name: 'Rivesaltes' },
    { '@type': 'City', name: 'Perpignan' },
    { '@type': 'City', name: 'Cabestany' },
    { '@type': 'City', name: 'Le Barcarès' },
    { '@type': 'City', name: 'Baixas' },
    { '@type': 'City', name: 'Salses-le-Château' },
  ],
  knowsAbout: [
    'Réseau informatique',
    'Segmentation VLAN',
    'Pare-feu et filtrage réseau',
    'VPN et accès distant sécurisé',
    'Réseau sans fil et couverture wifi',
    'Sécurité informatique et sauvegardes',
    'Dépannage informatique',
    'Création et maintenance de site web',
    'Cryptographie appliquée',
  ],
  sameAs: ['https://github.com/NetSo8'],
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f8f8" />

    <!-- Thème : résolu avant le premier rendu, pour éviter tout flash. -->
    <script is:inline>
      (() => {
        const stored = (() => { try { return localStorage.getItem('theme'); } catch { return null; } })();
        const dark = stored ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        if (!stored) document.documentElement.dataset.themeSource = 'system';

        /* Même principe pour le mouvement : appliqué avant le premier rendu,
           sinon les fonds démarrent leur boucle avant d'être coupés. */
        try {
          const motion = localStorage.getItem('motion');
          if (motion === 'reduced' || motion === 'full') {
            document.documentElement.dataset.motion = motion;
          }
        } catch {}
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="E Informatique" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/logo.png', Astro.site ?? 'https://einformatique.fr').href} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    {/* Polices servies depuis ce serveur : aucune requête vers un tiers, donc
        aucune adresse IP de visiteur transmise hors de l'hébergement. Les deux
        fichiers ci-dessous portent le texte visible dès le premier rendu. */}
    <link rel="preload" href="/fonts/satoshi-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(business)} />
  </head>
  <body>
    <a class="skip" href="#main">Aller au contenu</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Suit le système tant que le visiteur n'a pas tranché lui-même.
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (document.documentElement.dataset.themeSource !== 'system') return;
        document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
        document.dispatchEvent(new CustomEvent('themechange'));
      });
    </script>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('revealed');
              io.unobserve(e.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el, i) => {
        (el as HTMLElement).style.setProperty('--d', `${(i % 6) * 70}ms`);
        io.observe(el);
      });
    </script>
  </body>
</html>
