---
interface Line { k: 'cmd' | 'out' | 'ok' | 'warn' | 'dim'; t: string }
interface Props { title?: string; lines: Line[]; caption?: string }
const { title = 'elian@e-informatique : zsh', lines, caption } = Astro.props;

/* Le registre du terminal est fixe : il ne suit pas le thème de la page. */
const tone: Record<Line['k'], string> = {
  cmd: 'text-nuit-text',
  out: 'text-nuit-soft',
  dim: 'text-nuit-faint',
  ok: 'text-accent-nuit',
  warn: 'text-state-warn',
};
---
<figure class="m-0 overflow-hidden rounded-lg border border-nuit-2 bg-nuit">
  <div class="flex items-center gap-[0.7rem] border-b border-nuit-3 bg-nuit-2 px-[0.85rem] py-[0.55rem]">
    <span class="flex gap-[5px]" aria-hidden="true">
      <i class="size-[9px] rounded-full bg-accent-nuit"></i>
      <i class="size-[9px] rounded-full bg-nuit-3"></i>
      <i class="size-[9px] rounded-full bg-nuit-3"></i>
    </span>
    <span class="font-mono text-[0.68rem] text-nuit-faint">{title}</span>
  </div>

  <pre class="m-0 overflow-x-auto px-[1.15rem] pt-[1.15rem] pb-[1.3rem] font-mono text-[0.775rem]/[1.85] text-nuit-text"><code>{lines.map((l) => (
    <span class:list={['block break-words whitespace-pre-wrap', tone[l.k]]}>{l.k === 'cmd' ? <span class="mr-[0.6rem] font-semibold text-accent-nuit">$</span> : null}{l.t}{'\n'}</span>
  ))}<span class="block"><span class="mr-[0.6rem] font-semibold text-accent-nuit">$</span><span class="inline-block h-[1em] w-[8px] animate-blink bg-accent-nuit align-[-0.15em]" aria-hidden="true"></span></span></code></pre>

  {caption && (
    <figcaption class="border-t border-nuit-2 px-[1.15rem] py-[0.65rem] font-mono text-[0.66rem] text-nuit-faint">{caption}</figcaption>
  )}
</figure>
