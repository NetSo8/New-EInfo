---
interface Line { k: 'cmd' | 'out' | 'ok' | 'warn' | 'dim'; t: string }
interface Props { title?: string; lines: Line[]; caption?: string }
const { title = 'elian@e-informatique : zsh', lines, caption } = Astro.props;
---
<figure class="term">
  <div class="term-bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="term-t">{title}</span>
  </div>
  <pre class="term-body"><code>{lines.map((l) => (
    <span class:list={['ln', l.k]}>{l.k === 'cmd' ? <span class="pr">$</span> : null}{l.t}{'\n'}</span>
  ))}<span class="ln cmd"><span class="pr">$</span><span class="cur" aria-hidden="true"></span></span></code></pre>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .term { background: var(--nuit); border: 1px solid var(--nuit-2); border-radius: 4px; overflow: hidden; margin: 0; }
  .term-bar {
    display: flex; align-items: center; gap: 0.7rem;
    padding: 0.55rem 0.85rem; background: var(--nuit-2);
    border-bottom: 1px solid var(--nuit-3);
  }
  .dots { display: flex; gap: 5px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--nuit-3); }
  .dots i:first-child { background: var(--grenat-hi); }
  .term-t { font-family: var(--mono); font-size: 0.68rem; color: var(--nuit-faint); }
  .term-body {
    margin: 0; padding: 1.15rem 1.15rem 1.3rem;
    font-family: var(--mono); font-size: 0.775rem; line-height: 1.85;
    color: var(--nuit-text); overflow-x: auto;
  }
  .ln { display: block; white-space: pre-wrap; word-break: break-word; }
  .pr { color: oklch(0.735 0.150 28); margin-right: 0.6rem; font-weight: 600; }
  .out { color: var(--nuit-soft); }
  .dim { color: var(--nuit-faint); }
  .ok { color: var(--jade); }
  .warn { color: var(--or); }
  .cur { display: inline-block; width: 8px; height: 1em; background: var(--jade); vertical-align: -0.15em; animation: bl 1.1s steps(2) infinite; }
  @keyframes bl { 50% { opacity: 0 } }
  figcaption { padding: 0.65rem 1.15rem; border-top: 1px solid var(--nuit-2); font-family: var(--mono); font-size: 0.66rem; color: var(--nuit-faint); }
</style>
