---
import { Image } from 'astro:assets';
/* Le logo source fait 395px : servi tel quel, il pesait 16 Ko pour 28px
   affichés. Astro en tire une version 28 et 56px (écrans denses). */
import logo from '../assets/logo.png';
import Menu from '@lucide/astro/icons/menu';
import Moon from '@lucide/astro/icons/moon';
import Sun from '@lucide/astro/icons/sun';
import X from '@lucide/astro/icons/x';

const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/particuliers/', label: 'Particuliers' },
  { href: '/professionnels/', label: 'Entreprises' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/blog/', label: 'Blog' },
  { href: '/a-propos/', label: 'À propos' },
];
const isOn = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="sticky top-0 z-50 pt-3">
  {/* Barre flottante : une pilule posée au-dessus de la page, plutôt
      qu'un bandeau collé au bord. Le lieu, qui tenait dans un bandeau
      d'état, est désormais porté par le haut de chaque page. */}
  <div class="shell relative">
    <div class="flex h-[60px] items-center gap-3 rounded-full xl:gap-5 border border-rule bg-paper/82 pr-2 pl-5 shadow-[var(--shadow-raise)] backdrop-blur-[12px] backdrop-saturate-150">
      <a class="flex flex-none items-center gap-[0.6rem] text-ink no-underline" href="/" aria-label="E Informatique, accueil">
        <Image src={logo} alt="" width={28} height={28} densities={[1, 2]} loading="eager" class="size-[28px] rounded-none" />
        <span class="text-[1rem] font-bold tracking-[-0.03em]">E&nbsp;Informatique</span>
      </a>

      <nav class="ml-auto hidden lg:block" aria-label="Navigation principale">
        <ul class="m-0 flex list-none items-center gap-0.5 p-0 xl:gap-1">
        {links.map((l) => (
          <li><a
            href={l.href}
            class:list={[
              'flex min-h-[44px] items-center whitespace-nowrap rounded-full px-[0.6rem] text-[0.85rem] no-underline xl:px-[0.85rem] xl:text-[0.875rem] transition-[color,background-color] duration-150 ease-out-soft hover:bg-accent-wash hover:text-ink',
              isOn(l.href)
                ? 'bg-accent-wash font-semibold text-ink'
                : 'font-medium text-ink-soft',
            ]}
            aria-current={isOn(l.href) ? 'page' : undefined}
          >{l.label}</a></li>
        ))}
        </ul>
      </nav>

      <a class="btn btn--cta hidden flex-none px-[1.1rem] py-[0.6rem] text-[0.875rem] lg:inline-flex" href="/contact/">Me contacter</a>

      <button
        class="btn-icon ml-auto lg:ml-0"
        type="button"
        data-theme-toggle
        aria-label="Thème sombre"
        aria-pressed="false"
      >
        <Sun class="col-start-1 row-start-1 theme-dark:hidden" size={16} stroke-width={1.8} aria-hidden="true" />
        <Moon class="col-start-1 row-start-1 hidden theme-dark:block" size={16} stroke-width={1.8} aria-hidden="true" />
      </button>

      <button
        class="btn-icon group lg:hidden"
        type="button"
        aria-expanded="false"
        aria-controls="mmenu"
        aria-label="Menu"
        data-burger
      >
        <Menu class="col-start-1 row-start-1 transition-[opacity,transform] duration-200 ease-out-soft group-aria-expanded:scale-75 group-aria-expanded:opacity-0" size={20} aria-hidden="true" />
        <X class="col-start-1 row-start-1 scale-75 opacity-0 transition-[opacity,transform] duration-200 ease-out-soft group-aria-expanded:scale-100 group-aria-expanded:opacity-100" size={20} aria-hidden="true" />
      </button>
    </div>

    <div class="mmenu absolute inset-x-[var(--spacing-padx)] top-full mt-2 max-h-[calc(100dvh-6rem)] overflow-y-auto rounded-[var(--radius-xl)] border border-rule bg-paper shadow-[var(--shadow-raise-hi)]" id="mmenu" hidden>
      <div class="flex flex-col px-5 pt-2 pb-6">
        <nav aria-label="Menu">
          <ul class="m-0 list-none p-0">
            {links.map((l) => (
              <li class="border-b border-rule">
                <a
                  href={l.href}
                  class:list={[
                    'flex min-h-[52px] items-center text-[1.3rem] font-semibold tracking-[-0.025em] no-underline',
                    isOn(l.href) ? 'text-accent' : 'text-ink',
                  ]}
                  aria-current={isOn(l.href) ? 'page' : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <a class="btn btn--cta mt-6 justify-center" href="/contact/">Me contacter</a>
        <p class="mt-4 text-center text-[0.8rem] text-ink-faint">Rivesaltes, Perpignan et alentours · à distance partout en France</p>
      </div>
    </div>
  </div>
</header>

<style>
  /* Le menu mobile s'ouvre depuis la barre, pas depuis le centre. */
  .mmenu:not([hidden]) {
    transform-origin: top center;
    animation: mmenu-in .22s cubic-bezier(0.23, 1, 0.32, 1);
  }
  @keyframes mmenu-in {
    from { opacity: 0; transform: translateY(-6px) scale(0.98); }
  }
</style>

<script>
  // ── Bascule de thème ────────────────────────────────────────
  const root = document.documentElement;
  const toggle = document.querySelector('[data-theme-toggle]') as HTMLButtonElement | null;
  const meta = document.querySelector('meta[name="theme-color"]');

  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    // Bouton bascule : le nom reste fixe, seul l'état « enfoncé » change.
    // Changer les deux à la fois fait annoncer l'inverse de la réalité.
    toggle?.setAttribute('aria-pressed', String(dark));
    meta?.setAttribute('content', dark ? '#1b2226' : '#f7f8f8');
  };

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    delete root.dataset.themeSource;
    try { localStorage.setItem('theme', next); } catch {}
    sync();
  });

  document.addEventListener('themechange', sync);
  sync();

  // ── Menu mobile ─────────────────────────────────────────────
  // Ouvrir un menu au clavier ne suffit pas : il faut pouvoir en sortir sans
  // souris. Échap ferme et rend le focus au bouton, et un focus qui s'échappe
  // du panneau le referme — sinon on tabule dans une page qu'on ne voit plus.
  const burger = document.querySelector('[data-burger]') as HTMLButtonElement | null;
  const menu = document.getElementById('mmenu');

  const setMenu = (open: boolean, refocus = false) => {
    if (!burger || !menu) return;
    burger.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    if (refocus) burger.focus();
  };

  burger?.addEventListener('click', () => {
    setMenu(burger.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (burger?.getAttribute('aria-expanded') === 'true') setMenu(false, true);
  });

  document.addEventListener('focusin', (e) => {
    if (burger?.getAttribute('aria-expanded') !== 'true') return;
    const t = e.target as Node;
    if (!menu?.contains(t) && t !== burger) setMenu(false);
  });

  // Un passage en disposition large laisse le panneau ouvert derrière la
  // navigation en ligne : on le referme avec la bascule.
  const wide = window.matchMedia('(width >= 62rem)');
  wide.addEventListener('change', (e) => { if (e.matches) setMenu(false); });
</script>
