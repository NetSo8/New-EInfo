---
const nodes = [
  { t: 'Poste', s: 'Dépannage, virus, sauvegardes' },
  { t: 'Usage', s: "Formation à l'IA, grand public" },
  { t: 'Site', s: 'Création, hébergement, maintenance' },
  { t: 'Code', s: 'Relecture du code généré par IA' },
];
---
<figure class="m-0">
  {/* Les filets se chevauchent d'un pixel : une seule ligne entre deux cases. */}
  <ol class="m-0 grid list-none grid-cols-2 p-0 [@media(width>46rem)]:grid-cols-4">
    {nodes.map((n, i) => (
      <li class="-mr-px -mb-px flex flex-col gap-[0.15rem] border border-rule bg-paper-warm px-[0.9rem] py-[1.15rem]">
        <span class="font-mono text-[0.68rem] font-semibold text-accent">{String(i + 1).padStart(2, '0')}</span>
        <span class="text-[1.05rem] font-bold tracking-[-0.02em]">{n.t}</span>
        <span class="text-[0.76rem]/[1.4] text-ink-soft">{n.s}</span>
      </li>
    ))}
  </ol>

  {/* Accolade : les quatre étages tenus par une seule personne. */}
  <div class="relative mt-[0.6rem] text-center">
    <span class="block h-[10px] border border-t-0 border-accent" aria-hidden="true"></span>
    <span class="mt-[0.55rem] inline-block font-mono text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-accent">
      Un seul interlocuteur
    </span>
  </div>

  <figcaption class="mt-[1.1rem] max-w-[54ch] text-base text-ink-soft">
    Quatre chantiers, une seule personne qui les traverse. La cause se trouve, au
    lieu d'être renvoyée à quelqu'un d'autre.
  </figcaption>
</figure>
