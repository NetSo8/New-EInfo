---
/* `n` et `kicker` restent acceptés pour ne pas casser les pages existantes,
   mais ne sont plus affichés : un titre clair suffit à situer une section,
   et l'étiquette répétée au-dessus de chaque bloc faisait gabarit. */
interface Props { n?: string; kicker?: string; title: string; lede?: string; center?: boolean }
const { title, lede, center = false } = Astro.props;
---
<div class:list={['flex max-w-[46rem] flex-col gap-4', center && 'mx-auto items-center text-center']}>
  <h2 class="text-[clamp(1.9rem,1.1rem+2.8vw,3.25rem)]/[1.04] tracking-[-0.035em]">{title}</h2>
  {lede && <p class="max-w-[54ch] text-lede/[1.5] text-ink-soft">{lede}</p>}
  <slot />
</div>
