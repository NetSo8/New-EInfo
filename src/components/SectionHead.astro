---
interface Props { n: string; kicker: string; title: string; lede?: string; tone?: 'paper' | 'nuit' }
const { n, kicker, title, lede, tone = 'paper' } = Astro.props;
const nuit = tone === 'nuit';
---
<div class="grid grid-cols-1 items-start gap-[0.9rem] mid:grid-cols-[10rem_1fr] mid:gap-gut">
  <div class="flex items-baseline gap-[0.8rem] mid:flex-col mid:items-stretch mid:gap-[0.3rem] mid:pt-[0.55rem]">
    <span
      class:list={[
        'font-mono text-[0.72rem] font-semibold tracking-[0.04em]',
        nuit ? 'text-accent-nuit' : 'text-accent',
      ]}
    >§&nbsp;{n}</span>
    <span class:list={['label leading-[1.5]', nuit && 'text-nuit-faint']}>{kicker}</span>
  </div>
  <div class="flex max-w-[58ch] flex-col gap-[1.1rem]">
    <h2>{title}</h2>
    {lede && (
      <p class:list={['max-w-[46ch] text-lede/[1.5]', nuit ? 'text-nuit-soft' : 'text-ink-soft']}>{lede}</p>
    )}
    <slot />
  </div>
</div>
