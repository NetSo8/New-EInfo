---
interface Item { q: string; a: string }
interface Props { items: Item[] }
const { items } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---
<div class="faq">
  {items.map((i) => (
    <details class="fq">
      <summary>
        <span>{i.q}</span>
        <span class="pm" aria-hidden="true"></span>
      </summary>
      <div class="fa"><p>{i.a}</p></div>
    </details>
  ))}
</div>
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

<style>
  .faq { border-top: 1px solid var(--rule); }
  .fq { border-bottom: 1px solid var(--rule); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    padding: 1.1rem 0; cursor: pointer; list-style: none;
    font-weight: 600; font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem); letter-spacing: -0.02em;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--grenat); }
  .pm { position: relative; width: 13px; height: 13px; flex: none; }
  .pm::before, .pm::after {
    content: ''; position: absolute; inset: 50% 0 auto 0; height: 1.5px; background: var(--grenat);
  }
  .pm::after { transform: rotate(90deg); transition: transform .2s var(--ease); }
  .fq[open] .pm::after { transform: rotate(0deg); }
  .fa { padding-bottom: 1.25rem; color: var(--ink-soft); max-width: 66ch; }
</style>
