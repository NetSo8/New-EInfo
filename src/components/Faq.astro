---
interface Item { q: string; a: string }
interface Props { items: Item[] }
const { items } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---
<div class="border-t border-rule">
  {items.map((i) => (
    <details class="group border-b border-rule">
      <summary
        class="flex cursor-pointer list-none items-center justify-between gap-8 py-[1.1rem] text-[clamp(1rem,0.95rem+0.3vw,1.15rem)] font-semibold tracking-[-0.02em] hover:text-accent [&::-webkit-details-marker]:hidden"
      >
        <span>{i.q}</span>
        {/* Le trait vertical pivote pour former un « − » à l'ouverture. */}
        <span class="relative size-[13px] flex-none" aria-hidden="true">
          <span class="absolute inset-x-0 top-1/2 h-[1.5px] bg-accent"></span>
          <span class="absolute inset-x-0 top-1/2 h-[1.5px] rotate-90 bg-accent transition-transform duration-200 ease-out-soft group-open:rotate-0"></span>
        </span>
      </summary>
      <div class="max-w-[66ch] pb-5 text-ink-soft"><p>{i.a}</p></div>
    </details>
  ))}
</div>
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
