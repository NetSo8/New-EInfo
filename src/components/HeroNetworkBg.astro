---
import { mulberry32 } from '../lib/random';

interface Props { class?: string }
const { class: klass = '' } = Astro.props;

/* Fond de hero : maillage réseau plein cadre, très diffus, avec quelques
   liaisons qui transportent un flux en continu. Généré à partir d'une grille
   légèrement irrégulière (bruit déterministe) pour rester reproductible d'un
   build à l'autre, plutôt que codé nœud par nœud. Décoratif, pas une vraie
   topologie. */
const W = 1440;
const H = 640;

const rand = mulberry32(0xe1f0);

const cols = 7;
const rows = 4;
type Node = { x: number; y: number; r: number; hub: boolean };
const nodes: Node[] = [];
for (let row = 0; row < rows; row++) {
  for (let col = 0; col < cols; col++) {
    const jx = (rand() - 0.5) * 0.62;
    const jy = (rand() - 0.5) * 0.62;
    nodes.push({
      x: ((col + 0.5 + jx) / cols) * W,
      y: ((row + 0.5 + jy) / rows) * H,
      r: 1.8 + rand() * 1.4,
      hub: false,
    });
  }
}

/* Trois nœuds « hubs » : les plus proches de points cibles bien répartis. */
const hubTargets: [number, number][] = [[0.14, 0.32], [0.52, 0.7], [0.86, 0.28]];
for (const [tx, ty] of hubTargets) {
  let best = 0;
  let bestD = Infinity;
  nodes.forEach((n, i) => {
    const d = (n.x / W - tx) ** 2 + (n.y / H - ty) ** 2;
    if (d < bestD) { bestD = d; best = i; }
  });
  nodes[best].hub = true;
  nodes[best].r = 4.4;
}

/* Chaque nœud se relie à ses 2-3 plus proches voisins : mesh irrégulier,
   sans croisements excessifs, sans doublon. */
type Edge = { a: number; b: number };
const edges: Edge[] = [];
const seen = new Set<string>();
nodes.forEach((n, i) => {
  const dists = nodes
    .map((o, j) => ({ j, d: (o.x - n.x) ** 2 + (o.y - n.y) ** 2 }))
    .filter((d) => d.j !== i)
    .sort((a, b) => a.d - b.d);
  const link = n.hub ? 4 : 2 + Math.floor(rand() * 2);
  for (let k = 0; k < link && k < dists.length; k++) {
    const j = dists[k].j;
    const key = i < j ? `${i}-${j}` : `${j}-${i}`;
    if (!seen.has(key)) { seen.add(key); edges.push({ a: i, b: j }); }
  }
});

/* Un tiers des liaisons touchant un hub transporte un flux animé en boucle. */
const flowingSet = new Set(
  edges.filter((e) => (nodes[e.a].hub || nodes[e.b].hub) && rand() > 0.35)
);
---
<svg
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  class:list={['hero-mesh absolute inset-0 size-full', klass]}
  role="presentation"
  aria-hidden="true"
>
  <g fill="none" class="hero-mesh__edges">
    {edges.map((e, i) => {
      const n1 = nodes[e.a];
      const n2 = nodes[e.b];
      const flow = flowingSet.has(e);
      return (
        <line
          x1={n1.x.toFixed(1)} y1={n1.y.toFixed(1)}
          x2={n2.x.toFixed(1)} y2={n2.y.toFixed(1)}
          class={flow ? 'hm-edge hm-edge--flow' : 'hm-edge'}
          style={`--i:${i}; --dur:${(2.6 + rand() * 2.2).toFixed(2)}s; --delay:${(rand() * 3).toFixed(2)}s`}
        />
      );
    })}
  </g>

  <g class="hero-mesh__nodes">
    {nodes.map((n, i) => (
      <circle
        cx={n.x.toFixed(1)} cy={n.y.toFixed(1)} r={n.r.toFixed(1)}
        class={n.hub ? 'hm-node hm-node--hub' : 'hm-node'}
        style={`--i:${i}`}
      />
    ))}
  </g>

  <g class="hero-mesh__pulses" fill="none">
    {nodes.filter((n) => n.hub).map((n, i) => (
      <circle cx={n.x.toFixed(1)} cy={n.y.toFixed(1)} r="8" class="hm-pulse" style={`--delay:${(i * 1.3).toFixed(2)}s`} />
    ))}
  </g>
</svg>

<style>
  .hero-mesh {
    filter: blur(0.6px);
    mask-image: radial-gradient(ellipse 78% 72% at 50% 38%, black 40%, transparent 88%);
  }

  .hm-edge {
    stroke: var(--color-rule-strong);
    stroke-width: 1;
    opacity: 0;
    stroke-dasharray: 620;
    stroke-dashoffset: 620;
    animation: hm-draw 1.6s calc(var(--i, 0) * 0.045s) cubic-bezier(0.19, 1, 0.22, 1) forwards;
  }
  /* Une fois tracée, la liaison active bascule sur un tireté qui défile en boucle. */
  .hm-edge--flow {
    stroke: var(--color-accent);
    stroke-width: 1.1;
    animation:
      hm-draw 1.6s calc(var(--i, 0) * 0.045s) cubic-bezier(0.19, 1, 0.22, 1) forwards,
      hm-flow var(--dur, 3s) linear var(--delay, 0s) infinite;
  }

  .hm-node {
    fill: var(--color-ink-faint);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: hm-pop 0.6s calc(0.5s + var(--i, 0) * 0.03s) cubic-bezier(0.19, 1, 0.22, 1) forwards;
  }
  .hm-node--hub {
    fill: var(--color-accent);
  }

  .hm-pulse {
    stroke: var(--color-accent);
    stroke-width: 1;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: hm-ring 4.8s var(--delay, 0s) cubic-bezier(0.19, 1, 0.22, 1) infinite;
  }

  @keyframes hm-draw {
    0% { opacity: 0; stroke-dashoffset: 620; }
    35% { opacity: 0.55; }
    100% { opacity: 0.55; stroke-dashoffset: 0; }
  }
  @keyframes hm-flow {
    0% { stroke-dasharray: 3 9; stroke-dashoffset: 0; opacity: 0.7; }
    100% { stroke-dasharray: 3 9; stroke-dashoffset: -240; opacity: 0.7; }
  }
  @keyframes hm-pop {
    from { opacity: 0; transform: scale(0.3); }
    to { opacity: 0.7; transform: scale(1); }
  }
  @keyframes hm-ring {
    0% { transform: scale(1); opacity: 0.55; }
    75% { transform: scale(3.4); opacity: 0; }
    100% { transform: scale(3.4); opacity: 0; }
  }
</style>
