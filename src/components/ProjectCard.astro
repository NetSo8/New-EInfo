---
import type { Projet } from '../data/portfolio';
import ChevronRight from '@lucide/astro/icons/chevron-right';

interface Props { projet: Projet; n: number }
const { projet: p, n } = Astro.props;

const etiq = { 'livré': 'Livré', 'maintenance': 'En maintenance', 'recherche': 'Recherche en cours' } as const;
const badgeTone = { 'livré': 'badge--accent', maintenance: '', 'recherche': 'badge--warn' } as const;
---
<li class="border-b border-rule py-9" data-reveal>
  <div class="grid grid-cols-[2.5rem_1fr] items-start gap-4 mid:grid-cols-[3rem_minmax(0,1fr)_auto]">
    <span class="pt-[0.4rem] font-mono text-[0.75rem] font-semibold text-accent">
      {String(n).padStart(2, '0')}
    </span>

    <div>
      <h2 class="max-w-[30ch] text-[clamp(1.25rem,1.05rem+1vw,1.85rem)] tracking-[-0.032em]">{p.titre}</h2>
      <p class="mt-[0.4rem] font-mono text-[0.72rem] tracking-[0.05em] text-ink-faint">{p.client} · {p.annee}</p>
    </div>

    <span class:list={['badge col-start-2 justify-self-start whitespace-nowrap mid:col-start-3', badgeTone[p.type]]}>
      {etiq[p.type]}
    </span>
  </div>

  <div class="mt-5 grid grid-cols-1 items-start gap-y-6 mid:ml-16 mid:grid-cols-2 mid:gap-x-12">
    <p class="max-w-[50ch] text-base text-ink-soft">{p.resume}</p>
    <ul class="m-0 list-none border-t border-rule p-0">
      {p.faits.map((f) => (
        <li class="relative border-b border-rule py-[0.6rem] pl-[1.2rem] text-base">
          <ChevronRight class="absolute top-[0.85rem] left-0 text-accent" size="0.9em" aria-hidden="true" />
          {f}
        </li>
      ))}
    </ul>
  </div>

  <p class="mt-5 flex flex-wrap items-center gap-[0.4rem] mid:ml-16">
    {p.stack.map((s) => <span class="tag">{s}</span>)}
  </p>
</li>
