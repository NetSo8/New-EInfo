---
import { getCollection } from 'astro:content';

const all = (await getCollection('labo')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const items = all.slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' });
---
{items.length > 0 ? (
  <ol class="proof">
    {items.map((p, i) => (
      <li class="pr-i">
        <a href={`/labo/${p.id}/`}>
          <span class="pr-n mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="pr-body">
            <span class="pr-meta">
              <span class="mono pr-date">{fmt(p.data.date)}</span>
              {p.data.status !== 'publié' && <span class="pr-st">{p.data.status}</span>}
              {p.data.tags.slice(0, 2).map((t) => <span class="pr-tag mono">{t}</span>)}
            </span>
            <span class="pr-t">{p.data.title}</span>
            <span class="pr-s">{p.data.summary}</span>
          </span>
          <span class="pr-go" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>
) : (
  <p class="empty">
    Le labo est encore vide. Les writeups arrivent au rythme des travaux terminés,
    pas au rythme du calendrier éditorial.
  </p>
)}

<style>
  .proof { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .pr-i { border-bottom: 1px solid var(--rule); }
  .pr-i a {
    display: grid; grid-template-columns: 2.75rem 1fr 1.5rem; gap: 1rem; align-items: start;
    padding: 1.5rem 0; text-decoration: none; color: inherit;
    transition: background .18s var(--ease), padding-inline .18s var(--ease);
  }
  .pr-i a:hover { background: var(--grenat-wash); padding-inline: 0.9rem; }
  .pr-n { color: var(--grenat); font-weight: 600; font-size: 0.72rem; padding-top: 0.35rem; }
  .pr-body { display: flex; flex-direction: column; gap: 0.4rem; }
  .pr-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .pr-date { font-size: 0.68rem; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.08em; }
  .pr-tag { font-size: 0.66rem; color: var(--ink-faint); border: 1px solid var(--rule); padding: 0.05rem 0.4rem; }
  .pr-st {
    font-family: var(--mono); font-size: 0.67rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--nuit); background: var(--or); padding: 0.1rem 0.4rem; font-weight: 600;
  }
  .pr-t { font-weight: 700; font-size: clamp(1.05rem, 1rem + 0.45vw, 1.35rem); letter-spacing: -0.025em; line-height: 1.2; }
  .pr-s { color: var(--ink-soft); font-size: 0.925rem; max-width: 68ch; }
  .pr-go { color: var(--grenat); padding-top: 0.3rem; transition: transform .18s var(--ease); }
  .pr-i a:hover .pr-go { transform: translateX(4px); }
  .empty { color: var(--ink-soft); border-block: 1px solid var(--rule); padding: 2rem 0; max-width: 58ch; }
</style>
