---
import { getCollection } from 'astro:content';

const all = (await getCollection('labo')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const items = all.slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' });
---
{items.length > 0 ? (
  <ol class="m-0 list-none border-t border-rule p-0">
    {items.map((p, i) => (
      <li class="border-b border-rule">
        <a
          href={`/labo/${p.id}/`}
          class="group grid grid-cols-[2.75rem_1fr_1.5rem] items-start gap-4 py-6 text-inherit no-underline transition-[background-color,padding-inline] duration-200 ease-out-soft hover:bg-accent-wash hover:px-[0.9rem]"
        >
          <span class="pt-[0.35rem] font-mono text-[0.72rem] font-semibold text-accent">
            {String(i + 1).padStart(2, '0')}
          </span>

          <span class="flex flex-col gap-[0.4rem]">
            <span class="flex flex-wrap items-center gap-2">
              <span class="font-mono text-[0.68rem] uppercase tracking-[0.08em] text-ink-faint">
                {fmt(p.data.date)}
              </span>
              {p.data.status !== 'publié' && (
                <span class="rounded-md bg-state-warn px-[0.4rem] py-[0.1rem] font-mono text-[0.67rem] font-semibold uppercase tracking-[0.1em] text-fixed-nuit">
                  {p.data.status}
                </span>
              )}
              {p.data.tags.slice(0, 2).map((t) => (
                <span class="rounded-md border border-rule px-[0.4rem] py-[0.05rem] font-mono text-[0.66rem] text-ink-faint">{t}</span>
              ))}
            </span>
            <span class="text-[clamp(1.05rem,1rem+0.45vw,1.35rem)]/[1.2] font-bold tracking-[-0.025em]">{p.data.title}</span>
            <span class="max-w-[68ch] text-[0.925rem] text-ink-soft">{p.data.summary}</span>
          </span>

          <span
            class="pt-[0.3rem] text-accent transition-transform duration-200 ease-out-soft group-hover:translate-x-1"
            aria-hidden="true"
          >→</span>
        </a>
      </li>
    ))}
  </ol>
) : (
  <p class="max-w-[58ch] border-y border-rule py-8 text-ink-soft">
    Le labo est encore vide. Les writeups arrivent au rythme des travaux terminés,
    pas au rythme du calendrier éditorial.
  </p>
)}
