---
const year = new Date().getFullYear();
const communes = ['Rivesaltes', 'Perpignan', 'Canet-en-Roussillon', 'Saint-Cyprien', 'Cabestany', 'Le Barcarès', 'Saint-Estève', 'Baixas', 'Espira-de-l\'Agly', 'Salses-le-Château'];

const prestations = [
  { href: '/particuliers/', label: 'Dépannage particuliers' },
  { href: '/professionnels/', label: 'Infogérance TPE / PME' },
  { href: '/services/#infra', label: 'Infrastructure VPS' },
  { href: '/services/#securite', label: 'Sécurité et sauvegardes' },
  { href: '/services/#web', label: 'Création de site web' },
  { href: '/services/#automatisation', label: 'Automatisation' },
];

const link = 'w-fit text-[0.9rem] text-nuit-soft no-underline hover:text-paper';
const colonne = 'col-span-1 xs:col-span-2 flex flex-col gap-[0.55rem]';
const titre = 'label mb-[0.35rem] text-nuit-faint';
---
<footer class="border-t border-rule-nuit bg-nuit pt-[clamp(3rem,6vw,5rem)] pb-8 text-nuit-text">
  <div class="shell">
    <div class="grid12 items-start gap-y-11">
      <div class="col-span-full mid:col-span-4">
        <p class="text-2xl font-extrabold tracking-[-0.035em]">E&nbsp;Informatique</p>
        <p class="mt-[0.6rem] mb-6 max-w-[34ch] text-[0.95rem]/[1.65] text-nuit-soft">
          Un seul interlocuteur pour le poste, le serveur, le réseau et le site.
          Basé à Rivesaltes, dans les Pyrénées-Orientales.
        </p>
        <a class="btn btn--cta" href="/contact/">
          Décrire mon besoin <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <nav class={colonne} aria-label="Prestations">
        <p class={titre}>Prestations</p>
        {prestations.map((l) => <a class={link} href={l.href}>{l.label}</a>)}
      </nav>

      <nav class={colonne} aria-label="Le site">
        <p class={titre}>Le site</p>
        <a class={link} href="/portfolio/">Réalisations</a>
        <a class={link} href="/labo/">Labo technique</a>
        <a class={link} href="/blog/">Blog</a>
        <a class={link} href="/a-propos/">À propos</a>
        <a class={link} href="/contact/">Contact</a>
        <a class={link} href="https://github.com/NetSo8" rel="me noopener" target="_blank">GitHub · NetSo8 ↗</a>
      </nav>

      <div class={colonne}>
        <p class={titre}>Joindre</p>
        <p class="text-[0.9rem]/[1.55] text-nuit-soft">Rivesaltes 66600<br />Pyrénées-Orientales</p>
        <p class="text-[0.9rem]/[1.55] text-nuit-faint">Sur place : Rivesaltes, Perpignan, littoral.<br />À distance : France entière.</p>
        <p class="text-[0.9rem]/[1.55] text-nuit-faint">Réponse sous 24 h ouvrées.<br />Intervention sous 48 h.</p>
      </div>
    </div>

    <div class="mt-14 border-t border-rule-nuit pt-6">
      <p class="label text-nuit-faint">Zone d'intervention en présentiel</p>
      <p class="mt-2 text-[0.86rem]/[1.9] text-nuit-soft">{communes.join(' · ')}</p>
    </div>

    <div class="mt-8 flex flex-wrap justify-between gap-x-6 gap-y-3 border-t border-rule-nuit pt-5 font-mono text-[0.72rem] text-nuit-faint">
      <p>© {year} E Informatique · Elian · SIRET sur demande</p>
      <p class="flex gap-[0.6rem]">
        <a class="text-nuit-soft no-underline hover:text-paper" href="/mentions-legales/">Mentions légales</a>
        <span aria-hidden="true">·</span>
        <a class="text-nuit-soft no-underline hover:text-paper" href="/sitemap-index.xml">Plan du site</a>
      </p>
    </div>
  </div>
</footer>
