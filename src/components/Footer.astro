---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Sparkles from '@lucide/astro/icons/sparkles';
import Pause from '@lucide/astro/icons/pause';

const year = new Date().getFullYear();
const communes = ['Rivesaltes', 'Perpignan', 'Cabestany', 'Le Barcarès', 'Baixas', 'Salses-le-Château'];

const prestations = [
  { href: '/particuliers/', label: 'Dépannage particuliers' },
  { href: '/professionnels/', label: 'Infogérance TPE / PME' },
  { href: '/services/#reseau', label: 'Réseau et sécurité' },
  { href: '/services/#depannage', label: 'Dépannage et assistance' },
  { href: '/services/#web', label: 'Site web et maintenance' },
];

const link = 'flex min-h-[24px] w-fit items-center py-[0.15rem] text-[0.9rem] text-nuit-soft no-underline hover:text-paper';
const colonne = 'col-span-1 xs:col-span-2 flex flex-col gap-[0.55rem]';
const titre = 'label mb-[0.35rem] text-nuit-faint';
---
<footer class="border-t border-rule-nuit bg-nuit pt-[clamp(3rem,6vw,5rem)] pb-8 text-nuit-text">
  <div class="shell">
    <div class="grid12 items-start gap-y-11">
      <div class="col-span-full mid:col-span-4">
        <p class="text-2xl font-extrabold tracking-[-0.035em]">E&nbsp;Informatique</p>
        <p class="mt-[0.6rem] mb-6 max-w-[34ch] text-base/[1.65] text-nuit-soft">
          Un seul interlocuteur pour le poste, le serveur, le réseau et le site.
          Basé à Rivesaltes, dans les Pyrénées-Orientales.
        </p>
        <a class="btn btn--cta" href="/contact/">
          Décrire mon besoin <ArrowRight class="arrow" size="1.05em" aria-hidden="true" />
        </a>
      </div>

      <nav class={colonne} aria-label="Prestations">
        <p class={titre}>Prestations</p>
        {prestations.map((l) => <a class={link} href={l.href}>{l.label}</a>)}
      </nav>

      <nav class={colonne} aria-label="Le site">
        <p class={titre}>Le site</p>
        <a class={link} href="/portfolio/">Réalisations</a>
        <a class={link} href="/blog/">Blog</a>
        <a class={link} href="/a-propos/">À propos</a>
        <a class={link} href="/contact/">Contact</a>
        <a class={link + ' inline-flex items-center gap-[0.3rem]'} href="https://github.com/NetSo8" rel="me noopener noreferrer" target="_blank">
          GitHub · NetSo8 <ArrowUpRight size="0.95em" aria-hidden="true" />
        </a>
      </nav>

      <div class={colonne}>
        <p class={titre}>Joindre</p>
        <p class="text-[0.9rem]/[1.55] text-nuit-soft">Rivesaltes 66600<br />Pyrénées-Orientales</p>
        <p class="text-[0.9rem]/[1.55] text-nuit-faint">Sur place : Rivesaltes, Perpignan, alentours.<br />À distance : France entière.</p>
      </div>
    </div>

    <div class="mt-14 border-t border-rule-nuit pt-6">
      <p class="label text-nuit-faint">Zone d'intervention en présentiel</p>
      <p class="mt-2 text-[0.86rem]/[1.9] text-nuit-soft">{communes.join(' · ')}</p>
    </div>

    {/* Les fonds décoratifs bouclent sans fin. WCAG 2.2.2 demande qu'on puisse
        les arrêter : le réglage du système est respecté, et cet interrupteur
        sert à qui ne l'a pas activé ou ne veut couper que sur ce site. */}
    <div class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-rule-nuit pt-5 font-mono text-[0.72rem] text-nuit-faint">
      <p>© {year} E Informatique · Elian · SIRET sur demande</p>
      <button
        class="inline-flex min-h-[28px] cursor-pointer items-center gap-[0.45rem] rounded-md border border-rule-nuit bg-transparent px-[0.6rem] py-[0.35rem] font-mono text-[0.72rem] text-nuit-soft transition-[color,border-color] duration-150 ease-out-soft hover:border-nuit-text hover:text-paper"
        type="button"
        data-motion-toggle
        aria-pressed="false"
      >
        <Sparkles class="motion-on" size="0.95em" aria-hidden="true" />
        <Pause class="motion-off hidden" size="0.95em" aria-hidden="true" />
        <span data-motion-label>Réduire les animations</span>
      </button>
      <p class="flex gap-[0.6rem]">
        <a class="inline-flex min-h-[24px] items-center text-nuit-soft no-underline hover:text-paper" href="/mentions-legales/">Mentions légales</a>
        <span aria-hidden="true">·</span>
        <a class="inline-flex min-h-[24px] items-center text-nuit-soft no-underline hover:text-paper" href="/sitemap-index.xml">Plan du site</a>
      </p>
    </div>
  </div>
</footer>

<script>
  // Trois états possibles : 'full' (forcé animé), 'reduced' (forcé calme),
  // ou aucun attribut — on suit alors le réglage du système.
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  const label = btn?.querySelector<HTMLElement>('[data-motion-label]');
  const systemCalm = window.matchMedia('(prefers-reduced-motion: reduce)');

  const isCalm = () =>
    root.dataset.motion === 'reduced' || (root.dataset.motion !== 'full' && systemCalm.matches);

  const sync = () => {
    const calm = isCalm();
    btn?.setAttribute('aria-pressed', String(calm));
    if (label) label.textContent = calm ? 'Rétablir les animations' : 'Réduire les animations';
    btn?.querySelector('.motion-on')?.classList.toggle('hidden', calm);
    btn?.querySelector('.motion-off')?.classList.toggle('hidden', !calm);
  };

  btn?.addEventListener('click', () => {
    const next = isCalm() ? 'full' : 'reduced';
    root.dataset.motion = next;
    try { localStorage.setItem('motion', next); } catch {}
    sync();
  });

  systemCalm.addEventListener('change', sync);
  sync();
</script>
